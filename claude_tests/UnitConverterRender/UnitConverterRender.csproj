<Project Sdk="Microsoft.NET.Sdk">
  <!-- Draws the three tabs of the Unit Converter window (the add-in's
       UnitConverterPanel) to PNGs without ArcGIS Pro, from the BUILT add-in
       DLL, with a temporary file of user units (the real one in the user's
       profile is never written). Build the add-in first (Release), then run
       from the repo root; see the top of Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <RootNamespace>UnitConverterRender</RootNamespace>
  </PropertyGroup>
</Project>
