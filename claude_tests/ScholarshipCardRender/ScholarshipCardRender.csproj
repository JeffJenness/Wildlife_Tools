<Project Sdk="Microsoft.NET.Sdk">
  <!-- Draws the Lois Engelman Memorial Scholarship Fund card to PNG files
       without ArcGIS Pro, from the BUILT add-in DLL, so its layout can be
       looked at after a change. Build the add-in first (Release), then run
       this project from the repo root; see the top of Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <RootNamespace>ScholarshipCardRender</RootNamespace>
  </PropertyGroup>
</Project>
