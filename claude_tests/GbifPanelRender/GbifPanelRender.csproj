<Project Sdk="Microsoft.NET.Sdk">
  <!-- Draws the four tabs of the GBIF Species Occurrences window (the add-in's
       GbifPanel) to PNGs without ArcGIS Pro, from the BUILT add-in
       DLL, with live requests to GBIF (it needs the internet; the stored GBIF sign-in, if any, is used read-only for tab 4;
       no download is requested). Build the add-in first (Release), then run
       from the repo root; see the top of Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <RootNamespace>GbifPanelRender</RootNamespace>
  </PropertyGroup>
</Project>
