<Project Sdk="Microsoft.NET.Sdk">
  <!-- Draws the content of the Element Color Helper window (the add-in's
       ElementColorHelperPanel) to a PNG without ArcGIS Pro, from the BUILT
       add-in DLL, with a made-up scan in its table. Build the add-in first
       (Release), then run from the repo root; see the top of Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <RootNamespace>ElementColorHelperRender</RootNamespace>
  </PropertyGroup>
</Project>
