<Project Sdk="Microsoft.NET.Sdk">
  <!-- Draws the four tabs of the iNaturalist Observations window (the add-in's
       INatPanel) to PNGs without ArcGIS Pro, from the BUILT add-in
       DLL, with live requests to iNaturalist.org (it needs the internet;
       nothing is downloaded). Build the add-in first (Release), then run
       from the repo root; see the top of Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <RootNamespace>INatPanelRender</RootNamespace>
  </PropertyGroup>
</Project>
