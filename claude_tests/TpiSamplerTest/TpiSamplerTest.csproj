<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the TPI Neighborhood Sampler's arithmetic (the add-in's
       WildlifeTools/TpiSampler/TpiSamplerEngine.cs, compiled in as source,
       no ArcGIS) against brute force: the circular focal mean and SD with
       NoData and per-row radii, the kernel rule, the contour, the block
       means, the geographic cell sizes and the captions.
       Run from the repo root with dotnet run and the project option: claude_tests/TpiSamplerTest -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>TpiSamplerTest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\WildlifeTools\TpiSampler\TpiSamplerEngine.cs" />
  </ItemGroup>
</Project>
