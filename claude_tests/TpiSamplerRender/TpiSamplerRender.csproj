<Project Sdk="Microsoft.NET.Sdk">
  <!-- Draws the content of the TPI Neighborhood Sampler window (the add-in's
       TpiSamplerPanel) to a PNG without ArcGIS Pro, from the BUILT add-in
       DLL, with a made-up DEM loaded as its snapshot and a cell pinned.
       Build the add-in first (Release), then run from the repo root with
       dotnet run and the project option; see the top of Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <RootNamespace>TpiSamplerRender</RootNamespace>
  </PropertyGroup>
</Project>
