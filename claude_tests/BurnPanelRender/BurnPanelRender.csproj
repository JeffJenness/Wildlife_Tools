<Project Sdk="Microsoft.NET.Sdk">
  <!-- Draws the two tabs of the Burn Severity windows (the add-in's
       BurnPanel) to PNGs without ArcGIS Pro, from the BUILT add-in
       DLL, with live requests to the Burn Severity Portal's fire catalog (it needs the internet;
       nothing is downloaded). Build the add-in first (Release), then run
       from the repo root; see the top of Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <RootNamespace>BurnPanelRender</RootNamespace>
  </PropertyGroup>
</Project>
