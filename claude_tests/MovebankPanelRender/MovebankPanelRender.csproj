<Project Sdk="Microsoft.NET.Sdk">
  <!-- Draws the two tabs of the Movebank Animal Tracks window (the add-in's
       MovebankPanel) to PNGs without ArcGIS Pro, from the BUILT add-in
       DLL, with live requests to the Movebank Data Repository (it needs the internet;
       nothing is downloaded). Build the add-in first (Release), then run
       from the repo root; see the top of Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <RootNamespace>MovebankPanelRender</RootNamespace>
  </PropertyGroup>
</Project>
