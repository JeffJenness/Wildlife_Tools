<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure-source test of the About card's ArcGIS-free logic (version
       parsing, release comparison, citation, GitHub JSON). Compiles the two
       add-in source files in directly; run it from the repo root with
       dotnet run (the command line is at the top of Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>AboutInfoTest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\WildlifeTools\About\AboutInfo.cs" />
    <Compile Include="..\..\WildlifeTools\About\UpdateCheck.cs" />
  </ItemGroup>
</Project>
