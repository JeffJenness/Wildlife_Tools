<UserControl x:Class="WildlifeTools.TpiSampler.TpiSamplerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The whole content of the TPI Neighborhood Sampler window: plain WPF, so
       it can be drawn and checked outside ArcGIS Pro (claude_tests/
       TpiSamplerRender). Everything that needs Pro (the map's layers, the
       DEM read, the help page) is in TpiSamplerActions, reached from clicks.
       No colors are set on text: the window's light or dark theme applies. -->
  <UserControl.Resources>
    <Style TargetType="ToolTip">
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="400" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SideHeader" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8">
      Try neighborhood sizes and thresholds for the Topographic Position
      Index on a snapshot of the DEM in the current view, before running the
      TPI or classification tools. Zoom the map to a feature you know how you
      want classified, take a snapshot, then slide: the picture shows the TPI
      for the neighborhood on the bottom slider, and the line shows where the
      threshold on the left slider falls. Nothing is added to the map and
      nothing is written to disk.
    </TextBlock>

    <!-- the snapshot row -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="DEM:" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox x:Name="cmbDem" Grid.Column="1" MinWidth="220" VerticalAlignment="Center"
                ToolTip="The elevation raster to sample, from the layers of the active map. The snapshot covers the part of it inside the current view." />
      <Button x:Name="btnLayers" Grid.Column="2" Content="&#x21BB;" Width="26" Margin="4,0,0,0" Click="OnRefreshLayers"
              ToolTip="Read the list of raster layers again, after adding one to the map." />
      <TextBlock Grid.Column="3" Text="Detail:" VerticalAlignment="Center" Margin="14,0,6,0" />
      <ComboBox x:Name="cmbDetail" Grid.Column="4" Width="64" VerticalAlignment="Center" SelectedIndex="1"
                ToolTip="The snapshot's size, in cells along its longer side. More detail shows smaller features and takes a little longer; 400 is a good start. Zooming the map in is the other way to see finer detail.">
        <ComboBoxItem Content="200" />
        <ComboBoxItem Content="400" />
        <ComboBoxItem Content="800" />
      </ComboBox>
      <Button x:Name="btnSnapshot" Grid.Column="5" Content="Take Snapshot" Padding="12,3" Margin="14,0,0,0"
              FontWeight="SemiBold" Click="OnSnapshot"
              ToolTip="Read the DEM inside the current view into a coarse grid and compute the TPI. Pan or zoom the map and click again for a new snapshot." />
      <TextBlock x:Name="txtSnapshot" Grid.Column="6" TextWrapping="Wrap" VerticalAlignment="Center" Margin="14,0,0,0" />
    </Grid>

    <!-- bottom bar -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="Close" Width="84" Click="OnClose" IsCancel="True" />
      <!-- the suite's round blue help button -->
      <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0" Width="20" Height="20"
              Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnHelp"
              ToolTip="Open the online help page for this tool">
        <Grid>
          <Ellipse Width="18" Height="18" Fill="#0079C1" />
          <TextBlock Text="?" Foreground="White" FontWeight="Bold" FontSize="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
        </Grid>
      </Button>
      <Button x:Name="btnCopy" DockPanel.Dock="Right" Content="Copy Settings" Padding="12,3" Margin="0,0,8,0"
              Click="OnCopySettings" IsEnabled="False"
              ToolTip="Put the current neighborhood, TPI scale and threshold on the clipboard as text, with the Python call that computes the same TPI with the Topographic Position Index tool." />
      <TextBlock x:Name="txtStatus" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
    </DockPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- the picture with its two sliders -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- the threshold slider, standing on the left -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
          <TextBlock DockPanel.Dock="Left" x:Name="txtThresholdAxis" Text="Classification threshold"
                     VerticalAlignment="Center" Margin="0,0,6,0">
            <TextBlock.LayoutTransform>
              <RotateTransform Angle="-90" />
            </TextBlock.LayoutTransform>
          </TextBlock>
          <TextBlock DockPanel.Dock="Top" x:Name="txtThresholdTop" Text="+" HorizontalAlignment="Center" />
          <TextBlock DockPanel.Dock="Bottom" x:Name="txtThresholdBottom" Text="&#x2212;" HorizontalAlignment="Center" />
          <Slider x:Name="sldThreshold" Orientation="Vertical" HorizontalAlignment="Center"
                  Minimum="-1" Maximum="1" Value="0" IsEnabled="False"
                  ValueChanged="OnThresholdSlider"
                  ToolTip="The classification threshold. The line in the picture is drawn where the TPI equals it; the tinted cells are the ones on the chosen side of it." />
        </DockPanel>

        <!-- the picture -->
        <Border Grid.Row="0" Grid.Column="1" BorderBrush="#9A9A9A" BorderThickness="1" Background="#F2F2F2"
                MinHeight="240">
          <Grid x:Name="picBox" ClipToBounds="True" Background="Transparent"
                MouseWheel="OnPictureWheel" MouseDown="OnPictureMouseDown"
                MouseMove="OnPictureMouseMove" MouseUp="OnPictureMouseUp">
            <TextBlock x:Name="txtEmpty" TextWrapping="Wrap" TextAlignment="Center" Margin="40"
                       VerticalAlignment="Center" Opacity="0.7"
                       Text="Zoom the map to the terrain you want to test, choose the DEM, and click Take Snapshot." />
            <Viewbox x:Name="viewbox" Stretch="Uniform">
              <Grid x:Name="stage" Width="400" Height="300" Background="Transparent"
                    MouseLeftButtonDown="OnStageClick" Cursor="Cross">
                <Image x:Name="imgTpi" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Canvas x:Name="cvOverlay" IsHitTestVisible="False">
                  <Path x:Name="pathMirror" Stroke="#1F6FD0" StrokeThickness="0.9" StrokeDashArray="3,2" />
                  <Path x:Name="pathContour" Stroke="#111111" StrokeThickness="1.1" />
                  <Path x:Name="pathPin" Stroke="#FFFFFF" StrokeThickness="2.2" />
                  <Path x:Name="pathPinInner" Stroke="#D01F1F" StrokeThickness="1.0" />
                </Canvas>
              </Grid>
            </Viewbox>
          </Grid>
        </Border>

        <!-- the neighborhood slider, lying underneath -->
        <Slider x:Name="sldRadius" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                Minimum="1" Maximum="2" Value="1" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="None" IsEnabled="False"
                ValueChanged="OnRadiusSlider"
                ToolTip="The neighborhood radius. Each step is half a snapshot cell; type an exact value in the Radius box on the right." />
        <TextBlock x:Name="txtRadiusAxis" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" Margin="0,2,0,0"
                   Text="Neighborhood radius" />
      </Grid>

      <!-- the controls -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="14,0,0,0">
        <StackPanel Width="276">
          <TextBlock Style="{StaticResource SideHeader}" Text="Neighborhood" Margin="0,0,0,4" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Radius units:" VerticalAlignment="Center" Margin="0,0,8,4" />
            <ComboBox x:Name="cmbUnits" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" SelectionChanged="OnUnitsChanged"
                      ToolTip="The units of the radius: linear units on the ground, or Cells, meaning the DEM's own cells. The same choice the TPI tools offer." />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Radius:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="txtRadius" Grid.Row="1" Grid.Column="1" KeyDown="OnRadiusKey" LostFocus="OnRadiusTyped"
                     ToolTip="The neighborhood radius in the chosen units. Press Enter to use a typed value; the slider follows." />
          </Grid>
          <TextBlock x:Name="txtRadiusInfo" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.85" />

          <TextBlock Style="{StaticResource SideHeader}" Text="TPI scale" />
          <RadioButton x:Name="rbRaw" GroupName="scale" Content="Raw TPI, in the DEM's elevation units" IsChecked="True" Checked="OnScaleChanged"
                       ToolTip="Elevation minus the mean elevation of the neighborhood. A 100-meter hill reads the same everywhere, so thresholds are absolute: the usual choice for wildlife questions." />
          <RadioButton x:Name="rbDev" GroupName="scale" Content="Neighborhood standard deviations" Margin="0,4,0,0" Checked="OnScaleChanged"
                       ToolTip="The raw TPI divided by the standard deviation of elevation within the same neighborhood (the TPI tools' neighborhood-scale standardization, Weiss's choice). Relative to the local relief, so the same hill scores lower in rougher country." />

          <TextBlock Style="{StaticResource SideHeader}" Text="Threshold" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Value:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="txtThreshold" Grid.Column="1" KeyDown="OnThresholdKey" LostFocus="OnThresholdTyped"
                     ToolTip="The threshold in the chosen scale. Press Enter to use a typed value; the slider follows." />
          </Grid>
          <TextBlock Text="The feature I want is:" Margin="0,8,0,2" />
          <RadioButton x:Name="rbAbove" GroupName="side" Content="At or above the threshold (a hill, a ridge)" IsChecked="True" Checked="OnSideChanged"
                       ToolTip="Tint the cells whose TPI is at or above the threshold." />
          <RadioButton x:Name="rbBelow" GroupName="side" Content="At or below it (a valley, a channel)" Margin="0,4,0,0" Checked="OnSideChanged"
                       ToolTip="Tint the cells whose TPI is at or below the threshold." />
          <RadioButton x:Name="rbNone" GroupName="side" Content="No classification: just show the TPI" Margin="0,4,0,0" Checked="OnSideChanged"
                       ToolTip="Draw no threshold line and no tint, so the picture shows only the TPI colors, blue below the neighborhood mean and red above, as the radius changes." />
          <CheckBox x:Name="chkMirror" Content="Also draw the line at minus the threshold" Margin="0,8,0,0"
                    Checked="OnDisplayChanged" Unchecked="OnDisplayChanged"
                    ToolTip="Draw a second, dashed blue line where the TPI equals the negative of the threshold, since ridge and valley thresholds are usually chosen together (Weiss's classes are symmetric)." />

          <TextBlock Style="{StaticResource SideHeader}" Text="Picture" />
          <CheckBox x:Name="chkHillshade" Content="Light the TPI with a hillshade" IsChecked="True"
                    Checked="OnDisplayChanged" Unchecked="OnDisplayChanged"
                    ToolTip="Shade the colors with a hillshade of the snapshot, for a sense of the terrain under the TPI." />
          <CheckBox x:Name="chkTint" Content="Tint the cells that pass the threshold" IsChecked="True" Margin="0,4,0,0"
                    Checked="OnDisplayChanged" Unchecked="OnDisplayChanged"
                    ToolTip="Give the cells on the chosen side of the threshold a yellow tint; the line alone is drawn when this is off." />
          <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.85"
                     Text="Blue is below the neighborhood mean, red above; the line is the threshold." />
          <DockPanel Margin="0,6,0,0">
            <Button x:Name="btnFullExtent" DockPanel.Dock="Left" Content="Full Extent" Padding="10,2" Click="OnFullExtent" IsEnabled="False"
                    ToolTip="Show the whole snapshot again after zooming in." />
            <TextBlock x:Name="txtZoom" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.85"
                       Text="Wheel zooms the picture; middle or right drag pans." />
          </DockPanel>

          <DockPanel Margin="0,10,0,4">
            <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Text="Pinned feature" />
            <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center">
              <Hyperlink x:Name="lnkPinHelp" Click="OnPinHelp">What is this?</Hyperlink>
            </TextBlock>
            <Popup x:Name="popPinHelp" StaysOpen="False" Placement="Bottom" AllowsTransparency="True"
                   PlacementTarget="{Binding ElementName=lnkPinHelp}">
              <Border Background="#F7F7F7" BorderBrush="#9A9A9A" BorderThickness="1" Padding="12" MaxWidth="340"
                      Margin="0,4,8,8">
                <Border.Effect>
                  <DropShadowEffect Opacity="0.3" BlurRadius="8" ShadowDepth="2" />
                </Border.Effect>
                <StackPanel>
                  <TextBlock TextWrapping="Wrap" Foreground="#202020">
                    Click a cell in the picture to pin it. This panel then shows that
                    cell's TPI at every neighborhood size: the plot is its TPI against
                    the radius, with the threshold as the horizontal line and the current
                    radius as the vertical one, and the shaded span is the radii that
                    classify the cell as the feature you chose. The sentence under the
                    plot says the same in words.
                  </TextBlock>
                  <TextBlock TextWrapping="Wrap" Foreground="#202020" Margin="0,8,0,0">
                    To place the pin exactly, zoom the picture with the mouse wheel and
                    pan by dragging with the middle or the right button; Full Extent
                    brings the whole snapshot back.
                  </TextBlock>
                </StackPanel>
              </Border>
            </Popup>
          </DockPanel>
          <TextBlock x:Name="txtPin" TextWrapping="Wrap" Text="Click a cell in the picture to pin it." />
          <Border x:Name="curveBox" BorderBrush="#9A9A9A" BorderThickness="1" Background="#FAFAFA" Margin="0,6,0,0"
                  Height="130" Visibility="Collapsed">
            <Canvas x:Name="cvCurve" ClipToBounds="True" />
          </Border>
          <TextBlock x:Name="txtPinSpan" TextWrapping="Wrap" Margin="0,4,0,0" />
          <Button x:Name="btnClearPin" Content="Clear Pin" Padding="10,2" Margin="0,6,0,0" HorizontalAlignment="Left"
                  Click="OnClearPin" IsEnabled="False" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
