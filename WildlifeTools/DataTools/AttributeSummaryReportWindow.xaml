<controls:ProWindow x:Class="WildlifeTools.DataTools.AttributeSummaryReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        Title="Attribute Summary Report" WindowStartupLocation="CenterOwner"
        Width="640" Height="640" MinWidth="460" MinHeight="360"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
  <controls:ProWindow.Resources>
    <LinearGradientBrush x:Key="FrameBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#6B4A26" Offset="0" />
      <GradientStop Color="#4E351B" Offset="0.5" />
      <GradientStop Color="#3A2712" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BackdropBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#F8F1DE" Offset="0" />
      <GradientStop Color="#EFE3C4" Offset="0.55" />
      <GradientStop Color="#E7D7B0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonFaceBrush" Color="#5C3F20" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#F5EBD3" />
    <SolidColorBrush x:Key="ButtonEdgeBrush" Color="#2E1F0E" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#7A5730" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#412C14" />
    <FontFamily x:Key="BodyFontFam">/WildlifeTools;component/Fonts/#EB Garamond, Georgia</FontFamily>
    <Style TargetType="ToolTip">
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="400" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ParchButton" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontFamily" Value="{StaticResource BodyFontFam}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource ButtonTextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource ButtonFaceBrush}"
                    BorderBrush="{StaticResource ButtonEdgeBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{StaticResource ButtonHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{StaticResource ButtonPressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:ProWindow.Resources>

  <Border Background="{StaticResource FrameBrush}" Padding="9">
    <Border Background="{StaticResource BackdropBrush}" CornerRadius="8" Padding="9">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,8,0,0">
          <Button Margin="3,0" Click="OnCopyRaw"
                  Style="{StaticResource ParchButton}"
                  ToolTip="Copy the report as plain, unformatted text.">
            <TextBlock TextAlignment="Center"><Run Text="Copy" /><LineBreak /><Run Text="Raw Text" /></TextBlock>
          </Button>
          <Button Margin="3,0" Click="OnCopyRtf"
                  Style="{StaticResource ParchButton}"
                  ToolTip="Copy the report with its formatting (bold headers) as Rich Text -- paste into Word or any RTF-aware editor and it arrives formatted.">
            <TextBlock TextAlignment="Center"><Run Text="Copy" /><LineBreak /><Run Text="Rich Text" /></TextBlock>
          </Button>
          <Button Margin="3,0" Click="OnCopyTsv"
                  Style="{StaticResource ParchButton}"
                  ToolTip="Copy a clean tab-separated table (value columns, Count, Proportion) regardless of the format template -- paste straight into Excel and it lands in columns.">
            <TextBlock TextAlignment="Center"><Run Text="Copy Table" /><LineBreak /><Run Text="(TSV)" /></TextBlock>
          </Button>
          <Button Margin="3,0" Click="OnCopyEsri"
                  Style="{StaticResource ParchButton}"
                  ToolTip="Copy the report as text with ArcGIS text-formatting tags (BOL for the headers). Paste it into a LAYOUT TEXT element's text and ArcGIS renders the formatting.">
            <TextBlock TextAlignment="Center"><Run Text="Copy" /><LineBreak /><Run Text="Esri Text" /></TextBlock>
          </Button>
          <Button Margin="3,0" Click="OnAddToLayout"
                  Style="{StaticResource ParchButton}"
                  ToolTip="One click: place a text element carrying this report (with its formatting) at the center of the active layout. Open a layout view first.">
            <TextBlock TextAlignment="Center"><Run Text="Add to" /><LineBreak /><Run Text="Layout" /></TextBlock>
          </Button>
          <Button Margin="3,0" Click="OnSaveFile"
                  Style="{StaticResource ParchButton}"
                  ToolTip="Save the report to a text (.txt) or rich text (.rtf) file.">
            <TextBlock TextAlignment="Center"><Run Text="Save to" /><LineBreak /><Run Text="File..." /></TextBlock>
          </Button>
          <Button Content="Close" Margin="3,0" Click="OnCloseClick"
                  Style="{StaticResource ParchButton}" />
        </StackPanel>
        <RichTextBox x:Name="rtb" IsReadOnly="True" IsDocumentEnabled="True"
                     VerticalScrollBarVisibility="Auto"
                     Background="#FFFDF6" BorderBrush="#2E1F0E"
                     BorderThickness="1" Padding="10" />
      </DockPanel>
    </Border>
  </Border>
</controls:ProWindow>
