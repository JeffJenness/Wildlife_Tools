<UserControl x:Class="WildlifeTools.OnlineData.BurnSeverity.BurnPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The whole content of the three Burn Severity windows (MTBS, RAVG, BAER):
       plain WPF, so it can be drawn and checked outside ArcGIS Pro. The
       window tells it which program it is for. Everything that needs Pro
       (the map's study areas, which fires touch a polygon, default output
       paths, running the geoprocessing tool, the help page) is in
       BurnActions. No colors are set on text: the window's theme applies. -->
  <UserControl.Resources>
    <Style TargetType="ToolTip">
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="400" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="12">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="Close" Width="84" Click="OnClose" IsCancel="True" />
      <!-- the suite's round blue help button -->
      <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0" Width="20" Height="20"
              Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnHelp"
              ToolTip="Open the online help page for this tool">
        <Grid>
          <Ellipse Width="18" Height="18" Fill="#0079C1" />
          <TextBlock Text="?" Foreground="White" FontWeight="Bold" FontSize="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
        </Grid>
      </Button>
      <TextBlock VerticalAlignment="Center">
        <Run Text="Data from the" />
        <Hyperlink NavigateUri="https://burnseverity.cr.usgs.gov/" RequestNavigate="OnLink"
                   ToolTip="Open the Burn Severity Portal in your web browser.">Burn Severity Portal</Hyperlink>
        <Run Text="of the U.S. Geological Survey and the USDA Forest Service" />
      </TextBlock>
    </DockPanel>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0"
               FontWeight="SemiBold" Visibility="Collapsed" />

    <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged">
      <!-- ============================================================ -->
      <TabItem Header="1. Find the fires">
        <DockPanel Margin="10">
          <TextBlock x:Name="AboutText" DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,0,0,6" />
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"
                     Text="This is a program of the United States Government. It maps fires in the United States and its territories only." />

          <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Style="{StaticResource Head}" Text="Fire name (optional)" />
              <TextBox x:Name="NameBox" Height="26" VerticalContentAlignment="Center" KeyDown="OnSearchKey"
                       ToolTip="All or part of a fire's name: museum finds MUSEUM. Several names can be given, separated by semicolons. Many fires share a name, so give years or a study area as well. Empty for any name." />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Years, from" VerticalAlignment="Center" />
                <TextBox x:Name="YearFromBox" Width="64" Height="24" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         KeyDown="OnSearchKey" ToolTip="The first year of ignition to list, from 1984. Empty for no limit." />
                <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBox x:Name="YearToBox" Width="64" Height="24" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         KeyDown="OnSearchKey" ToolTip="The last year of ignition to list. Empty for no limit. For one year, give the same year in both boxes. A year later than this one is accepted, so 9999 means through the latest fires; the note beside the buttons names the years that were not available." />
                <TextBlock Text="(empty: every year)" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.8" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource Head}" Text="Study area from the map (optional)" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Refresh" Height="26" Padding="10,0" Margin="8,0,0,0"
                        Click="OnRefreshAreas" ToolTip="Read the polygon layers of the active map again." />
                <ComboBox x:Name="AreaBox" Height="26" SelectionChanged="OnAreaChanged"
                          ToolTip="No study area, the area the map shows now, or the polygons of a layer in the map (its selected polygons when there is a selection)." />
              </DockPanel>
              <TextBlock x:Name="AreaNote" Style="{StaticResource Note}" />
              <TextBlock Style="{StaticResource Note}"
                         Text="The study area only selects fires. Every fire whose perimeter touches it is listed, and is later written whole: nothing is clipped." />
            </StackPanel>
          </Grid>

          <DockPanel DockPanel.Dock="Top" Margin="0,10,0,0">
            <Button x:Name="ListButton" DockPanel.Dock="Left" Content="List the fires" Height="28" Padding="14,0"
                    Click="OnList"
                    ToolTip="Ask the fire catalog for the fires that match the name, the years and the study area, and show them below in place of the list that is there. Nothing is fetched." />
            <Button x:Name="AddButton" DockPanel.Dock="Left" Content="Add to the list" Height="28" Padding="14,0" Margin="8,0,0,0"
                    Click="OnAddToList"
                    ToolTip="Ask the fire catalog for the fires that match the name, the years and the study area, and add them to the list that is there. Use it to gather fires from several searches: other names, other years, another study area." />
            <Button DockPanel.Dock="Right" Content="Clear the list" Height="28" Padding="14,0" Click="OnClearList"
                    ToolTip="Empty the list of fires." />
            <TextBlock x:Name="ListNote" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="12,0"
                       Text="Give a fire name, years or a study area, then click List the fires." />
          </DockPanel>

          <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Left" Content="Check all" Height="26" Padding="12,0" Click="OnCheckAll"
                    ToolTip="Check every fire in the list." />
            <Button DockPanel.Dock="Left" Content="Uncheck all" Height="26" Padding="12,0" Margin="8,0,0,0" Click="OnUncheckAll"
                    ToolTip="Uncheck every fire in the list." />
            <Button DockPanel.Dock="Right" Content="Remove the unchecked fires" Height="26" Padding="12,0" Click="OnRemoveUnchecked"
                    ToolTip="Take the fires that are not checked out of the list, leaving the checked ones." />
            <TextBlock x:Name="CheckedNote" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold" />
          </DockPanel>

          <DataGrid x:Name="FireGrid" Margin="0,8,0,0" AutoGenerateColumns="False" CanUserAddRows="False"
                    CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                    GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Get" Width="44">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnFireChecked"
                              ToolTip="Checked: this fire is one of the fires to get on tab 2." />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Fire name" Binding="{Binding Name}" Width="3*" IsReadOnly="True" />
              <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="56" IsReadOnly="True" />
              <DataGridTextColumn Header="Ignition date" Binding="{Binding IgnitionDate}" Width="96" IsReadOnly="True" />
              <DataGridTextColumn Header="Fire type" Binding="{Binding FireType}" Width="110" IsReadOnly="True" />
              <DataGridTextColumn Header="Assessment" Binding="{Binding Assessment}" Width="90" IsReadOnly="True" />
              <DataGridTextColumn Header="Acres" Binding="{Binding AcresText}" Width="80" IsReadOnly="True" />
              <DataGridTextColumn Header="Fire ID" Binding="{Binding Id}" Width="2*" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- ============================================================ -->
      <TabItem Header="2. Get the data">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Margin="10">
            <TextBlock Style="{StaticResource Head}" Text="The fires" />
            <TextBlock x:Name="ChosenText" TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource Head}" Margin="0,14,0,4" Text="Output fire perimeters (in a file geodatabase)" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse..." Width="84" Height="24" Margin="8,0,0,0" Click="OnBrowsePerimeters"
                      ToolTip="Choose the file geodatabase to save the fire perimeters in, and type a name for the new feature class. The path is put in the box, where it can still be edited. Nothing is created until you click Get the data." />
              <TextBox x:Name="PerimetersBox" Height="24" VerticalContentAlignment="Center"
                       ToolTip="The full path of the polygon feature class to create, inside a file geodatabase: one perimeter for each checked fire, with its name, date, acres and the thresholds its analyst set. An existing feature class of that name is replaced." />
            </DockPanel>

            <TextBlock Style="{StaticResource Head}" Margin="0,14,0,4" Text="Classified rasters to fetch for each fire" />
            <StackPanel x:Name="ProductPanel" />
            <TextBlock x:Name="ProductNote" Style="{StaticResource Note}" />
            <DockPanel Margin="0,6,0,0">
              <TextBlock DockPanel.Dock="Left" Text="Folder or geodatabase for the rasters:" VerticalAlignment="Center" />
              <Button DockPanel.Dock="Right" Content="Browse..." Width="84" Height="24" Margin="8,0,0,0" Click="OnBrowseRasters"
                      ToolTip="Choose the folder or the file geodatabase to write the classified rasters into. Nothing is created until you click Get the data." />
              <TextBox x:Name="RasterBox" Height="24" Margin="8,0,0,0" VerticalContentAlignment="Center"
                       ToolTip="Where the classified rasters are written: a folder (GeoTIFF files) or a file geodatabase. Left empty, they go into the geodatabase of the output perimeters." />
            </DockPanel>
            <TextBlock Style="{StaticResource Note}" Text="Empty: the geodatabase of the perimeters." />

            <TextBlock Style="{StaticResource Head}" Margin="0,14,0,4" Text="Data bundles, by email (optional)" />
            <TextBlock TextWrapping="Wrap"
                       Text="A fire's data bundle holds what the image services do not: the continuous indices, with their true cells and in the projection chosen below, and the rasters of fires too recent to be in the national mosaics. The Burn Severity Portal sends bundles by email only. Give an address and the tool asks the portal for the bundles of the checked fires, in one request." />
            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0"
                       Text="Nothing is downloaded by this window. The portal emails you a link, usually within minutes. You download the zip file yourself, then load it with Load Burn Severity Bundle (Online Data)." />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="Email address:" VerticalAlignment="Center" />
              <TextBox x:Name="EmailBox" Width="320" Height="24" Margin="8,0,0,0" VerticalContentAlignment="Center"
                       TextChanged="OnEmailChanged"
                       ToolTip="The address the Burn Severity Portal sends the download link to. It is sent to the portal and is not kept by this tool. Empty: no bundle is requested." />
              <TextBlock x:Name="EmailNote" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="10,0,0,0"
                         Text="Empty: no bundle is requested." />
            </StackPanel>
            <CheckBox x:Name="ImagesBox" Margin="0,6,0,0" IsEnabled="False"
                      Content="Include the pre-fire and post-fire images in the bundles"
                      ToolTip="Also ask for the two satellite images each assessment was made from: the reflectance image taken before the fire and the one taken after it. They make the zip file much larger." />
            <StackPanel x:Name="ProjectionPanel" Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="False">
              <TextBlock Text="Projection of the bundles:" VerticalAlignment="Center" />
              <RadioButton x:Name="ProjUtm" GroupName="burnproj" IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center"
                           Content="UTM (each fire's own zone)"
                           ToolTip="True 30-meter cells in the UTM zone of each fire. Suits work on one fire or one region." />
              <RadioButton x:Name="ProjAlbers" GroupName="burnproj" Margin="14,0,0,0" VerticalAlignment="Center"
                           Content="Albers (one national grid)"
                           ToolTip="The single equal-area projection of the national mosaics. Suits work on fires spread across the country, because every fire is then on the same grid." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="GetButton" Content="Get the data" Height="30" Padding="18,0" Click="OnGet"
                      ToolTipService.ShowOnDisabled="True"
                      ToolTip="Writes the perimeters of the checked fires, fetches the classified rasters asked for, each with the name, area and percent of every class in its attribute table, adds them to the active map, and sends the bundle request if an email address is given. The work is done by this program's Burn Severity geoprocessing tool, so the run is also recorded in the Geoprocessing History." />
              <Button x:Name="CancelButton" Content="Cancel" Height="30" Padding="14,0" Margin="8,0,0,0"
                      Click="OnCancel" IsEnabled="False" />
            </StackPanel>
            <ProgressBar x:Name="Progress" Height="14" Margin="0,10,0,0" Minimum="0" Maximum="100" />
            <TextBlock x:Name="ProgressText" TextWrapping="Wrap" Margin="0,4,0,0" />
            <RichTextBox x:Name="LogBox" Height="190" Margin="0,8,0,0" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
