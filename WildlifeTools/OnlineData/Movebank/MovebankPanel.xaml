<UserControl x:Class="WildlifeTools.OnlineData.Movebank.MovebankPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:od="clr-namespace:WildlifeTools.OnlineData">
  <!-- The whole content of the Movebank Animal Tracks window: plain WPF, so
       it can be drawn and checked outside ArcGIS Pro. Everything that needs
       Pro (the default output paths, running the geoprocessing tool, the
       help page) is in MovebankActions, reached from clicks. No colors are
       set on text: the window's theme applies. -->
  <UserControl.Resources>
    <Style TargetType="ToolTip">
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="400" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="12">
    <!-- bottom bar -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="Close" Width="84" Click="OnClose" IsCancel="True" />
      <!-- the suite's round blue help button -->
      <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0" Width="20" Height="20"
              Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnHelp"
              ToolTip="Open the online help page for this tool">
        <Grid>
          <Ellipse Width="18" Height="18" Fill="#0079C1" />
          <TextBlock Text="?" Foreground="White" FontWeight="Bold" FontSize="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
        </Grid>
      </Button>
      <TextBlock VerticalAlignment="Center">
        <Run Text="Data from the" />
        <Hyperlink NavigateUri="https://datarepository.movebank.org" RequestNavigate="OnLink"
                   ToolTip="Open the Movebank Data Repository in your web browser.">Movebank Data Repository</Hyperlink>
        <Run Text="and" />
        <Hyperlink NavigateUri="https://www.movebank.org" RequestNavigate="OnLink"
                   ToolTip="Open Movebank in your web browser.">Movebank</Hyperlink>
      </TextBlock>
    </DockPanel>
    <!-- the message line: wrapped, hidden when empty -->
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0"
               FontWeight="SemiBold" Visibility="Collapsed" />

    <TabControl x:Name="Tabs">
      <!-- ============================================================ -->
      <TabItem Header="1. Find a dataset">
        <DockPanel Margin="10">
          <!-- where to look, and the sign-in -->
          <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8" BorderThickness="1"
                  BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <StackPanel>
              <TextBlock Style="{StaticResource Head}" Text="Where to look" />
              <RadioButton x:Name="SourceRepo" GroupName="mbsource" IsChecked="True" Checked="OnSourceChanged"
                           Content="Published datasets, in the Movebank Data Repository (no account needed)"
                           ToolTip="The datasets whose owners have published them. Each has a DOI and a citation, does not change once it is published, and can be loaded without a Movebank account." />
              <RadioButton x:Name="SourceStudies" GroupName="mbsource" Margin="0,4,0,0" Checked="OnSourceChanged"
                           Content="Studies in Movebank that my Movebank account may download (needs a sign-in)"
                           ToolTip="The studies in Movebank itself whose owners let your account download their data: many more than have been published. You sign in with your own Movebank user name and password, and you must read and accept each study's license terms before its data are fetched. A study is not a published dataset: its owner can add to it and correct it." />
              <DockPanel Margin="0,8,0,0">
                <Button x:Name="SignInButton" DockPanel.Dock="Left" Content="Sign in to Movebank..." Height="26" Padding="12,0"
                        Click="OnSignIn"
                        ToolTip="Give the user name and password of your own Movebank account. They are checked with Movebank and then kept on this computer, in Windows Credential Manager." />
                <Button x:Name="SignOutButton" DockPanel.Dock="Left" Content="Sign out" Height="26" Padding="12,0" Margin="8,0,0,0"
                        Click="OnSignOut" Visibility="Collapsed"
                        ToolTip="Remove the Movebank sign-in from Windows Credential Manager on this computer." />
                <TextBlock x:Name="AccountText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"
                           Text="Not signed in to Movebank. The published datasets need no sign-in." />
              </DockPanel>
            </StackPanel>
          </Border>
          <TextBlock x:Name="NoteA" DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,0,0,8"
                     Text="The Movebank Data Repository holds the animal tracking datasets that their owners have published. Each published dataset has a DOI, a license and a citation, and can be loaded without a Movebank account. Search by species (scientific or common name), place or any other word." />
          <TextBlock x:Name="NoteB" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="SemiBold"
                     Text="Caution: Most of the data on Movebank can be reached only with a Movebank account and the permission of the person who posted them. The published datasets, which need neither, are a small fraction of what Movebank holds. So the odds are slim that you will find the species you want to study in the area you are interested in. The published datasets are good for seeing how a species moves in general: they suit conceptual questions about animal movement better than an analysis of a particular species in a particular place." />
          <TextBlock x:Name="NoteC" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="SemiBold"
                     Text="Movebank offers no search by area. A dataset's record does not hold coordinates, so the datasets cannot be limited to a study area or to the map, and the tracks cannot be seen before they are loaded. A place name in the search box finds only the datasets whose title, summary or keywords mention it. Read the details below the list to judge where a dataset is." />
          <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="Clear" Width="70" Height="26" Margin="8,0,0,0" Click="OnClear"
                    ToolTip="Empty the search box and the list, and un-choose the dataset." />
            <Button DockPanel.Dock="Right" Content="Search" Width="90" Height="26" Margin="8,0,0,0" Click="OnSearch"
                    IsDefault="True"
                    ToolTip="List the published datasets that match, newest first. With the box empty, every published dataset is listed." />
            <ComboBox x:Name="SensorBox" DockPanel.Dock="Right" Width="190" Height="26" Margin="8,0,0,0"
                      ToolTip="List only the datasets that hold data from this kind of sensor." />
            <TextBlock DockPanel.Dock="Right" Text="Sensor:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox x:Name="SearchBox" Height="26" VerticalContentAlignment="Center"
                     ToolTip="Words to look for in the datasets' titles, summaries, species and keywords: for example pronghorn, Ciconia ciconia, or Wyoming. Put a phrase in double quotes to search for it exactly." />
          </DockPanel>
          <DockPanel x:Name="AreaRow" DockPanel.Dock="Top" Margin="0,6,0,0" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Left" Text="Main location of the study in:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="AreaBox" Height="26" DropDownOpened="OnAreaDropDown" SelectionChanged="OnAreaChanged"
                      ToolTip="List only the studies whose main location is inside the rectangle around a study area: the current map extent, or a polygon layer of the map (its selected polygons, when it has a selection). A study has ONE main location, set by its owner, and its animals may travel far from it, so this finds studies centered in the area, not every study with a fix in it. The list of layers is read from the map each time this box is opened." />
          </DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,6,0,0">
            <Button x:Name="MoreButton" DockPanel.Dock="Right" Content="Show more" Height="24" Padding="12,0"
                    Click="OnMore" IsEnabled="False"
                    ToolTip="Add the next 25 matching datasets to the list." />
            <TextBlock x:Name="SearchNote" Style="{StaticResource Note}" VerticalAlignment="Center" />
          </DockPanel>

          <!-- the selected dataset -->
          <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8" BorderThickness="1"
                  BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <DockPanel Height="200">
              <DockPanel DockPanel.Dock="Top">
                <Button x:Name="ChooseButton" DockPanel.Dock="Right" Content="Choose this dataset" Height="28" Padding="14,0"
                        Margin="10,0,0,4" VerticalAlignment="Top" Click="OnChoose" IsEnabled="False"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Take the dataset whose details are shown here to tab 2, where you choose what to create and get the data. Nothing is fetched yet. A double-click on a row of the list does the same." />
                <TextBlock x:Name="DetailTitle" Style="{StaticResource Head}" TextWrapping="Wrap"
                           Text="Click a dataset in the list to see its details here. Then click Choose this dataset to go on to tab 2." />
              </DockPanel>
              <TextBlock x:Name="DetailFacts" DockPanel.Dock="Top" Style="{StaticResource Note}" />
              <TextBlock x:Name="DetailFiles" DockPanel.Dock="Top" Style="{StaticResource Note}" />
              <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Focusable="False">
                <StackPanel>
                  <TextBlock x:Name="DetailCitation" TextWrapping="Wrap" />
                  <TextBlock x:Name="DetailMore" TextWrapping="Wrap" Margin="0,6,0,0" />
                  <TextBlock x:Name="DetailAbstract" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.85" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <DataGrid x:Name="ResultsGrid" Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single"
                    GridLinesVisibility="Horizontal" SelectionChanged="OnResultSelected"
                    MouseDoubleClick="OnResultDoubleClick">
            <DataGrid.Columns>
              <DataGridTemplateColumn x:Name="TitleColumn" Header="Dataset" Width="3*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Margin="2,0,0,0" TextTrimming="CharacterEllipsis">
                      <Hyperlink od:LinkContrast.Around="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TextBlock}}" Click="OnTitleLink"
                                 ToolTip="Open this dataset's or study's page at Movebank in your web browser."><Run Text="{Binding Title, Mode=OneWay}" /></Hyperlink>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Species" Binding="{Binding Species}" Width="2*" />
              <DataGridTextColumn Header="Animals" Binding="{Binding AnimalsText}" Width="70" />
              <DataGridTextColumn Header="Locations" Binding="{Binding LocationsText}" Width="100" />
              <DataGridTextColumn x:Name="DateColumn" Header="Published" Binding="{Binding Issued}" Width="86" />
              <DataGridTextColumn Header="License" Binding="{Binding LicenseShort}" Width="90" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- ============================================================ -->
      <TabItem Header="2. Get the data">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Margin="10">
            <TextBlock Style="{StaticResource Head}" Text="The dataset" />
            <TextBlock x:Name="ChosenText" TextWrapping="Wrap"
                       Text="No dataset is chosen. Click one in the list on tab 1 and then Choose this dataset, or load a dataset that is already on disk." />
            <StackPanel x:Name="TermsPanel" Margin="0,12,0,0" Visibility="Collapsed">
              <TextBlock Style="{StaticResource Head}" Text="The study's license terms" />
              <TextBlock x:Name="TermsNote" TextWrapping="Wrap"
                         Text="Movebank hands over a study only after your account has accepted the study's license terms. Click Show the license terms and read them. If you accept them, check the box." />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="TermsButton" Content="Show the license terms..." Height="26" Padding="12,0" Click="OnShowTerms"
                        ToolTip="Asks Movebank for this study's license terms and shows them. Showing them accepts nothing. If your account has already accepted them, the window says so." />
              </StackPanel>
              <CheckBox x:Name="AcceptBox" Margin="0,8,0,0" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                        Content="I have read and accept this study's license terms"
                        ToolTip="Checked, the terms are accepted in the name of your Movebank account when you click Get the data, and the data are then fetched. Movebank remembers the acceptance, and does not ask again unless the study's owner changes the terms. The box can be checked only after the terms have been shown." />
            </StackPanel>
            <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                       Text="Optional, and only if you already have a Movebank dataset's files on disk from an earlier download: load those files in place of a dataset from tab 1. Otherwise skip this button." />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Button Content="Load files already on disk instead..." Height="26" Padding="12,0" Click="OnUseFolder"
                      ToolTip="Choose a folder that already holds a Movebank dataset's files (a folder this tool made in Data_Downloads, or one you downloaded yourself), in place of a dataset from tab 1. Nothing is fetched." />
              <Button x:Name="ClearFolderButton" Content="Use the dataset from tab 1" Height="26" Padding="12,0" Margin="8,0,0,0"
                      Click="OnClearFolder" Visibility="Collapsed"
                      ToolTip="Stop using the folder on disk and go back to the dataset chosen on tab 1." />
            </StackPanel>

            <TextBlock Style="{StaticResource Head}" Margin="0,14,0,0" Text="What to create" />
            <RadioButton x:Name="OutBoth" GroupName="mbout" IsChecked="True" Checked="OnOutputChanged"
                         Content="Points and track lines" />
            <RadioButton x:Name="OutPoints" GroupName="mbout" Margin="0,4,0,0" Checked="OnOutputChanged"
                         Content="Points only (one for every location fix, with all of the dataset's attributes)" />
            <RadioButton x:Name="OutLines" GroupName="mbout" Margin="0,4,0,0" Checked="OnOutputChanged"
                         Content="Track lines only (one for every animal, through its fixes in order of time)" />

            <TextBlock Style="{StaticResource Head}" Margin="0,12,0,4" Text="Output points (in a file geodatabase)" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse..." Width="84" Height="24" Margin="8,0,0,0" Click="OnBrowsePoints"
                      ToolTip="Choose the file geodatabase to save the points in, and type a name for the new feature class. The path is put in the box, where it can still be edited. Nothing is created until you click Get the data." />
              <TextBox x:Name="PointsBox" Height="24" VerticalContentAlignment="Center"
                       ToolTip="The full path of the point feature class to create, inside a file geodatabase. An existing feature class of that name is replaced." />
            </DockPanel>
            <TextBlock Style="{StaticResource Head}" Margin="0,8,0,4" Text="Output track lines (in a file geodatabase)" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse..." Width="84" Height="24" Margin="8,0,0,0" Click="OnBrowseLines"
                      ToolTip="Choose the file geodatabase to save the track lines in, and type a name for the new feature class. The path is put in the box, where it can still be edited. Nothing is created until you click Get the data." />
              <TextBox x:Name="LinesBox" Height="24" VerticalContentAlignment="Center"
                       ToolTip="The full path of the line feature class to create, inside a file geodatabase. An existing feature class of that name is replaced." />
            </DockPanel>

            <TextBlock Style="{StaticResource Head}" Margin="0,12,0,4" Text="Which fixes" />
            <CheckBox x:Name="FlaggedBox"
                      Content="Include fixes the data owner flagged as outliers"
                      ToolTip="Data owners mark fixes they judge to be wrong (a GPS error, a test before the tag was on the animal) by setting the fix's 'visible' attribute to false. Unchecked, those fixes are left out, which is what the owner intends. Checked, they are included and can be told apart by that field." />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="Only these animals:" VerticalAlignment="Center" />
              <TextBox x:Name="AnimalsBox" Width="420" Height="24" Margin="8,0,0,0" VerticalContentAlignment="Center"
                       ToolTip="The identifiers of the animals to load, separated by semicolons, exactly as the dataset writes them. Leave empty for every animal. If a name is not in the dataset, the report lists the names that are." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="GetButton" Content="Get the data" Height="30" Padding="18,0" Click="OnGet"
                      ToolTip="Fetches the dataset's files from the Movebank Data Repository into a folder named after the output, inside Data_Downloads in the project folder, and keeps them there: the data, the reference data about the animals and tags, and the README. It then reads the data and writes the points, the track lines, or both, adds them to the active map, and reports what was written, the dataset's license and how to cite it. Files that are already in the folder at their full size are not fetched again. The work is done by the Movebank Animal Tracks geoprocessing tool, so the run is also recorded in the Geoprocessing History." />
              <Button x:Name="CancelButton" Content="Cancel" Height="30" Padding="14,0" Margin="8,0,0,0"
                      Click="OnCancel" IsEnabled="False" />
            </StackPanel>
            <ProgressBar x:Name="Progress" Height="14" Margin="0,10,0,0" Minimum="0" Maximum="100" />
            <TextBlock x:Name="ProgressText" TextWrapping="Wrap" Margin="0,4,0,0" />
            <RichTextBox x:Name="LogBox" Height="250" Margin="0,8,0,0" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
