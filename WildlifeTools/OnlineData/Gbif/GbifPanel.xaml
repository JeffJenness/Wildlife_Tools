<UserControl x:Class="WildlifeTools.OnlineData.Gbif.GbifPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:od="clr-namespace:WildlifeTools.OnlineData">
  <!-- The whole content of the GBIF Species Occurrences window: plain WPF,
       so it can be drawn and checked outside ArcGIS Pro. Everything that
       needs Pro (the map's polygon layers, writing the points, adding the
       layer, the help page) is in GbifActions, reached from clicks. No
       colors are set on text: the window's theme applies. -->
  <UserControl.Resources>
    <Style TargetType="ToolTip">
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="400" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="12">
    <!-- bottom bar -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="Close" Width="84" Click="OnClose" IsCancel="True" />
      <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0" Width="20" Height="20"
              Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnHelp"
              ToolTip="Open the online help page for this tool">
        <Grid>
          <Ellipse Width="18" Height="18" Fill="#0079C1" />
          <TextBlock Text="?" Foreground="White" FontWeight="Bold" FontSize="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
        </Grid>
      </Button>
      <TextBlock VerticalAlignment="Center">
        <Run Text="Data from the" />
        <Hyperlink NavigateUri="https://www.gbif.org/" RequestNavigate="OnLink"
                   ToolTip="Open GBIF.org in your web browser.">Global Biodiversity Information Facility, GBIF.org</Hyperlink>
      </TextBlock>
    </DockPanel>
    <!-- messages: a full-width line of their own, wrapped, never cut off; hidden when empty -->
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0"
               FontWeight="SemiBold" Visibility="Collapsed" />

    <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged">
      <!-- ================= 1. Find ================= -->
      <TabItem Header="1. What and where">
        <Grid Margin="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="5*" />
          </Grid.ColumnDefinitions>

          <!-- which taxa -->
          <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Head}" Text="Which species or group" />
            <Grid DockPanel.Dock="Top">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="120" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="NameBox" Grid.Column="0" VerticalContentAlignment="Center" Height="24"
                       TextChanged="OnNameChanged" KeyDown="OnNameKeyDown"
                       ToolTip="Type the start of a scientific name at any rank: a species, a genus, a family, a class. Real names from GBIF's taxonomy appear below as you type." />
              <TextBlock Grid.Column="0" x:Name="NameHint" Text="Type a name, e.g. Cyanocitta or Corvidae"
                         IsHitTestVisible="False" Opacity="0.5" Margin="6,0,0,0" VerticalAlignment="Center" />
              <ComboBox x:Name="RankBox" Grid.Column="2" SelectionChanged="OnRankChanged"
                        ToolTip="Limit the suggestions to one rank." />
            </Grid>
            <CheckBox x:Name="CommonNameBox" DockPanel.Dock="Top" Margin="0,6,0,0"
                      Content="Search common names instead (press Enter to search)"
                      Checked="OnCommonToggled" Unchecked="OnCommonToggled"
                      ToolTip="Search GBIF's list of common names, such as steller's jay or ponderosa pine. Common names are less complete and less exact than scientific names." />
            <TextBlock x:Name="SuggestNote" DockPanel.Dock="Top" Style="{StaticResource Note}"
                       Text="Suggestions appear here. Double-click one, or select one or more (Shift or Ctrl) and click Add. Click a scientific name to open it on GBIF.org. The Records column is the number GBIF holds worldwide, of every kind." />

            <!-- chosen taxa, docked at the bottom of the column -->
            <TextBlock x:Name="ChosenNote" DockPanel.Dock="Bottom" Style="{StaticResource Note}"
                       Text="Nothing chosen: every species in the study area." />
            <DockPanel DockPanel.Dock="Bottom" Height="110" Margin="0,4,0,0">
              <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0" Width="84">
                <Button Content="Remove" Click="OnRemoveChosen" Margin="0,0,0,4" />
                <Button Content="Clear" Click="OnClearChosen" />
              </StackPanel>
              <ListBox x:Name="ChosenList" SelectionMode="Extended" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Head}" Margin="0,10,0,0"
                       Text="Chosen (each includes everything inside it)" />

            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
              <Button DockPanel.Dock="Right" Content="Add" Width="84" Click="OnAddSuggested"
                      ToolTip="Add every selected name to the chosen list." />
              <TextBlock x:Name="MatchNote" Style="{StaticResource Note}" VerticalAlignment="Center" />
            </DockPanel>

            <TabControl x:Name="NameTabs" Margin="0,6,0,0">
              <TabItem Header="Suggestions">
                <DataGrid x:Name="SuggestGrid" MouseDoubleClick="OnSuggestDoubleClick" BorderThickness="0"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="Horizontal">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Scientific name" Width="3*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Margin="2,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullName}">
                            <Hyperlink od:LinkContrast.Around="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TextBlock}}" Click="OnSuggestLink"><Run Text="{Binding Name, Mode=OneWay}" /></Hyperlink>
                          </TextBlock>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Common name" Binding="{Binding Common}" Width="2*" />
                    <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="76" />
                    <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="90" />
                    <DataGridTextColumn Header="Records" Binding="{Binding CountText}" Width="80" />
                  </DataGrid.Columns>
                </DataGrid>
              </TabItem>
              <TabItem Header="Browse the taxonomy">
                <TreeView x:Name="BrowseTree" BorderThickness="0" MouseDoubleClick="OnTreeDoubleClick"
                          ToolTip="Open a kingdom and work down: phylum, class, order, family, genus, species. Double-click a name, or select it and click Add." />
              </TabItem>
            </TabControl>
          </DockPanel>

          <!-- where, when, which records -->
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
              <TextBlock Style="{StaticResource Head}" Text="Study area" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Refresh" Width="70" Margin="6,0,0,0" Click="OnRefreshAreas"
                        ToolTip="Read the polygon layers of the active map again." />
                <ComboBox x:Name="AreaBox" SelectionChanged="OnAreaChanged"
                          ToolTip="A polygon layer of the active map (its selected polygons, or all of them when none are selected), the current map extent, or no study area at all." />
              </DockPanel>
              <TextBlock x:Name="AreaNote" Style="{StaticResource Note}" />
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Country" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="CountryBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" SelectionChanged="OnCountryChanged"
                          ToolTip="Limit the records to one country, by the country each record states or lies in. This works for records without coordinates too, and can be used with or without a study area." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="State or province" VerticalAlignment="Center" Margin="0,6,8,0" />
                <ComboBox x:Name="StateBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" SelectionChanged="OnStateChanged"
                          ToolTip="Limit the records to one state or province. Click List to see the names the matching records actually use, with the number of records for each: GBIF matches this text letter for letter, and publishers write it in different ways (Arizona, Ariz., AZ)." />
                <Button Grid.Row="1" Grid.Column="2" Content="List" Width="60" Margin="6,6,0,0" Click="OnListStates"
                        ToolTip="Ask GBIF which state or province names the matching records use." />
              </Grid>
              <TextBlock x:Name="StateNote" Style="{StaticResource Note}" />
              <CheckBox x:Name="IncludeNoCoordBox" Margin="0,8,0,0"
                        Content="Also get records that have no coordinates"
                        Checked="OnNoCoordToggled" Unchecked="OnNoCoordToggled"
                        ToolTip="Many records carry a species, a date, a country or county and sometimes the animal's sex or life stage, but no coordinates: locations of sensitive species are often withheld. Checked, those records are returned too, as rows of the attribute table that have no point, so they can be counted and summarized but never take part in a spatial analysis. A study area limits only the records that have coordinates; a record without coordinates cannot be tested against it, so use the Country and State or province boxes to limit those." />
              <TextBlock x:Name="NoCoordNote" Style="{StaticResource Note}" />

              <TextBlock Style="{StaticResource Head}" Margin="0,12,0,4" Text="Years and months" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="From" VerticalAlignment="Center" />
                <TextBox x:Name="YearFromBox" Width="56" Margin="6,0,12,0" Height="22" VerticalContentAlignment="Center"
                         ToolTip="First year to include. Leave empty for no limit." />
                <TextBlock Text="to" VerticalAlignment="Center" />
                <TextBox x:Name="YearToBox" Width="56" Margin="6,0,0,0" Height="22" VerticalContentAlignment="Center"
                         ToolTip="Last year to include. Leave empty for no limit." />
              </StackPanel>
              <WrapPanel x:Name="MonthPanel" Margin="0,6,0,0" />

              <TextBlock Style="{StaticResource Head}" Margin="0,12,0,4" Text="Which records" />
              <WrapPanel x:Name="BasisPanel" />
              <CheckBox x:Name="NoIssuesBox" Margin="0,8,0,0" IsChecked="True"
                        Content="Leave out records whose location GBIF flags as a problem"
                        ToolTip="GBIF checks every record's coordinates (zero coordinates, wrong country, swapped latitude and longitude and more). This leaves out the records that failed those checks. Whatever you choose here, a record at latitude 0, longitude 0 is never written as a point." />
              <CheckBox x:Name="NoCentroidBox" Margin="0,4,0,0" IsChecked="True"
                        Content="Leave out records placed at the center of a country or region"
                        ToolTip="Some records have no real coordinates and were given the center point of their country, state or province instead. GBIF marks records within 5 kilometers of such a center point; checked, they are left out." />
              <CheckBox x:Name="PresentBox" Margin="0,4,0,0" IsChecked="True"
                        Content="Presence records only"
                        ToolTip="Some surveys also publish records of a species being looked for and NOT found. Checked, those absence records are left out." />
              <CheckBox x:Name="NoNcBox" Margin="0,4,0,0"
                        Content="Leave out records licensed for non-commercial use only (CC BY-NC)"
                        ToolTip="Every GBIF record carries one of three licenses: CC0 (no restriction), CC BY (credit required) or CC BY-NC (credit required, non-commercial use only). Check this if your work is commercial." />
              <CheckBox x:Name="ImagesBox" Margin="0,4,0,0"
                        Content="Only records with a photograph" />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Coordinate uncertainty no more than" VerticalAlignment="Center" />
                <TextBox x:Name="UncertBox" Width="64" Margin="6,0,6,0" Height="22" VerticalContentAlignment="Center"
                         ToolTip="Keep only records whose stated coordinate uncertainty is at most this many meters. Records that state no uncertainty at all are left out too, so use this with care. Leave empty for no limit." />
                <TextBlock Text="meters" VerticalAlignment="Center" />
              </StackPanel>

              <Button Content="Count the records" Margin="0,14,0,0" Height="28" HorizontalAlignment="Left" Padding="14,0"
                      Click="OnCount"
                      ToolTip="Ask GBIF how many records match. Nothing is fetched, and no account is needed." />
              <TextBlock x:Name="CountText" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ================= 2. Species here ================= -->
      <TabItem Header="2. Species here">
        <DockPanel Margin="10">
          <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Left" Content="List again" Height="28" Padding="14,0" Click="OnListSpecies"
                    ToolTip="Ask GBIF again which species have records that match tab 1, with the number of records of each. The list also refreshes by itself whenever you come back to this tab after changing something on tab 1. Nothing is fetched." />
            <Button DockPanel.Dock="Right" Content="Get only the checked species" Height="28" Padding="14,0"
                    Click="OnAddCheckedSpecies"
                    ToolTip="Replace the Chosen list on tab 1 with the species checked here, so that the counts, the sources and the records you get are limited to them. Until you click this, checking a species changes nothing." />
            <TextBlock x:Name="SpeciesNote" Style="{StaticResource Note}" Margin="12,0,12,0" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,8,0,0"
                     Text="These are the species that have records matching your choices on tab 1; the list is asked for again whenever those choices change. It is for looking: to get the records of only some of these species, check them and click &quot;Get only the checked species&quot;, which puts them in the Chosen list on tab 1." />
          <WrapPanel x:Name="GroupPanel" DockPanel.Dock="Top" Margin="0,8,0,0">
            <TextBlock Text="List only:" VerticalAlignment="Center" Margin="0,0,10,2" FontWeight="SemiBold"
                       ToolTip="Check one or more groups to list only their species. With none checked, every species is listed. This narrows the list on this tab only: it does not change the counts, the sources or the records you get." />
          </WrapPanel>
          <!-- photographs of the selected species -->
          <DockPanel DockPanel.Dock="Bottom" Height="230" Margin="0,8,0,0">
            <DockPanel DockPanel.Dock="Top">
              <Button x:Name="MorePhotosButton" DockPanel.Dock="Left" Content="More photographs" Padding="12,2"
                      Click="OnMorePhotos" IsEnabled="False"
                      ToolTip="Show the next few photographs of the same species." />
              <TextBlock x:Name="PhotoNote" Style="{StaticResource Note}" Margin="12,0,0,0" VerticalAlignment="Center"
                         Text="Click &quot;show&quot; beside a species to see photographs of it here." />
            </DockPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Margin="0,6,0,0" Focusable="False">
              <StackPanel x:Name="PhotoPanel" Orientation="Horizontal" />
            </ScrollViewer>
          </DockPanel>
          <DataGrid x:Name="SpeciesGrid" Margin="0,8,0,0" AutoGenerateColumns="False" CanUserAddRows="False"
                    CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                    GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="" Binding="{Binding Checked, UpdateSourceTrigger=PropertyChanged}" Width="34" />
              <DataGridTextColumn Header="Species (common name)" Binding="{Binding Display}" IsReadOnly="True" Width="2*" />
              <DataGridTextColumn Header="Records" Binding="{Binding CountText}" IsReadOnly="True" Width="90" />
              <DataGridTemplateColumn Header="Photographs" IsReadOnly="True" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Margin="2,0,0,0">
                      <Hyperlink od:LinkContrast.Around="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TextBlock}}" Click="OnSpeciesPhotosLink"
                                 ToolTip="Show a few photographs of this species from the matching records, below the list.">show</Hyperlink>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- ================= 3. Sources ================= -->
      <TabItem Header="3. Sources">
        <DockPanel Margin="10">
          <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Left" Content="List again" Height="28" Padding="14,0" Click="OnListSources"
                    ToolTip="Ask GBIF again which datasets (sources) the matching records come from, with the number of records from each. The list also refreshes by itself whenever you come back to this tab after changing something on tab 1. Nothing is fetched." />
            <Button DockPanel.Dock="Right" Content="Uncheck all" Height="28" Padding="12,0" Margin="6,0,0,0" Click="OnUncheckSources" />
            <Button DockPanel.Dock="Right" Content="Check all" Height="28" Padding="12,0" Click="OnCheckSources" />
            <TextBlock x:Name="SourcesNote" Style="{StaticResource Note}" Margin="12,0,12,0" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,8,0,0"
                     Text="The checkboxes say which sources the tool uses. Records from a checked source are included in the counts, the species list, the photographs and the records you get; records from an unchecked source are left out of all of them. Every source starts checked. Anyone can publish to GBIF, and nobody reviews the records before they appear, so sources differ in how far they can be trusted: click a source's name to read about it on GBIF.org." />
          <TextBlock x:Name="ExcludedNote" DockPanel.Dock="Bottom" Style="{StaticResource Note}" Margin="0,8,0,0" />
          <DataGrid x:Name="SourcesGrid" Margin="0,8,0,0" AutoGenerateColumns="False" CanUserAddRows="False"
                    CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                    GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Use" Binding="{Binding Checked, UpdateSourceTrigger=PropertyChanged}" Width="40" />
              <DataGridTemplateColumn Header="Source (click a name to read about it on GBIF.org)" IsReadOnly="True" Width="3*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Margin="2,0,0,0" TextTrimming="CharacterEllipsis">
                      <Hyperlink od:LinkContrast.Around="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TextBlock}}" Click="OnSourceLink"
                                 ToolTip="Open this dataset's page on GBIF.org: what it is, who publishes it and how it should be cited."><Run Text="{Binding Name, Mode=OneWay}" /></Hyperlink>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="License" Binding="{Binding License}" IsReadOnly="True" Width="*" />
              <DataGridTextColumn Header="Records" Binding="{Binding CountText}" IsReadOnly="True" Width="90" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- ================= 4. Get the data ================= -->
      <TabItem Header="4. Get the data">
        <DockPanel Margin="10">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Head}" Text="How to get the records" />
            <RadioButton x:Name="RouteSearch" GroupName="route" IsChecked="True" Margin="0,2,0,0"
                         Content="Fetch them now (quick; up to 100,000 records; no account needed)" />
            <RadioButton x:Name="RouteDownload" GroupName="route" Margin="0,4,0,0"
                         Content="Request a GBIF download (any number of records; gives a DOI and a citation; needs your free GBIF account)"
                         ToolTip="GBIF prepares a file of the records under your account and gives it a DOI. The tool fetches the file, writes the records to the output feature class, and keeps the original file in a folder named Data_Downloads in the project folder, under the same name as the feature class." />
            <TextBlock x:Name="RouteNote" Style="{StaticResource Note}" />

            <TextBlock Style="{StaticResource Head}" Margin="0,12,0,0" Text="GBIF account" />
            <TextBlock Style="{StaticResource Note}" Margin="0,0,0,4"
                       Text="Only required for requesting a GBIF download and for the list of your downloads on tab 5. Choosing names, counting records, listing species, viewing photographs and fetching records directly all work without an account." />
            <DockPanel>
              <Button x:Name="SignOutButton" DockPanel.Dock="Right" Content="Sign out" Width="84" Margin="6,0,0,0"
                      Click="OnForgetAccount" IsEnabled="False"
                      ToolTip="Sign out of GBIF in this window, and remove the stored GBIF user name and password from Windows Credential Manager on this computer. The geoprocessing tool can then no longer request GBIF downloads until someone signs in again." />
              <Button x:Name="SignInButton" DockPanel.Dock="Right" Content="Sign in..." Width="120" Click="OnSignIn"
                      ToolTip="Enter a GBIF user name and password. They are checked with GBIF and kept in Windows Credential Manager, under your own Windows login. When you are already signed in, this switches to another GBIF account." />
              <TextBlock x:Name="AccountText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>

            <TextBlock Style="{StaticResource Head}" Margin="0,12,0,4" Text="Output point feature class (in a file geodatabase)" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse..." Width="84" Height="24" Margin="8,0,0,0" Click="OnBrowseOutput"
                      ToolTip="Choose the file geodatabase to save the points in, and type a name for the new feature class. The path is put in the box, where it can still be edited. Nothing is created until you click Get the records." />
              <TextBox x:Name="OutBox" Height="24" VerticalContentAlignment="Center"
                       ToolTip="The full path of the point feature class to create, inside a file geodatabase. An existing feature class of that name is replaced. Type it, or click Browse to choose the geodatabase and give a name." />
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="GetButton" Content="Get the records" Height="30" Padding="18,0" Click="OnGet"
                      ToolTip="Gets the records chosen on tabs 1 to 3 and writes them to the output feature class. It first asks GBIF how many records match, and stops if there are none. With &quot;Fetch them now&quot;, the records are fetched from GBIF a page at a time. With &quot;Request a GBIF download&quot;, GBIF is asked to prepare a file under your account; the window waits for it, fetches it, and keeps the original zip file in the Data_Downloads folder of the project. Either way the records are then written to the output point feature class (an existing feature class of that name is replaced), the layer is added to the active map, and the report below lists what was written, the licenses of the records and the sources they came from. The work is done by the GBIF Species Occurrences geoprocessing tool, so the run is also recorded in the Geoprocessing History. Cancel stops it, and also cancels a download request at GBIF." />
              <Button x:Name="CancelButton" Content="Cancel" Height="30" Padding="14,0" Margin="8,0,0,0"
                      Click="OnCancel" IsEnabled="False" />
              <Button Content="How to cite GBIF data..." Height="30" Padding="14,0" Margin="24,0,0,0" Click="OnCiteHelp"
                      ToolTip="Why GBIF asks to be cited, what a download's DOI is, and how to cite records that were fetched directly." />
              <Button x:Name="SaveSourcesButton" Content="Save the source list..." Height="30" Padding="14,0" Margin="8,0,0,0"
                      Click="OnSaveSources" IsEnabled="False"
                      ToolTip="Save a table of the GBIF datasets the last result came from, with the number of records from each. GBIF asks for exactly this table when you register a 'derived dataset' to get a DOI for records that were fetched directly." />
            </StackPanel>
            <ProgressBar x:Name="Progress" Height="14" Margin="0,10,0,0" Minimum="0" Maximum="100" />
            <TextBlock x:Name="ProgressText" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <!-- the report: one bulleted paragraph per item, with space between them;
               text can still be selected and copied -->
          <RichTextBox x:Name="LogBox" Margin="0,10,0,0" IsReadOnly="True" IsDocumentEnabled="True"
                       VerticalScrollBarVisibility="Auto">
            <FlowDocument PagePadding="8,6,8,6" />
          </RichTextBox>
        </DockPanel>
      </TabItem>

      <!-- ================= 4. My downloads ================= -->
      <TabItem Header="5. My GBIF downloads">
        <DockPanel Margin="10">
          <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Left" Content="Refresh" Height="28" Padding="14,0" Click="OnRefreshDownloads"
                    ToolTip="List the downloads on your GBIF account, including any requested on GBIF's own web site." />
            <Button DockPanel.Dock="Right" Content="Load a zip file from disk..." Height="28" Padding="14,0" Margin="12,0,0,0"
                    Click="OnLoadZip"
                    ToolTip="Choose a GBIF download zip file that is already on this computer (one this tool kept in the Data_Downloads folder, or one you downloaded from GBIF.org), write its records to the output feature class named on tab 4, and add it to the active map. No GBIF account is needed." />
            <TextBlock x:Name="DownloadsNote" Style="{StaticResource Note}" Margin="12,0,0,0" VerticalAlignment="Center" />
          </DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Load into the map" Height="28" Padding="14,0" Click="OnLoadDownload"
                    ToolTip="Fetch the selected download, write its records to the output feature class named on tab 4, and add it to the active map." />
            <Button Content="Cancel the request" Height="28" Padding="14,0" Margin="8,0,0,0" Click="OnCancelDownload"
                    ToolTip="Cancel the selected download if GBIF is still preparing it." />
            <Button Content="Open its page on GBIF.org" Height="28" Padding="14,0" Margin="8,0,0,0" Click="OnOpenDownloadPage" />
            <Button Content="Copy the citation" Height="28" Padding="14,0" Margin="8,0,0,0" Click="OnCopyCitation"
                    ToolTip="Copy GBIF's citation for the selected download, with its DOI, to the clipboard." />
            <Button Content="How to cite GBIF data..." Height="28" Padding="14,0" Margin="8,0,0,0" Click="OnCiteHelp" />
          </StackPanel>
          <DataGrid x:Name="DownloadsGrid" Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single"
                    GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Requested" Binding="{Binding CreatedText}" Width="130" />
              <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100" />
              <DataGridTextColumn Header="Records" Binding="{Binding RecordsText}" Width="90" />
              <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80" />
              <DataGridTextColumn Header="Format" Binding="{Binding FormatText}" Width="150" />
              <DataGridTextColumn Header="DOI" Binding="{Binding Doi}" Width="150" />
              <DataGridTextColumn Header="GBIF erases it after" Binding="{Binding EraseText}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
