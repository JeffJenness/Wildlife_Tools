<UserControl x:Class="WildlifeTools.ColorHelper.ElementColorHelperPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The whole content of the Element Color Helper window: plain WPF, so it
       can be drawn and checked outside ArcGIS Pro (claude_tests/
       ElementColorHelperRender). Pro's color picker is created in code when
       the panel is loaded inside Pro (see the code-behind). No colors are
       set on text: the window's light or dark theme applies. -->
  <UserControl.Resources>
    <Style TargetType="ToolTip">
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="400" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- a color swatch: the color on a white tile with a thin edge -->
    <DataTemplate x:Key="SwatchCell">
      <Border Width="34" Height="18" Background="White" BorderBrush="#9A9A9A"
              BorderThickness="1" Margin="2,0">
        <Rectangle Fill="{Binding}" Margin="1" />
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8">
      Changes the colors of the selected elements all at once: a legend's
      text, a scale bar's marks and labels, a north arrow, text, drawn
      graphics. Each color found in the selection is listed below by what
      it is used for. Check the rows to change, pick the new color, assign
      it, and apply. Every color keeps its own transparency; a star marks a
      color that is partly transparent in some of its uses.
    </TextBlock>

    <TextBlock x:Name="txtSelection" DockPanel.Dock="Top" TextWrapping="Wrap"
               FontWeight="SemiBold" Margin="0,0,0,8" />

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <CheckBox x:Name="chkFrames" Content="Include element frames (border, background, shadow)"
                Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                ToolTip="Also list and change the colors of each element's own frame: its border line, its background fill and its shadow. Off by default, so a white background box behind a legend stays white when the legend's text is changed." />
      <CheckBox x:Name="chkHalos" Content="Include text halos, shadows and callouts" Margin="18,0,0,0"
                Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                ToolTip="Also list and change the colors of text halos, text shadows and callout backgrounds. Off by default: a halo is usually the contrasting color around the text, and changing it to the text's new color would swallow the text." />
    </StackPanel>

    <!-- bottom bar -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="Close" Width="84" Click="OnClose" IsCancel="True" />
      <!-- the suite's round blue help button (as on the Graphic Background dialogs) -->
      <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0" Width="20" Height="20"
              Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnHelp"
              ToolTip="Open the online help page for this tool">
        <Grid>
          <Ellipse Width="18" Height="18" Fill="#0079C1" />
          <TextBlock Text="?" Foreground="White" FontWeight="Bold" FontSize="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
        </Grid>
      </Button>
      <Button x:Name="btnRestore" DockPanel.Dock="Right" Content="Restore Original Colors"
              Padding="12,3" Margin="0,0,8,0" Click="OnRestore" IsEnabled="False"
              ToolTip="Put back the colors every element had before this window first changed it, all at once. ArcGIS Pro's own Undo works too, one element per step." />
      <Button x:Name="btnApply" DockPanel.Dock="Right" Content="Apply" Width="90" Margin="0,0,8,0"
              Click="OnApply" IsEnabled="False" FontWeight="SemiBold"
              ToolTip="Change every color that has a new color in the New column, in all of the selected elements." />
      <TextBlock x:Name="txtStatus" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
    </DockPanel>

    <!-- the new color and the row buttons -->
    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="New color for the checked rows:" VerticalAlignment="Center"
                 Margin="0,0,8,0" />
      <!-- Pro's ColorPickerControl goes here when the panel loads inside Pro -->
      <ContentControl x:Name="pickerHost" Grid.Column="1" Height="24" MinWidth="72"
                      VerticalAlignment="Center" />
      <Button x:Name="btnAssign" Grid.Column="2" Content="Assign" Padding="12,2" Margin="8,0,0,0"
              Click="OnAssign" IsEnabled="False"
              ToolTip="Give the checked rows this new color. Nothing changes on the layout until Apply is clicked." />
      <Button x:Name="btnClear" Grid.Column="3" Content="Clear" Padding="12,2" Margin="6,0,0,0"
              Click="OnClearNew" IsEnabled="False"
              ToolTip="Take the new color away from the checked rows, so they are left as they are." />
      <Button Grid.Column="5" Content="Check All" Padding="10,2" Margin="12,0,0,0" Click="OnCheckAll" />
      <Button Grid.Column="6" Content="Uncheck All" Padding="10,2" Margin="6,0,0,0" Click="OnUncheckAll" />
    </Grid>

    <!-- the colors found -->
    <ListView x:Name="lstColors" SelectionMode="Extended"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListView.View>
        <GridView>
          <GridViewColumn Width="36">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" HorizontalAlignment="Center"
                          ToolTip="Check the rows that should get the new color." />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Color" Width="62">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <ContentControl Content="{Binding Swatch}" ContentTemplate="{StaticResource SwatchCell}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="" Width="96" DisplayMemberBinding="{Binding ColorName}" />
          <GridViewColumn Header="Used for" Width="150" DisplayMemberBinding="{Binding RoleName}" />
          <GridViewColumn Header="Uses" Width="48" DisplayMemberBinding="{Binding CountText}" />
          <GridViewColumn Header="New" Width="62">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <ContentControl Content="{Binding NewSwatch}" ContentTemplate="{StaticResource SwatchCell}"
                                Visibility="{Binding NewVisibility}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="" Width="96" DisplayMemberBinding="{Binding NewName}" />
          <GridViewColumn Header="In" Width="260" DisplayMemberBinding="{Binding ElementsText}" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</UserControl>
