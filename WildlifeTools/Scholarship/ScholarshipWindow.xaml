<Window x:Class="WildlifeTools.Scholarship.ScholarshipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lois Engelman Memorial Scholarship Fund"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Height"
        Width="900" MaxHeight="880" Opacity="0"
        Loaded="OnLoaded">
  <!-- The colors and lettering are those of the Jenness Enterprises web
       site (forest green, parchment, a gold rule), so the card and the
       scholarship page it links to belong together. -->
  <Window.Resources>
    <FontFamily x:Key="BodyFont">/WildlifeTools;component/Fonts/#EB Garamond, Georgia</FontFamily>
    <SolidColorBrush x:Key="GreenBrush" Color="#24462F" />
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#2E5D43" />
    <SolidColorBrush x:Key="GoldBrush" Color="#C9A227" />
    <SolidColorBrush x:Key="InkBrush" Color="#2A2A26" />
    <SolidColorBrush x:Key="ParchmentBrush" Color="#F6F3EA" />

    <Style x:Key="BodyText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
      <Setter Property="FontSize" Value="17.5" />
      <Setter Property="LineHeight" Value="24" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="Margin" Value="0,0,0,11" />
    </Style>

    <!-- The filled button: the two links. -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Foreground" Value="#F6F3EA" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Padding" Value="18,6,18,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource GreenBrush}"
                    BorderBrush="#16301F" BorderThickness="1" CornerRadius="5"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GreenSoftBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16301F" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The quiet button: Close. -->
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
      <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent"
                    BorderBrush="{StaticResource GreenBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E9E4D3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- Outer margin leaves room for the drop shadow so it isn't clipped by the
       transparent window edge. The whole card drags the window. -->
  <Border CornerRadius="14" BorderThickness="3" Margin="18"
          MouseLeftButtonDown="OnDrag">
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E5D43" Offset="0" />
        <GradientStop Color="#24462F" Offset="1" />
      </LinearGradientBrush>
    </Border.BorderBrush>
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="3" Opacity="0.5" />
    </Border.Effect>

    <Border x:Name="CardBorder" CornerRadius="11"
            Background="{StaticResource ParchmentBrush}">
      <Grid>
        <!-- Close button -->
        <Button Content="&#x2715;" Click="OnClose" Cursor="Hand"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="26" Height="26" Margin="6" FontSize="13" Panel.ZIndex="2"
                Foreground="{StaticResource GreenBrush}" Background="Transparent"
                BorderThickness="0" ToolTip="Close" />

        <StackPanel Margin="34,26,34,22">
          <TextBlock Text="Lois Engelman Memorial Scholarship Fund"
                     FontFamily="{StaticResource BodyFont}" FontSize="29"
                     FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}"
                     HorizontalAlignment="Center" TextAlignment="Center"
                     TextWrapping="Wrap" />
          <Rectangle Height="2" Width="120" Fill="{StaticResource GoldBrush}"
                     HorizontalAlignment="Center" Margin="0,8,0,20" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="28" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: one of the two photographs, chosen at random each time
                 the card opens (see the code-behind). Mounted like a print. -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
              <Border Background="#FFFFFF" BorderBrush="{StaticResource GoldBrush}"
                      BorderThickness="1" Padding="6">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" />
                </Border.Effect>
                <Image x:Name="PhotoImage" Width="340" Stretch="Uniform" />
              </Border>
              <TextBlock x:Name="PhotoCaption" Text=""
                         FontFamily="{StaticResource BodyFont}" FontSize="15"
                         FontStyle="Italic" Foreground="#5B5B52"
                         HorizontalAlignment="Center" Margin="0,9,0,0" />
            </StackPanel>

            <!-- RIGHT: what the fund is. -->
            <StackPanel Grid.Column="2" VerticalAlignment="Top">
              <TextBlock Style="{StaticResource BodyText}">
                Lois Engelman and Jeff Jenness have owned and operated Jenness
                Enterprises since 2000, providing GIS tools and analysis for
                clients around the world.
              </TextBlock>
              <TextBlock Style="{StaticResource BodyText}">
                This free ArcGIS Pro add-in was created to honor and celebrate
                her memory by supporting a scholarship created in her name at
                Northern Arizona University.
              </TextBlock>
              <TextBlock Style="{StaticResource BodyText}">
                The scholarship will support the next generation of forestry,
                wildlife and ecology students, who we will all depend on to
                protect our planet and natural resources into the future.
              </TextBlock>
              <TextBlock Style="{StaticResource BodyText}" Margin="0">
                Any funds Jenness Enterprises receives in connection with this
                add-in go to the scholarship.
              </TextBlock>
            </StackPanel>
          </Grid>

          <!-- The dedication: the notice LICENSE-ADDITIONAL-TERMS.md requires
               to be preserved here, with its address. The text is set from
               ScholarshipInfo so it stays the same everywhere. -->
          <Border BorderBrush="{StaticResource GoldBrush}" BorderThickness="0,1,0,0"
                  Margin="0,20,0,0" Padding="0,14,0,0">
            <TextBlock FontFamily="{StaticResource BodyFont}" FontSize="16.5"
                       LineHeight="23" FontStyle="Italic" TextWrapping="Wrap"
                       TextAlignment="Center" Foreground="{StaticResource InkBrush}">
              <Run x:Name="NoticeRun" />
              <Hyperlink x:Name="NoticeLink" RequestNavigate="OnNavigate"
                         Foreground="{StaticResource GreenSoftBrush}"><Run x:Name="NoticeLinkRun" /></Hyperlink>
            </TextBlock>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                      Margin="0,18,0,0">
            <Button Content="About the scholarship" Click="OnAbout"
                    Style="{StaticResource LinkButton}"
                    ToolTip="Open the scholarship page on the Jenness Enterprises web site." />
            <Button Content="Donate through NAU" Click="OnDonate"
                    Style="{StaticResource LinkButton}"
                    ToolTip="Open Northern Arizona University's giving page for the scholarship." />
            <Button Content="Close" Click="OnClose"
                    Style="{StaticResource QuietButton}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Border>
</Window>
