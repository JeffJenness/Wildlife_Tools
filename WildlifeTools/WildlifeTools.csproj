   <Import Project="C:\Program Files\ArcGIS\Pro\bin\Esri.ProApp.SDK.Desktop.targets" Condition="Exists('C:\Program Files\ArcGIS\Pro\bin\Esri.ProApp.SDK.Desktop.targets') AND !Exists('Esri.ArcGISPro.Extensions.targets')" />

  <!-- Self-deploy fallback. The Esri SDK targets invoke RegisterAddIn.exe without
       a full path, so deployment fails when the ArcGIS Pro 'bin' folder is not on
       PATH (e.g. building from a plain shell). This calls it by full path after the
       build so the freshly packaged add-in installs to the user AddIns folder.
       ContinueOnError keeps a locked file (Pro running) from failing the build. -->
  <Target Name="DeployAddInFallback" AfterTargets="Build"
          Condition="Exists('C:\Program Files\ArcGIS\Pro\bin\RegisterAddIn.exe') AND Exists('$(TargetDir)$(AssemblyName).esriAddinX')">
    <Exec Command="&quot;C:\Program Files\ArcGIS\Pro\bin\RegisterAddIn.exe&quot; &quot;$(TargetDir)$(AssemblyName).esriAddinX&quot; /s"
          ContinueOnError="true" />
    <Message Importance="high" Text="DeployAddInFallback: registered $(AssemblyName).esriAddinX to the user AddIns folder." />
  </Target>
  <!-- The Thought-for-the-Day quotes have ONE master list, maintained in the SSI
       add-in. Before each build, refresh this project's bundled copy from that
       master so newly added quotes flow into the add-in automatically. The
       Condition keeps builds working on machines without the SSI project. -->
  <PropertyGroup>
    <QuotesMaster>D:\ArcGIS_stuff\consultation\Springs_Stewardship_Institute\SSI_ArcGIS_Addin\SSI_ArcGIS_Tools\Metadata\Inspirational_Quotes.json</QuotesMaster>
  </PropertyGroup>
  <Target Name="SyncQuotesFromMaster" BeforeTargets="BeforeBuild"
          Condition="Exists('$(QuotesMaster)')">
    <Copy SourceFiles="$(QuotesMaster)"
          DestinationFiles="$(MSBuildProjectDirectory)\Metadata\Inspirational_Quotes.json"
          SkipUnchangedFiles="true" />
    <Message Importance="high"
             Text="SyncQuotesFromMaster: bundled quotes refreshed from the SSI master list." />
  </Target>
