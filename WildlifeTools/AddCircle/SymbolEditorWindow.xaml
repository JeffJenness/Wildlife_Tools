<controls:ProWindow x:Class="WildlifeTools.SymbolEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        Title="Format Polygon Symbol"
        WindowStartupLocation="CenterOwner"
        Width="420" Height="640" MinWidth="360" MinHeight="420">
  <Grid Margin="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Esri's SymbolEditingControl is inserted here in code-behind. -->
    <Border Grid.Row="0" x:Name="EditorHost" />

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="OK" Click="OnOk" Width="80" Margin="0,0,8,0" IsDefault="True" />
      <Button Content="Cancel" Click="OnCancel" Width="80" IsCancel="True" />
    </StackPanel>
  </Grid>
</controls:ProWindow>
