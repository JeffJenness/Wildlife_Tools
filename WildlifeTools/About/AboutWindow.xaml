<Window x:Class="WildlifeTools.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WildlifeTools.About"
        Title="About Wildlife and Forestry Tools"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Height"
        Width="940" MaxHeight="1000" Opacity="0"
        Loaded="OnLoaded">
  <!-- The same card as the Lois Engelman Memorial Scholarship Fund window:
       the colors and lettering of the Jenness Enterprises web site (forest
       green, parchment, a gold rule), draggable, non-modal. -->
  <Window.Resources>
    <FontFamily x:Key="BodyFont">/WildlifeTools;component/Fonts/#EB Garamond, Georgia</FontFamily>
    <SolidColorBrush x:Key="GreenBrush" Color="#24462F" />
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#2E5D43" />
    <SolidColorBrush x:Key="GoldBrush" Color="#C9A227" />
    <SolidColorBrush x:Key="InkBrush" Color="#2A2A26" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="#5B5B52" />
    <SolidColorBrush x:Key="ParchmentBrush" Color="#F6F3EA" />
    <SolidColorBrush x:Key="ParchmentDeepBrush" Color="#EEE9D9" />

    <Style x:Key="BodyText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="LineHeight" Value="22" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="Margin" Value="0,0,0,9" />
    </Style>
    <Style x:Key="SmallText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="LineHeight" Value="21" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="BoxLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <!-- The filled button: the links. -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Foreground" Value="#F6F3EA" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Padding" Value="18,6,18,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource GreenBrush}"
                    BorderBrush="#16301F" BorderThickness="1" CornerRadius="5"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GreenSoftBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16301F" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The quiet button: Close, and the two Copy buttons. -->
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
      <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent"
                    BorderBrush="{StaticResource GreenBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E9E4D3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="12,3,12,4" />
      <Setter Property="Margin" Value="14,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="76" />
    </Style>

    <Style x:Key="CardLink" TargetType="Hyperlink">
      <Setter Property="Foreground" Value="{StaticResource GreenSoftBrush}" />
    </Style>
  </Window.Resources>

  <!-- Outer margin leaves room for the drop shadow so it isn't clipped by the
       transparent window edge. The whole card drags the window. -->
  <Border CornerRadius="14" BorderThickness="3" Margin="18"
          MouseLeftButtonDown="OnDrag">
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E5D43" Offset="0" />
        <GradientStop Color="#24462F" Offset="1" />
      </LinearGradientBrush>
    </Border.BorderBrush>
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="3" Opacity="0.5" />
    </Border.Effect>

    <Border x:Name="CardBorder" CornerRadius="11"
            Background="{StaticResource ParchmentBrush}">
      <Grid>
        <!-- Close button -->
        <Button Content="&#x2715;" Click="OnClose" Cursor="Hand"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="26" Height="26" Margin="6" FontSize="13" Panel.ZIndex="2"
                Foreground="{StaticResource GreenBrush}" Background="Transparent"
                BorderThickness="0" ToolTip="Close" />

        <!-- Focusable="False" matters: a ScrollViewer that can take focus marks
             MouseLeftButtonDown handled when it does, and the drag handler on
             the outer Border would never see the press (the card could not be
             dragged, Jeff 2026-10-13). -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" Padding="0" Margin="0,0,0,0">
        <StackPanel Margin="34,22,34,18">
          <!-- Title block: the logo at the left, the name at the right. -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="22" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="LogoImage" Grid.Column="0" Width="150" Stretch="Uniform"
                   VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Text="Wildlife and Forestry Tools"
                         FontFamily="{StaticResource BodyFont}" FontSize="30"
                         FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}"
                         TextWrapping="Wrap" />
              <TextBlock Text="for ArcGIS Pro, by Jenness Enterprises"
                         FontFamily="{StaticResource BodyFont}" FontSize="19"
                         Foreground="{StaticResource GreenSoftBrush}" Margin="0,2,0,0" />
              <Rectangle Height="2" Width="120" Fill="{StaticResource GoldBrush}"
                         HorizontalAlignment="Left" Margin="0,9,0,0" />
            </StackPanel>
          </Grid>

          <!-- Version, build date, and whether a newer version exists. -->
          <Border Background="{StaticResource ParchmentDeepBrush}" CornerRadius="6"
                  Padding="14,9,14,10" Margin="0,16,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="VersionText" Style="{StaticResource SmallText}"
                           FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SmallText}" Foreground="{StaticResource InkSoftBrush}">
                  <Run x:Name="UpdateRun" />
                  <Hyperlink x:Name="UpdateLink" Style="{StaticResource CardLink}"
                             RequestNavigate="OnNavigate"><Run x:Name="UpdateLinkRun" /></Hyperlink>
                </TextBlock>
              </StackPanel>
              <Button x:Name="CopyVersionButton" Grid.Column="1" Content="Copy"
                      Style="{StaticResource CopyButton}" Click="OnCopyVersion"
                      ToolTip="Copy the version line to the clipboard, for a bug report or a methods section." />
            </Grid>
          </Border>

          <!-- The three paragraphs. -->
          <TextBlock Style="{StaticResource BodyText}" Text="{x:Static local:AboutInfo.Para1}" />
          <TextBlock Style="{StaticResource BodyText}">
            <Run FontWeight="SemiBold" Text="{x:Static local:AboutInfo.Para2Lead}" /><Run Text=" " /><Run Text="{x:Static local:AboutInfo.Para2Body}" />
          </TextBlock>
          <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4">
            <Run FontWeight="SemiBold" Text="{x:Static local:AboutInfo.Para3Lead}" /><Run Text=" " /><Run Text="{x:Static local:AboutInfo.Para3Body}" />
          </TextBlock>

          <!-- The citation, with its Copy button. -->
          <Border Background="{StaticResource ParchmentDeepBrush}" CornerRadius="6"
                  Padding="14,9,14,10" Margin="0,10,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource BoxLabel}" Text="Recommended citation" />
                <TextBlock x:Name="CitationText" Style="{StaticResource SmallText}" />
              </StackPanel>
              <Button x:Name="CopyCitationButton" Grid.Column="1" Content="Copy"
                      Style="{StaticResource CopyButton}" Click="OnCopyCitation"
                      ToolTip="Copy the citation to the clipboard." />
            </Grid>
          </Border>

          <!-- License, source, references, contact. -->
          <TextBlock Style="{StaticResource SmallText}" Foreground="{StaticResource InkSoftBrush}">
            <Run Text="{x:Static local:AboutInfo.LicenseLine}" />
            <Run Text="Source code:" />
            <Hyperlink Style="{StaticResource CardLink}" RequestNavigate="OnNavigate"
                       NavigateUri="https://github.com/JeffJenness/Wildlife_Tools">github.com/JeffJenness/Wildlife_Tools</Hyperlink><Run Text="." />
            <Run Text="The literature behind the tools:" />
            <Hyperlink Style="{StaticResource CardLink}" Click="OnSourcesCited">Sources Cited</Hyperlink><Run Text="." />
            <Run Text="Questions and bug reports:" />
            <Hyperlink Style="{StaticResource CardLink}" RequestNavigate="OnNavigate"
                       NavigateUri="mailto:jeffj@jennessent.com">jeffj@jennessent.com</Hyperlink><Run Text="." />
          </TextBlock>

          <!-- The dedication: the same notice the Scholarship card carries,
               set from ScholarshipInfo so it stays the same everywhere. -->
          <Border BorderBrush="{StaticResource GoldBrush}" BorderThickness="0,1,0,0"
                  Margin="0,14,0,0" Padding="0,12,0,0">
            <TextBlock FontFamily="{StaticResource BodyFont}" FontSize="15.5"
                       LineHeight="22" FontStyle="Italic" TextWrapping="Wrap"
                       TextAlignment="Center" Foreground="{StaticResource InkBrush}">
              <Run x:Name="NoticeRun" />
              <Hyperlink x:Name="NoticeLink" RequestNavigate="OnNavigate"
                         Style="{StaticResource CardLink}"><Run x:Name="NoticeLinkRun" /></Hyperlink>
            </TextBlock>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                      Margin="0,16,0,0">
            <Button Content="Tool Reference" Click="OnToolReference"
                    Style="{StaticResource LinkButton}"
                    ToolTip="Open the Tool Reference on the Jenness Enterprises web site: every tool, its help page and the download." />
            <Button Content="About the scholarship" Click="OnScholarship"
                    Style="{StaticResource LinkButton}"
                    ToolTip="Open the scholarship page on the Jenness Enterprises web site." />
            <Button Content="Donate through NAU" Click="OnDonate"
                    Style="{StaticResource LinkButton}"
                    ToolTip="Open Northern Arizona University's giving page for the scholarship." />
            <Button Content="Close" Click="OnClose"
                    Style="{StaticResource QuietButton}" />
          </StackPanel>
        </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Border>
</Window>
