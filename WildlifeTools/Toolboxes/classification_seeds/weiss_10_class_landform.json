{
  "schemaVersion": 1,
  "name": "Weiss 10-Class Landform",
  "family": "landform",
  "builtin": true,
  "slopeUnits": "Degrees",
  "description": "Landform classification from a small- and a large-neighborhood TPI (standardized) plus slope, after Weiss (2001).",
  "source": "Weiss, A. 2001. Topographic Position and Landforms Analysis. ESRI International User Conference poster.",
  "inputs": [
    {
      "role": "tpi_small",
      "kind": "tpi",
      "label": "Small-neighborhood TPI"
    },
    {
      "role": "tpi_large",
      "kind": "tpi",
      "label": "Large-neighborhood TPI"
    },
    {
      "role": "slope",
      "kind": "slope",
      "label": "Slope (degrees)",
      "optional": true
    }
  ],
  "classes": [
    {
      "value": 1,
      "name": "Canyons, Deeply Incised Streams",
      "color": [
        44,
        66,
        110
      ],
      "criteria": [
        {
          "input": "tpi_small",
          "units": "sd",
          "conditions": [
            {
              "op": "<=",
              "value": -1
            }
          ]
        },
        {
          "input": "tpi_large",
          "units": "sd",
          "conditions": [
            {
              "op": "<=",
              "value": -1
            }
          ]
        }
      ]
    },
