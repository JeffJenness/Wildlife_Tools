<controls:ProWindow x:Class="WildlifeTools.PolarPlots.PolarStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        Title="Circular Descriptive Statistics"
        WindowStartupLocation="CenterOwner"
        Width="640" Height="620" MinWidth="440" MinHeight="360"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Copy to clipboard" Padding="10,4" Margin="4,0"
              Click="OnCopy"
              ToolTip="Copy the full report as plain text to the Windows clipboard" />
      <Button Content="Close" Padding="10,4" Margin="4,0" Click="OnCloseClick" />
    </StackPanel>
    <RichTextBox x:Name="rtb" IsReadOnly="True" IsDocumentEnabled="True"
                 VerticalScrollBarVisibility="Auto"
                 BorderBrush="#33000000" BorderThickness="1" Padding="10" />
  </DockPanel>
</controls:ProWindow>
