<controls:ProWindow x:Class="WildlifeTools.PolarPlots.PolarPlotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        xmlns:mapctl="clr-namespace:ArcGIS.Desktop.Mapping.Controls;assembly=ArcGIS.Desktop.Mapping"
        Title="Polar Plots" WindowStartupLocation="CenterOwner"
        Width="980" Height="740" MinWidth="780" MinHeight="560"
        ShowInTaskbar="False">
  <controls:ProWindow.Resources>
    <Style TargetType="Expander">
      <Setter Property="Margin" Value="0,2,0,2" />
      <Setter Property="IsExpanded" Value="False" />
    </Style>
    <Style TargetType="Label"><Setter Property="Padding" Value="0,2,4,2" /></Style>
    <!-- Wrap every tooltip at a readable width instead of one screen-wide line. -->
    <Style TargetType="ToolTip">
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="400" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:ProWindow.Resources>

  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="370" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===== settings ===== -->
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <Border BorderBrush="#33000000" BorderThickness="0,0,0,1" Padding="0,0,0,4" Margin="0,0,0,4">
          <StackPanel Orientation="Horizontal">
            <Label Content="Style presets:" VerticalAlignment="Center" />
            <Button Content="Load..." Padding="10,2" Margin="4,0" Click="OnLoadStyle"
                ToolTip="Load a saved plot style (plot type, colors, fonts, reference lines, labels and title options) from a JSON preset file. Presets live in your user profile but can be loaded from anywhere." />
            <Button Content="Save..." Padding="10,2" Margin="4,0" Click="OnSaveStyle"
                ToolTip="Save the current plot style (everything about appearance; nothing about the data source) to a named JSON preset file in your user profile, for reuse on any dataset." />
          </StackPanel>
        </Border>

        <Expander Header="Data source" IsExpanded="True">
          <StackPanel Margin="6,4,0,4">
            <Label Content="Dataset" />
            <ComboBox x:Name="cboSource" SelectionChanged="SourceSelChanged"
                ToolTip="The feature class or table holding your directional data. All feature layers and standalone tables in the active map are listed." />
            <Label Content="Azimuth source" Margin="0,6,0,0" />
            <RadioButton x:Name="rbAzPolyline" Content="Derive from polyline direction"
                GroupName="Az" Checked="RereadRouted"
                ToolTip="Each polyline's azimuth is the bearing from its first vertex to its last vertex. On latitude/longitude data this is the geodesic (great-circle) starting azimuth." />
            <RadioButton x:Name="rbAzField" Content="From attribute field" GroupName="Az"
                IsChecked="True" Checked="RereadRouted"
                ToolTip="Read the azimuth (compass degrees, 0 = north, clockwise) from a numeric attribute field." />
            <ComboBox x:Name="cboAzField" Margin="16,2,0,0" SelectionChanged="RereadSel"
                ToolTip="The numeric field holding azimuths in compass degrees (0-360)." />
            <Label Content="Weight" Margin="0,6,0,0" />
            <RadioButton x:Name="rbWNone" Content="Do not weight" GroupName="W"
                IsChecked="True" Checked="RereadRouted"
                ToolTip="Every record counts equally (weight 1)." />
            <RadioButton x:Name="rbWLength" Content="By polyline length" GroupName="W"
                Checked="RereadRouted"
                ToolTip="Weight each polyline's azimuth by the polyline's length, so long lines count more than short ones." />
            <RadioButton x:Name="rbWField" Content="By attribute field" GroupName="W"
                Checked="RereadRouted"
                ToolTip="Weight each record by a numeric attribute value (for example, a Count field from a raster attribute table)." />
            <ComboBox x:Name="cboWField" Margin="16,2,0,0" SelectionChanged="RereadSel"
                ToolTip="The numeric field supplying each record's weight." />
            <CheckBox x:Name="chkSelected" Content="Use selected records only"
                Margin="0,6,0,0" Checked="RereadRouted" Unchecked="RereadRouted"
                ToolTip="Analyze only the currently selected records; if nothing is selected, all records are used." />
            <CheckBox x:Name="chkReverse" Content="Add reverse azimuths"
                Margin="0,2,0,0" Checked="RereadRouted" Unchecked="RereadRouted"
                ToolTip="Also plot each azimuth's opposite direction (azimuth + 180). Use for phenomena that run both ways, such as geologic fracture lines; the plot becomes symmetric." />
            <CheckBox x:Name="chkExcludeNeg" Content="Exclude negative values" IsChecked="True"
                Margin="0,2,0,0" Checked="RereadRouted" Unchecked="RereadRouted"
                ToolTip="Skip records with negative azimuths. Aspect rasters commonly use -1 to mean a flat cell with no direction." />
            <CheckBox x:Name="chkExcludeNeg1" Content="  (exclude only -1, e.g. flat aspect)"
                Margin="16,0,0,0" Checked="RereadRouted" Unchecked="RereadRouted"
                ToolTip="Only skip values of exactly -1 (the aspect 'flat' code); other negative values are treated as valid azimuths measured counter-clockwise." />
          </StackPanel>
        </Expander>

        <Expander Header="Plot style" IsExpanded="True">
          <StackPanel Margin="6,4,0,4">
            <Label Content="Plot type" />
            <ComboBox x:Name="cboPlotType" SelectionChanged="StyleSel"
                ToolTip="Peaks and Valleys: a filled silhouette whose radius follows the bin values. Circular Bins (Rose): wedge-shaped bars, one per bin. Shade by Density: full-radius wedges shaded from the low-density to high-density color. External Peaks and Valleys / External Bins: the same, riding outward from an inner circle (azimuth labels inside it). Bearings: one line per observation (weighted lines vary in length); best for fewer than a few hundred values. Wind Rose: rose petals subdivided into stacked colored bands by a second numeric field (classically wind speed), with a legend. Smoothed Density: a smooth continuous silhouette fit with a von Mises kernel -- no arbitrary bin edges; best for large samples. Dot Plot: one dot per observation stacked inward from the circle; best for small samples." />
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <Label Content="Number of bins" />
                <TextBox x:Name="txtBins" Text="72" TextChanged="StyleText"
                    ToolTip="Bins around the circle: 72 bins = 5 degrees each; 180 bins = 2 degrees each." />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <Label x:Name="lblDiameter" Content="Plot diameter (in)" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="txtDiameter" Text="4.0" TextChanged="StyleText"
                      ToolTip="Diameter of the data circle (labels and titles sit outside it). For the External plot types this is the OUTER diameter. The preview rulers use the same units." />
                  <ComboBox x:Name="cboUnit" Grid.Column="1" Margin="4,0,0,0" SelectedIndex="0"
                      SelectionChanged="UnitChanged"
                      ToolTip="Units for the plot diameters and the preview rulers: inches or centimeters. Switching converts the values already in the boxes.">
                    <ComboBoxItem Content="in"/>
                    <ComboBoxItem Content="cm"/>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Grid>
            <StackPanel x:Name="pnlInner" Visibility="Collapsed">
              <Label x:Name="lblInner" Content="Inside circle diameter (in)" />
              <TextBox x:Name="txtInner" Text="1.5" TextChanged="StyleText"
                  ToolTip="External plot types only: the diameter of the inner circle the bins ride outward from. Azimuth labels are drawn inside this circle." />
            </StackPanel>
            <StackPanel x:Name="pnlWind" Visibility="Collapsed">
              <Label Content="Band by field (e.g. wind speed)" />
              <ComboBox x:Name="cboWindField" SelectionChanged="RereadSel"
                  ToolTip="Wind Rose only: the numeric field whose values subdivide each petal into stacked, colored bands (classically wind speed; any magnitude works). Bands are equal-interval classes between the field's minimum and maximum, drawn lowest class innermost, with a legend below the plot." />
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <Label Content="Bands:" />
                <TextBox x:Name="txtWindClasses" Text="4" Width="40" TextChanged="StyleText"
                    ToolTip="How many equal-interval magnitude classes (1-9)." />
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="pnlSmooth" Visibility="Collapsed">
              <Label Content="Smoothing (degrees)" />
              <TextBox x:Name="txtSmooth" Text="20" TextChanged="StyleText"
                  ToolTip="Standard deviation of the von Mises smoothing kernel, in degrees (Fisher 1993). Smaller = closer to the raw data (spikier); larger = smoother. The Number of bins box is ignored for this plot type -- the curve is computed on a fine fixed grid." />
            </StackPanel>
            <StackPanel x:Name="pnlDot" Visibility="Collapsed">
              <Label x:Name="lblDot" Content="Dot diameter (in)" />
              <TextBox x:Name="txtDot" Text="0.08" TextChanged="StyleText"
                  ToolTip="One dot per observation (weights are ignored), stacked inward from the plotting circle (Fisher 1993; Batschelet 1981). The angular column width follows the dot size -- one dot fits across a column at the circle -- so smaller dots mean finer grouping. Best for small-to-moderate samples; use Smoothed Density for large ones. The Number of bins box is ignored for this plot type." />
            </StackPanel>
            <CheckBox x:Name="chkSqrt" Content="Equal-area (square-root) scaling"
                Margin="0,6,0,0" Checked="StyleRouted" Unchecked="StyleRouted"
                ToolTip="Scale petal radius by the square root of the bin value so petal AREA, not radius, is proportional to frequency (Sanderson &amp; Peacock 2019). Radius-proportional petals visually exaggerate common directions because area grows as the square of radius. Applies to the Peaks/Rose/External/Wind Rose/Smoothed Density plots; the inner ring value labels account for the scaling." />
          </StackPanel>
        </Expander>

        <Expander Header="Symbology">
          <StackPanel Margin="6,4,0,4">
            <!-- Fill row: every plot type EXCEPT Shade by Density -->
            <Grid x:Name="pnlBinFill">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Label Grid.Column="0" Content="Bin fill" />
              <mapctl:ColorPickerControl x:Name="cpBinFill" Grid.Column="1" Height="22"
                  Loaded="PickerLoaded" IsNoColorVisible="True" SelectedColorChanged="StyleColor"
                  ToolTip="Fill color of the bins / silhouette (choose No Color for outline-only bins)." />
            </Grid>
            <!-- Density ramp rows: Shade by Density ONLY -->
            <Grid x:Name="pnlDensity" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Label Grid.Row="0" Grid.Column="0" Content="Low density" />
              <mapctl:ColorPickerControl x:Name="cpLow" Grid.Row="0" Grid.Column="1" Height="22"
                  Loaded="PickerLoaded" IsNoColorVisible="False" SelectedColorChanged="StyleColor"
                  ToolTip="The color of the least-filled bin; intermediate bins ramp toward the high-density color." />
              <Label Grid.Row="1" Grid.Column="0" Content="High density" />
              <mapctl:ColorPickerControl x:Name="cpHigh" Grid.Row="1" Grid.Column="1" Height="22"
                  Loaded="PickerLoaded" IsNoColorVisible="False" SelectedColorChanged="StyleColor"
                  ToolTip="The color of the most-filled bin." />
            </Grid>
            <!-- Wind-rose band ramp rows: Wind Rose ONLY -->
            <Grid x:Name="pnlWindColors" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Label Grid.Row="0" Grid.Column="0" Content="Lowest band" />
              <mapctl:ColorPickerControl x:Name="cpWindLow" Grid.Row="0" Grid.Column="1" Height="22"
                  Loaded="PickerLoaded" IsNoColorVisible="False" SelectedColorChanged="StyleColor"
                  ToolTip="Fill color of the LOWEST magnitude band (innermost segment of each petal); intermediate bands ramp toward the highest-band color." />
              <Label Grid.Row="1" Grid.Column="0" Content="Highest band" />
              <mapctl:ColorPickerControl x:Name="cpWindHigh" Grid.Row="1" Grid.Column="1" Height="22"
                  Loaded="PickerLoaded" IsNoColorVisible="False" SelectedColorChanged="StyleColor"
                  ToolTip="Fill color of the HIGHEST magnitude band (outermost segment of each petal)." />
            </Grid>
            <!-- Bearing-line row: Bearings plot type ONLY -->
            <Grid x:Name="pnlBearing" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/>
              </Grid.ColumnDefinitions>
              <Label Grid.Column="0" Content="Bearing lines" />
              <mapctl:ColorPickerControl x:Name="cpBearing" Grid.Column="1" Height="22"
                  Loaded="PickerLoaded" IsNoColorVisible="False" SelectedColorChanged="StyleColor"
                  ToolTip="Color of the bearing lines (one line per observation)." />
              <TextBox x:Name="txtBearingWidth" Grid.Column="2" Text="0.5" Margin="4,0,0,0"
                  TextChanged="StyleText"
                  ToolTip="Bearing line width in points (minimum 0.2)." />
            </Grid>
            <StackPanel x:Name="pnlOutline">
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Bin outline" />
                <mapctl:ColorPickerControl x:Name="cpBinOutline" Grid.Column="1" Height="22"
                    Loaded="PickerLoaded" IsNoColorVisible="True" SelectedColorChanged="StyleColor"
                    ToolTip="Outline color of the bins (choose No Color, or width 0, for no outline)." />
              </Grid>
              <Label Content="Bin outline width (pt)" Margin="0,4,0,0" />
              <TextBox x:Name="txtOutlineWidth" Text="0.5" TextChanged="StyleText"
                  ToolTip="Outline width in points (1 point = 1/72 inch). 0 removes the outline." />
            </StackPanel>
          </StackPanel>
        </Expander>

        <Expander Header="Reference lines and labels">
          <StackPanel Margin="6,4,0,4">
            <CheckBox x:Name="chkPrimaryRef" Content="Primary reference lines (N/E/S/W + outer)"
                IsChecked="True" Checked="StyleRouted" Unchecked="StyleRouted"
                ToolTip="Solid rays at north, east, south and west, plus the outer circle at the maximum bin value." />
            <CheckBox x:Name="chkSecRays" Content="Secondary reference rays"
                IsChecked="True" Checked="StyleRouted" Unchecked="StyleRouted"
                ToolTip="Additional evenly-spaced bearing rays (dashed by default)." />
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
              <Label Content="Bearings:" />
              <TextBox x:Name="txtSecRays" Text="12" Width="48" TextChanged="StyleText"
                  ToolTip="How many bearings around the circle: 12 = every 30 degrees, 18 = every 20 degrees. Minimum 3." />
            </StackPanel>
            <CheckBox x:Name="chkSecCircles" Content="Secondary reference circles" IsChecked="True"
                Checked="StyleRouted" Unchecked="StyleRouted"
                ToolTip="Concentric value rings between zero and the maximum bin value." />
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
              <Label Content="Circles:" />
              <TextBox x:Name="txtSecCircles" Text="4" Width="48" TextChanged="StyleText"
                  ToolTip="How many rings between 0 and the maximum: 1 puts a single ring halfway. Minimum 1." />
            </StackPanel>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <CheckBox x:Name="chkMeanArrow" Content="Mean direction arrow"
                  VerticalAlignment="Center" Checked="StyleRouted" Unchecked="StyleRouted"
                  ToolTip="Draw an arrow from the center along the mean direction; its length is the mean resultant length (r-bar, 0-1) times the plot radius, so a long arrow means concentrated directions and a short one means dispersed directions (Zar 1999; Mardia &amp; Jupp 2000)." />
              <mapctl:ColorPickerControl x:Name="cpMean" Grid.Column="1" Height="22" Margin="6,0,0,0"
                  Loaded="PickerLoaded" IsNoColorVisible="False" SelectedColorChanged="StyleColor"
                  ToolTip="Color of the mean-direction arrow and its confidence arc." />
            </Grid>
            <CheckBox x:Name="chkMeanCI" Content="  with 95% confidence arc"
                Margin="16,2,0,0" Checked="StyleRouted" Unchecked="StyleRouted"
                ToolTip="Arc just outside the plotting circle spanning the 95% confidence interval of the mean direction (von Mises large-sample standard error 1/sqrt(n * r-bar * kappa); Fisher 1993). Omitted when the interval is undefined or wider than 180 degrees." />
            <CheckBox x:Name="chkAzLabels" Content="Show azimuth (degree) labels" IsChecked="True"
                Margin="0,4,0,0" Checked="StyleRouted" Unchecked="StyleRouted"
                ToolTip="Degree labels around the rim at every primary and secondary reference bearing." />
            <CheckBox x:Name="chkAzRotated" Content="  Rotate labels perpendicular to bearing"
                Margin="16,0,0,0" Checked="StyleRouted" Unchecked="StyleRouted"
                ToolTip="Turn each degree label so it flows around the circle (perpendicular to its bearing ray) instead of staying horizontal. Labels on the lower half are flipped so nothing reads upside-down." />
            <CheckBox x:Name="chkInnerLabels" Content="Show inner ring-value labels" IsChecked="True"
                Checked="StyleRouted" Unchecked="StyleRouted"
                ToolTip="Bin-value labels at each secondary ring, drawn just beside the chosen axes with a halo for readability." />
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
              <CheckBox x:Name="chkInnerN" Content="N" IsChecked="True" Margin="0,0,6,0" Checked="StyleRouted" Unchecked="StyleRouted" ToolTip="Label ring values along the north axis." />
              <CheckBox x:Name="chkInnerE" Content="E" Margin="0,0,6,0" Checked="StyleRouted" Unchecked="StyleRouted" ToolTip="Label ring values along the east axis." />
              <CheckBox x:Name="chkInnerS" Content="S" IsChecked="True" Margin="0,0,6,0" Checked="StyleRouted" Unchecked="StyleRouted" ToolTip="Label ring values along the south axis." />
              <CheckBox x:Name="chkInnerW" Content="W" Checked="StyleRouted" Unchecked="StyleRouted" ToolTip="Label ring values along the west axis." />
            </StackPanel>
            <Label Content="Label font" Margin="0,6,0,0" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="48"/>
                <ColumnDefinition Width="76"/><ColumnDefinition Width="56"/>
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="cboLabelFont" Grid.Column="0" SelectionChanged="StyleSel"
                  ToolTip="Font family for the azimuth and ring-value labels." />
              <TextBox x:Name="txtLabelSize" Grid.Column="1" Text="9" Margin="4,0,0,0"
                  TextChanged="StyleText" ToolTip="Label font size in points." />
              <ComboBox x:Name="cboLabelStyle" Grid.Column="2" Margin="4,0,0,0"
                  SelectionChanged="StyleSel"
                  ToolTip="Label font style: Regular, Bold, Italic, or Bold Italic." />
              <mapctl:ColorPickerControl x:Name="cpLabelColor" Grid.Column="3" Height="22" Margin="4,0,0,0"
                  Loaded="PickerLoaded" IsNoColorVisible="False" SelectedColorChanged="StyleColor"
                  ToolTip="Label text color." />
            </Grid>
          </StackPanel>
        </Expander>

        <Expander Header="Titles">
          <StackPanel Margin="6,4,0,4">
            <CheckBox x:Name="chkPrimaryTitle" Content="Primary title"
                Checked="StyleRouted" Unchecked="StyleRouted"
                ToolTip="A main title centered above the plot." />
            <TextBox x:Name="txtPrimaryTitle" Margin="16,2,0,0" TextChanged="StyleText"
                ToolTip="The primary title text." />
            <Label Content="Title font" Margin="0,6,0,0" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="48"/>
                <ColumnDefinition Width="76"/><ColumnDefinition Width="56"/>
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="cboTitleFont" Grid.Column="0" SelectionChanged="StyleSel"
                  ToolTip="Font family for the primary title." />
              <TextBox x:Name="txtTitleSize" Grid.Column="1" Text="16" Margin="4,0,0,0"
                  TextChanged="StyleText" ToolTip="Primary title size in points." />
              <ComboBox x:Name="cboTitleStyle" Grid.Column="2" Margin="4,0,0,0"
                  SelectionChanged="StyleSel"
                  ToolTip="Primary title font style: Regular, Bold, Italic, or Bold Italic." />
              <mapctl:ColorPickerControl x:Name="cpTitleColor" Grid.Column="3" Height="22" Margin="4,0,0,0"
                  Loaded="PickerLoaded" IsNoColorVisible="False" SelectedColorChanged="StyleColor"
                  ToolTip="Primary title color." />
            </Grid>
            <CheckBox x:Name="chkSecTitles" Content="Secondary titles (source, count, weight, max bin)"
                Margin="0,6,0,0" Checked="StyleRouted" Unchecked="StyleRouted"
                ToolTip="Small caption lines under the plot describing the data source, the count analyzed, the weighting, and the maximum bin value." />
            <Label Content="Secondary title font" Margin="0,6,0,0" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="48"/>
                <ColumnDefinition Width="76"/><ColumnDefinition Width="56"/>
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="cboSecFont" Grid.Column="0" SelectionChanged="StyleSel"
                  ToolTip="Font family for the secondary title lines." />
              <TextBox x:Name="txtSecSize" Grid.Column="1" Text="9" Margin="4,0,0,0"
                  TextChanged="StyleText" ToolTip="Secondary title size in points." />
              <ComboBox x:Name="cboSecStyle" Grid.Column="2" Margin="4,0,0,0"
                  SelectionChanged="StyleSel"
                  ToolTip="Secondary title font style: Regular, Bold, Italic, or Bold Italic." />
              <mapctl:ColorPickerControl x:Name="cpSecColor" Grid.Column="3" Height="22" Margin="4,0,0,0"
                  Loaded="PickerLoaded" IsNoColorVisible="False" SelectedColorChanged="StyleColor"
                  ToolTip="Secondary title color." />
            </Grid>
          </StackPanel>
        </Expander>

      </StackPanel>
    </ScrollViewer>

    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" Background="#22000000" />

    <!-- ===== preview + actions ===== -->
    <DockPanel Grid.Column="2" Margin="4,0,0,0">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                  HorizontalAlignment="Right" Margin="0,6,0,0">
        <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="#666" />
        <Button x:Name="btnStats" Content="Calculate statistics" Margin="4,0"
                Padding="10,4" Click="OnCalcStats"
                ToolTip="Open the Circular Descriptive Statistics report (mean direction, dispersion, Rayleigh test, and more) in a resizable window." />
        <Button x:Name="btnSaveSvg" Content="Save as SVG..." Margin="4,0"
                Padding="10,4" Click="OnSaveSvg"
                ToolTip="Save the plot exactly as previewed to a scalable SVG vector file." />
        <Button x:Name="btnAddGraphic" Content="Add to map / layout" Margin="4,0"
                Padding="10,4" Click="OnAddGraphic"
                ToolTip="Place the plot as a grouped graphic: on the active LAYOUT (centered on the page, sized in inches exactly as previewed) or, if a map view is active, into a 'Polar Plots' graphics layer sized to the visible extent. Every piece stays an editable element -- ungroup to adjust individually." />
        <Button x:Name="btnClose" Content="Close" Margin="4,0" Padding="10,4" Click="OnClose" />
      </StackPanel>
      <Border BorderBrush="#33000000" BorderThickness="1" Background="White">
        <Image x:Name="imgPreview" Stretch="Uniform" Margin="8"
               RenderOptions.BitmapScalingMode="HighQuality"
               ToolTip="Live preview. The rulers along the top and left edges are in inches (preview only; they are not exported)." />
      </Border>
    </DockPanel>
  </Grid>
</controls:ProWindow>
