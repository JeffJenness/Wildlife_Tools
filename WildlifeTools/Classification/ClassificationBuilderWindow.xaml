<controls:ProWindow x:Class="WildlifeTools.Classification.ClassificationBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        xmlns:mapctl="clr-namespace:ArcGIS.Desktop.Mapping.Controls;assembly=ArcGIS.Desktop.Mapping"
        xmlns:local="clr-namespace:WildlifeTools.Classification"
        Title="Classification System Builder"
        WindowStartupLocation="CenterOwner"
        Width="880" Height="620" MinWidth="720" MinHeight="480">
  <controls:ProWindow.Resources>
    <local:RgbToBrushConverter x:Key="RgbToBrush" />
  </controls:ProWindow.Resources>
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Left: saved systems -->
    <DockPanel Grid.Column="0">
      <TextBlock DockPanel.Dock="Top" Text="Saved classification systems"
                 FontWeight="Bold" Margin="0,0,0,4" />
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
        <Button x:Name="NewBtn" Content="New" Width="52" Click="OnNew" Margin="0,0,4,0" />
        <Button x:Name="DupBtn" Content="Duplicate" Width="70" Click="OnDuplicate" Margin="0,0,4,0" />
        <Button x:Name="DelBtn" Content="Delete" Width="56" Click="OnDelete" />
      </StackPanel>
      <ListBox x:Name="SystemList" SelectionChanged="OnSystemSelected"
               DisplayMemberPath="Name" />
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center"
                  VerticalAlignment="Stretch" Background="Transparent" />

    <!-- Right: editor -->
    <DockPanel Grid.Column="2" x:Name="Editor">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,0,6,4" />
        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,0,10,4" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Family" VerticalAlignment="Center" Margin="0,0,6,4" />
        <ComboBox  Grid.Row="0" Grid.Column="3" x:Name="FamilyBox" Width="140" Margin="0,0,0,4"
                   SelectionChanged="OnFamilyChanged" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Description" VerticalAlignment="Top" Margin="0,3,6,4" />
        <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="DescBox" Margin="0,0,0,4"
                   AcceptsReturn="True" TextWrapping="Wrap" Height="52"
                   VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                   SpellCheck.IsEnabled="True" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Slope units" VerticalAlignment="Center" Margin="0,0,6,0" />
        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
          <ComboBox x:Name="SlopeUnitsBox" Width="140"
                    ItemsSource="{x:Static local:ClassificationStore.SlopeUnitsBlank}" />
          <TextBlock Text="Assumed by this system's slope thresholds; only used to warn about mismatched slope rasters."
                     Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                  HorizontalAlignment="Right" Margin="0,8,0,0">
        <TextBlock x:Name="RolesHint" VerticalAlignment="Center" Foreground="Gray"
                   Margin="0,0,12,0" />
        <Button x:Name="SaveBtn" Content="Save" Width="80" Click="OnSave" Margin="0,0,6,0"
                IsDefault="True" />
        <Button Content="Close" Width="80" Click="OnClose" IsCancel="True" />
      </StackPanel>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Classes -->
        <DockPanel Grid.Row="0">
          <DockPanel DockPanel.Dock="Top">
            <TextBlock Text="Classes" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Add class" Click="OnAddClass" Margin="0,0,4,0" />
              <Button Content="Remove class" Click="OnRemoveClass" />
            </StackPanel>
          </DockPanel>
          <DataGrid x:Name="ClassGrid" AutoGenerateColumns="False"
                    CanUserAddRows="False" SelectionMode="Single"
                    SelectionChanged="OnClassSelected" HeadersVisibility="Column"
                    RowHeight="26"
                    PreviewTextInput="OnClassGridPreviewTextInput"
                    PreviewKeyDown="OnClassGridPreviewKeyDown"
                    Margin="0,4,0,0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="55" />
              <DataGridTextColumn Header="Class name" Binding="{Binding Name}" Width="*" />
              <!-- Explicit LostFocus triggers: a DataGrid row's binding group
                   claims default-trigger bindings and defers their write-back
                   to ROW commit, so the swatch would not update until the user
                   left the row. LostFocus commits each box as it is exited. -->
              <DataGridTextColumn Header="R"
                  Binding="{Binding R, UpdateSourceTrigger=LostFocus}" Width="38" />
              <DataGridTextColumn Header="G"
                  Binding="{Binding G, UpdateSourceTrigger=LostFocus}" Width="38" />
              <DataGridTextColumn Header="B"
                  Binding="{Binding B, UpdateSourceTrigger=LostFocus}" Width="38" />
              <DataGridTextColumn Header="Opacity %"
                  Binding="{Binding A, UpdateSourceTrigger=LostFocus}" Width="66" />
              <!-- IsReadOnly: the picker is not a text-editable cell, so the
                   grid must never try to put it into edit mode. IsTabStop off
                   on the control: tabbing THROUGH this cell toward the next
                   row gave the picker keyboard focus, and on that transition
                   it nulled its own SelectedColor (blank swatch). Mouse
                   interaction is unaffected. -->
              <DataGridTemplateColumn Header="Color" Width="72" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <!-- Esri's own color picker (ArcGIS.Desktop.Mapping.Controls).
                         Binding mode matters, hard-won: TwoWay with
                         UpdateSourceTrigger=PropertyChanged is the ONLY correct
                         combination here. Plain TwoWay joins the DataGrid row's
                         edit transaction, deferring write-back to ROW commit
                         (stale R/G/B cells; a pending pick could overwrite
                         freshly typed values at commit). OneWay display plus
                         event write-back is destroyed the moment the control
                         sets a local value on a pick (WPF replaces a OneWay
                         binding with the local value), leaving the swatch deaf
                         to typed R/G/B and eventually blank. TwoWay survives
                         local sets; PropertyChanged bypasses the row-commit
                         deferral. The SelectedColorChanged handler stays as a
                         second write path; the VM equality guard makes the
                         double delivery a no-op and breaks feedback loops. -->
                    <mapctl:ColorPickerControl Margin="2" Height="22"
                        IsTabStop="False" KeyboardNavigation.TabNavigation="None"
                        SelectedColor="{Binding CimColor, Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                        SelectedColorChanged="OnClassColorChanged"
                        IsNoColorVisible="False"
                        ToolTip="Click to choose this class's color" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <!-- Criteria for selected class -->
        <DockPanel Grid.Row="2">
          <DockPanel DockPanel.Dock="Top">
            <TextBlock x:Name="CritHeader" Text="Criteria (select a class above)"
                       FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Add criterion" Click="OnAddCriterion" Margin="0,0,4,0" />
              <Button Content="Remove criterion" Click="OnRemoveCriterion" />
            </StackPanel>
          </DockPanel>
          <DataGrid x:Name="CritGrid" AutoGenerateColumns="False"
                    CanUserAddRows="False" SelectionMode="Single"
                    HeadersVisibility="Column" Margin="0,4,0,0"
                    PreviewTextInput="OnCritGridPreviewTextInput"
                    PreviewKeyDown="OnCritGridPreviewKeyDown">
            <DataGrid.Columns>
              <!-- Input and Units are template combos (TwoWay+PropertyChanged,
                   per the DataGrid binding recipe) so choosing an Input
                   immediately refilters the Units choices to that input's
                   kind: TPI = raw/standardized/sd/pctl, Slope =
                   Degrees/Percent, Raster = Cell Values/Standardized. -->
              <DataGridTemplateColumn Header="Input" Width="120" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{x:Static local:ClassificationStore.AllRoles}"
                        SelectedItem="{Binding Input, Mode=TwoWay,
                                       UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Units" Width="150" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding UnitsChoices}"
                        SelectedItem="{Binding UnitsDisplay, Mode=TwoWay,
                                       UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridComboBoxColumn Header="Op" Width="55"
                  SelectedItemBinding="{Binding Op1}"
                  ItemsSource="{x:Static local:ClassificationStore.Operators}" />
              <DataGridTextColumn Header="Value" Binding="{Binding Val1}" Width="70" />
              <DataGridComboBoxColumn Header="And/Or" Width="65"
                  SelectedItemBinding="{Binding Join}"
                  ItemsSource="{x:Static local:ClassificationStore.JoinOptions}" />
              <DataGridComboBoxColumn Header="Op 2" Width="55"
                  SelectedItemBinding="{Binding Op2}"
                  ItemsSource="{x:Static local:ClassificationStore.OperatorsBlank}" />
              <DataGridTextColumn Header="Value 2" Binding="{Binding Val2}" Width="70" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Grid>
    </DockPanel>
  </Grid>
</controls:ProWindow>
