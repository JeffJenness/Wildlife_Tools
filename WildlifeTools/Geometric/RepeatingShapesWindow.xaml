<controls:ProWindow x:Class="WildlifeTools.Geometric.RepeatingShapesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        Title="Repeating Shapes"
        Height="780" Width="620" MinHeight="620" MinWidth="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <controls:ProWindow.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                   MaxWidth="400"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tile" TargetType="RadioButton">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="GroupName" Value="ShapeTile"/>
        </Style>
        <Style x:Key="MeasureLbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="MeasureBox" TargetType="TextBox">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Margin" Value="0,2,6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </controls:ProWindow.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ shape gallery: 2 rows of 4 ============ -->
            <GroupBox Grid.Row="0" Header="Shape and pattern"
                      Padding="4">
                <UniformGrid Columns="4" x:Name="grdTiles"
                             HorizontalAlignment="Center"/>
            </GroupBox>

            <!-- ============ parameters ============ -->
            <ScrollViewer Grid.Row="1" Margin="0,6,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="Area of interest" Padding="6,4">
                        <StackPanel>
                            <RadioButton x:Name="rbLayer"
                                         Content="Layer or feature class (drag one in from the Contents pane):"
                                         IsChecked="True" GroupName="AOI"
                                         Checked="OnAoiMode"
                                         ToolTip="Polygons enclose the area to fill. Line or point features (a river, observation locations) instead keep every shape that touches them."/>
                            <Grid Margin="18,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cboBoundary"
                                          SelectionChanged="OnBoundaryChanged"/>
                                <Button Grid.Column="1" Content="Browse..."
                                        Margin="6,0,0,0" Padding="8,2"
                                        Click="OnBrowseBoundary"/>
                            </Grid>
                            <TextBlock x:Name="txtBoundaryStatus"
                                       Margin="18,0,0,2" Opacity="0.85"/>
                            <RadioButton x:Name="rbViewExtent"
                                         Content="Current map view extent"
                                         GroupName="AOI"
                                         Checked="OnAoiMode"
                                         ToolTip="Use the extent currently visible in the active map view -- the window equivalent of the original tool's 'within display' option."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Size" Padding="6,4" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,4">
                                    <TextBlock Text="Area units:"
                                               Style="{StaticResource MeasureLbl}"/>
                                    <ComboBox x:Name="cboAreaUnits" Width="150"
                                              SelectionChanged="OnAreaUnitsChanged"/>
                                    <TextBlock Text="Length units:"
                                               Style="{StaticResource MeasureLbl}"
                                               Margin="12,0,6,0"/>
                                    <ComboBox x:Name="cboLinUnits" Width="110"
                                              SelectionChanged="OnLinUnitsChanged"/>
                                </StackPanel>
                                <TextBlock Opacity="0.7" Margin="0,0,0,6"
                                           Text="Fill in any one box -- the others compute automatically."/>
                                <Grid x:Name="grdMeasures">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                </Grid>
                            </StackPanel>
                            <Border Grid.Column="1" Margin="10,0,0,0"
                                    VerticalAlignment="Top">
                                <Image x:Name="imgDiagram" Width="106"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Arrangement" Padding="6,4"
                              Margin="0,6,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Orientation (degrees):"
                                           Style="{StaticResource MeasureLbl}"/>
                                <TextBox x:Name="txtOrient" Width="80"
                                         Text="0"/>
                                <Button x:Name="btnRandom"
                                        Content="Randomize" Margin="8,0,0,0"
                                        Padding="8,2" Click="OnRandomize"
                                        ToolTip="Pick a random orientation within the pattern's symmetry period (60 degrees for hexagons and triangles, 90 for squares)."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,6,0,0">
                                <TextBlock Text="Shapes at the area's edge:"
                                           Style="{StaticResource MeasureLbl}"/>
                                <ComboBox x:Name="cboEdgePolicy" Width="330"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ output + run ============ -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Output feature class:"
                           Style="{StaticResource MeasureLbl}"/>
                <TextBox Grid.Column="1" x:Name="txtOutput"/>
                <Button Grid.Column="2" Content="Browse..." Margin="6,0,0,0"
                        Padding="8,2" Click="OnBrowseOutput"/>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="btnRun"
                        Content="Run Repeating Shapes"
                        Padding="12,3" FontWeight="SemiBold"
                        Click="OnRun"/>
                <Button Content="Close" Margin="8,0,0,0"
                        Padding="12,3" Click="OnClose"/>
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtStatus" TextWrapping="Wrap"
                           Opacity="0.85"/>
                <ProgressBar Grid.Column="1" x:Name="prgRun" Width="160"
                             Height="14" IsIndeterminate="True"
                             Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</controls:ProWindow>
