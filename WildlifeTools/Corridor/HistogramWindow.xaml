<controls:ProWindow x:Class="WildlifeTools.Corridor.HistogramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        xmlns:dragDrop="clr-namespace:ArcGIS.Desktop.Framework.DragDrop;assembly=ArcGIS.Desktop.Framework"
        Title="Histograms and Habitat Suitability Statistics"
        Height="740" Width="1120" MinHeight="660" MinWidth="860"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        dragDrop:DragDrop.IsDropTarget="True">
    <controls:ProWindow.Resources>
        <!-- long hover help wraps instead of running one endless line -->
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                   MaxWidth="400"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </controls:ProWindow.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ toolbar ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnAdd" Content="Add Data..." Padding="10,3"
                        Click="OnAddData"
                        ToolTip="Add a raster, feature layer or table field to the histogram. You can also drag a layer from the Contents pane anywhere onto this window."/>
                <Button x:Name="btnSavePreset" Content="Save Datasets..."
                        Margin="8,0,0,0" Padding="10,3" Click="OnSavePreset"
                        IsEnabled="False"
                        ToolTip="Save every dataset (data + colors) to a JSON preset so this comparison can be reloaded instantly."/>
                <Button x:Name="btnLoadPreset" Content="Load Datasets..."
                        Margin="8,0,0,0" Padding="10,3" Click="OnLoadPreset"
                        ToolTip="Append the datasets from a saved preset."/>
                <Border Width="1" Background="#66000000" Margin="12,2,12,2"/>
                <Button x:Name="btnExportTables" Content="Export Tables..."
                        Padding="10,3" Click="OnExportTables" IsEnabled="False"
                        ToolTip="Write the general-statistics and per-bin tables. The format follows your choice of destination: a geodatabase gets native tables, a name ending .csv gets CSV files, .dbf gets dBASE tables."/>
                <Button x:Name="btnSaveGraph" Content="Save Graph..."
                        Margin="8,0,0,0" Padding="10,3" Click="OnSaveGraph"
                        IsEnabled="False"
                        ToolTip="Export the chart as a PNG image (300 dpi) or a scalable SVG vector file for reports and presentations."/>
                <Button x:Name="btnAddToLayout" Content="Add to Layout"
                        Margin="8,0,0,0" Padding="10,3" Click="OnAddToLayout"
                        IsEnabled="False"
                        ToolTip="Place the chart on a layout as native, individually editable graphic elements, plus the statistics report as a text element. If a layout is the active view it is used; otherwise the tool asks which of the project's layouts to use (a project with only one layout uses it without asking)."/>
                <Button x:Name="btnCopyStats" Content="Copy Stats"
                        Margin="8,0,0,0" Padding="10,3" Click="OnCopyStats"
                        IsEnabled="False"
                        ToolTip="Copy the statistics report as plain text."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- online-help icon, GP-pane style -->
                <Button x:Name="btnHelp" Margin="0,0,8,0"
                        VerticalAlignment="Center" Width="20" Height="20"
                        Padding="0" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="OnHelp"
                        ToolTip="Open the online help page for this tool">
                    <Grid>
                        <Ellipse Width="18" Height="18" Fill="#0079C1"/>
                        <TextBlock Text="?" Foreground="White" FontWeight="Bold"
                                   FontSize="12" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Grid>
                </Button>
                <Button Content="Close" Padding="14,3" Click="OnClose"/>
            </StackPanel>
        </Grid>

        <!-- ============ chart + options ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#66000000" BorderThickness="1"
                    Background="White" Padding="4">
                <Grid>
                    <Image x:Name="imgChart" Stretch="Uniform"
                           SizeChanged="OnChartSized"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="txtChartHint"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" Opacity="0.55"
                               FontSize="14" TextAlignment="Center"
                               Text="Click Add Data... (or drag a layer from the Contents pane here)&#10;to build a histogram."/>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <GroupBox Header="Chart" Padding="6,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" Grid.Column="0" x:Name="txtTitle"
                                     Margin="0,0,6,4" TextChanged="OnOptionText"
                                     ToolTip="Histogram title."/>
                            <CheckBox Grid.Row="0" Grid.Column="1" x:Name="chkTitle"
                                      Content="Title" IsChecked="True"
                                      VerticalAlignment="Center"
                                      Checked="OnOption" Unchecked="OnOption"/>
                            <TextBox Grid.Row="1" Grid.Column="0" x:Name="txtXLabel"
                                     Margin="0,0,6,4" TextChanged="OnOptionText"
                                     ToolTip="X-axis label."/>
                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="chkXLabel"
                                      Content="X label" IsChecked="True"
                                      VerticalAlignment="Center"
                                      Checked="OnOption" Unchecked="OnOption"/>
                            <TextBox Grid.Row="2" Grid.Column="0" x:Name="txtYLabel"
                                     Margin="0,0,6,4" TextChanged="OnOptionText"
                                     ToolTip="Y-axis label; leave empty for an automatic label from the current unit."/>
                            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="chkYLabel"
                                      Content="Y label" IsChecked="True"
                                      VerticalAlignment="Center"
                                      Checked="OnOption" Unchecked="OnOption"/>
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Margin="0,2,0,0">
                                <CheckBox x:Name="chkLegend" Content="Legend"
                                          IsChecked="True" Margin="0,0,12,0"
                                          VerticalAlignment="Center"
                                          Checked="OnOption" Unchecked="OnOption"/>
                                <CheckBox x:Name="chkRefLines"
                                          Content="Reference lines" IsChecked="True"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"
                                          Checked="OnOption" Unchecked="OnOption"/>
                                <Button Content="Fonts..." Padding="8,1"
                                        Click="OnFonts"
                                        ToolTip="Choose the font family and the sizes of the title, axis labels and tick labels."/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Bins" Padding="6,4" Margin="0,6,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bins:" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtBins" Width="44" Margin="4,0,10,0"
                                         TextChanged="OnOptionText"
                                         ToolTip="Number of equal-interval bins."/>
                                <TextBlock Text="Min:" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtMin" Width="62" Margin="4,0,10,0"
                                         TextChanged="OnOptionText"
                                         ToolTip="Lower edge of the first bin. Set beyond the data range to give several histograms a shared axis (e.g. 0-100 habitat suitability)."/>
                                <TextBlock Text="Max:" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtMax" Width="62" Margin="4,0,0,0"
                                         TextChanged="OnOptionText"
                                         ToolTip="Upper edge of the last bin."/>
                            </StackPanel>
                            <TextBlock x:Name="lblCategorical" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Opacity="0.8"
                                       Visibility="Collapsed"
                                       Text="Categorical data: one bar per class. Bins, range and density curves do not apply."/>
                            <CheckBox x:Name="chkAutoRange" Margin="0,6,0,0"
                                      Content="Track the data range automatically"
                                      IsChecked="True"
                                      Checked="OnOption" Unchecked="OnOption"
                                      ToolTip="Checked: min and max follow the combined range of the loaded datasets. Uncheck to type fixed limits."/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Gap between bins:"
                                           VerticalAlignment="Center"/>
                                <Slider x:Name="sldGap" Width="110" Minimum="0"
                                        Maximum="80" Value="14" Margin="6,0,4,0"
                                        VerticalAlignment="Center"
                                        ValueChanged="OnSlider"
                                        ToolTip="Share of each bin slot left empty between bin groups (the original's default was 14%)."/>
                                <TextBlock x:Name="lblGap" Text="14%"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Y axis" Padding="6,4" Margin="0,6,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Units:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="cboUnit" Width="170"
                                          Margin="6,0,0,0"
                                          SelectionChanged="OnUnitChanged"
                                          ToolTip="The Y-axis unit. Area units appear when every dataset can express one (rasters with known cell size, polygons). When Cells are the Y-axis unit and the rasters have different cell sizes, the other rasters' counts are converted to equivalent cells of the FIRST dataset in the list, so relative bar heights stay area-true."/>
                            </StackPanel>
                            <StackPanel x:Name="pnlMult" Orientation="Horizontal"
                                        Margin="0,4,0,0" Visibility="Collapsed">
                                <TextBlock Text="Multiplier:"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="txtMult" Width="90" Margin="6,0,0,0"
                                         Text="1" TextChanged="OnOptionText"
                                         ToolTip="Custom Y multiplier applied to the native weights."/>
                            </StackPanel>
                            <CheckBox x:Name="chkPercent" Margin="0,6,0,0"
                                      Content="Show Y values as percentages"
                                      Checked="OnOption" Unchecked="OnOption"
                                      ToolTip="Each dataset's bins sum to 100%, so distributions compare regardless of corridor size. Unchecked, bar heights are amounts (cells, hectares, ...) and a big corridor shows more total habitat."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Density curves" Padding="6,4" Margin="0,6,0,0">
                        <StackPanel>
                            <CheckBox x:Name="chkCurvesOnly"
                                      Content="Curves only (hide the bars)"
                                      Checked="OnOption" Unchecked="OnOption"
                                      ToolTip="Show every dataset as a smooth weighted kernel-density curve -- often the clearest way to compare four or five corridors at once."/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Smoothness:"
                                           VerticalAlignment="Center"/>
                                <Slider x:Name="sldBw" Width="120" Minimum="0.2"
                                        Maximum="3" Value="1" Margin="6,0,4,0"
                                        VerticalAlignment="Center"
                                        ValueChanged="OnSlider"
                                        ToolTip="Kernel bandwidth as a multiple of Silverman's rule of thumb (1.0). Left = more detail, right = smoother. Curves are reflected at the axis limits so no habitat mass smears past the possible range."/>
                                <TextBlock x:Name="lblBw" Text="1.0&#215;"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
                <GroupBox Grid.Row="1" Header="Datasets" Padding="6,4"
                          Margin="0,6,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox Grid.Row="0" x:Name="lstDatasets"
                                 MinHeight="72"
                                 SelectionChanged="OnDatasetSelected"/>
                        <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                            <Button Content="Rename..." Padding="6,2"
                                    Margin="0,0,4,4" Click="OnRename"/>
                            <Button Content="Color..." Padding="6,2"
                                    Margin="0,0,4,4" Click="OnRecolor"
                                    ToolTip="Pick the selected dataset's color. The outline is derived automatically as a darker shade of the fill."/>
                            <Button Content="Bars on/off" Padding="6,2"
                                    Margin="0,0,4,4" Click="OnToggleBars"/>
                            <Button x:Name="btnToggleKde" Content="Curve on/off"
                                    Padding="6,2"
                                    Margin="0,0,4,4" Click="OnToggleKde"
                                    ToolTip="Toggle the weighted kernel-density curve for the selected dataset."/>
                            <Button Content="Up" Padding="6,2" Margin="0,0,4,4"
                                    Click="OnMoveUp"/>
                            <Button Content="Down" Padding="6,2"
                                    Margin="0,0,4,4" Click="OnMoveDown"/>
                            <Button Content="Remove" Padding="6,2"
                                    Margin="0,0,4,4" Click="OnRemove"/>
                        </WrapPanel>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- ============ statistics ============ -->
        <Expander Grid.Row="2" x:Name="expStats" Header="Statistics"
                  Margin="0,8,0,0" MaxHeight="240">
            <Border BorderBrush="#66000000" BorderThickness="1">
                <FlowDocumentScrollViewer x:Name="statsViewer"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"/>
            </Border>
        </Expander>

        <!-- ============ status ============ -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="txtStatus" Opacity="0.75"
                       TextWrapping="Wrap"/>
            <ProgressBar Grid.Column="1" x:Name="prgRead" Width="160" Height="14"
                         Visibility="Collapsed"/>
        </Grid>
    </Grid>
</controls:ProWindow>
