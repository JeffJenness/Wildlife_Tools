<controls:ProWindow x:Class="WildlifeTools.Corridor.BottleneckQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        Title="Selection Expression"
        Height="440" Width="600" MinHeight="300" MinWidth="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="txtPrompt" Margin="0,0,0,8"
                   TextWrapping="Wrap" Opacity="0.85"/>
        <Border Grid.Row="1" BorderBrush="#66000000" BorderThickness="1">
            <Grid>
                <ContentControl x:Name="host"/>
                <TextBox x:Name="txtExpr" Visibility="Collapsed"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Padding="6"
                         FontFamily="Consolas"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Clear" Padding="10,3"
                    Click="OnClear"/>
            <Button Grid.Column="2" Content="OK" Padding="16,3"
                    FontWeight="SemiBold" Margin="0,0,8,0" Click="OnOk"/>
            <Button Grid.Column="3" Content="Cancel" Padding="12,3"
                    Click="OnCancel"/>
        </Grid>
    </Grid>
</controls:ProWindow>
