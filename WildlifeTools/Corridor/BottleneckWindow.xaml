<controls:ProWindow x:Class="WildlifeTools.Corridor.BottleneckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        xmlns:dragDrop="clr-namespace:ArcGIS.Desktop.Framework.DragDrop;assembly=ArcGIS.Desktop.Framework"
        Title="Bottleneck Analysis"
        Height="720" Width="980" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= inputs ================= -->
        <Border Grid.Row="0" BorderBrush="#66000000" BorderThickness="1"
                Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Corridor polygon:"
                           VerticalAlignment="Center" Margin="0,0,8,4"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cboCorridor" dragDrop:DragDrop.IsDropTarget="True"
                          Margin="0,0,8,4" VerticalAlignment="Center"
                          SelectionChanged="OnSourceChanged"
                          ToolTip="Polygon layers in the active map, or Browse to a feature class on disk. Drag a layer from the Contents pane here."/>
                <Button Grid.Row="0" Grid.Column="2" x:Name="btnBrowseC"
                        Content="Browse..." Padding="8,2" Margin="0,0,8,4"
                        Click="OnBrowseC"
                        ToolTip="Choose a polygon feature class from disk."/>
                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="lblStatusC"
                           VerticalAlignment="Center" Margin="0,0,8,4"
                           TextWrapping="Wrap" FontWeight="SemiBold"/>
                <Button Grid.Row="0" Grid.Column="4" x:Name="btnSqlC"
                        Content="SQL..." Padding="8,2" Margin="0,0,0,4"
                        IsEnabled="False" Click="OnSqlC"
                        ToolTip="Build a selection expression for the corridor features."/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Wildland Block A:"
                           VerticalAlignment="Center" Margin="0,0,8,4"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cboLayerA" dragDrop:DragDrop.IsDropTarget="True"
                          Margin="0,0,8,4" VerticalAlignment="Center"
                          SelectionChanged="OnSourceChanged"
                          ToolTip="The layer or feature class holding Wildland Block A (may be the same as Block B)."/>
                <Button Grid.Row="1" Grid.Column="2" x:Name="btnBrowseA"
                        Content="Browse..." Padding="8,2" Margin="0,0,8,4"
                        Click="OnBrowseA"
                        ToolTip="Choose a polygon feature class from disk."/>
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="lblStatusA"
                           VerticalAlignment="Center" Margin="0,0,8,4"
                           TextWrapping="Wrap" FontWeight="SemiBold"/>
                <Button Grid.Row="1" Grid.Column="4" x:Name="btnSqlA"
                        Content="SQL..." Padding="8,2" Margin="0,0,0,4"
                        IsEnabled="False" Click="OnSqlA"
                        ToolTip="Build a selection expression for Block A."/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Wildland Block B:"
                           VerticalAlignment="Center" Margin="0,0,8,4"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cboLayerB" dragDrop:DragDrop.IsDropTarget="True"
                          Margin="0,0,8,4" VerticalAlignment="Center"
                          SelectionChanged="OnSourceChanged"/>
                <Button Grid.Row="2" Grid.Column="2" x:Name="btnBrowseB"
                        Content="Browse..." Padding="8,2" Margin="0,0,8,4"
                        Click="OnBrowseB"
                        ToolTip="Choose a polygon feature class from disk."/>
                <TextBlock Grid.Row="2" Grid.Column="3" x:Name="lblStatusB"
                           VerticalAlignment="Center" Margin="0,0,8,4"
                           TextWrapping="Wrap" FontWeight="SemiBold"/>
                <Button Grid.Row="2" Grid.Column="4" x:Name="btnSqlB"
                        Content="SQL..." Padding="8,2" Margin="0,0,0,4"
                        IsEnabled="False" Click="OnSqlB"
                        ToolTip="Build a selection expression for Block B."/>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                            Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Width threshold:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtThreshold" Width="80" Margin="6,0,2,0"
                             VerticalAlignment="Center" TextChanged="OnThresholdText"
                             ToolTip="Optional: corridor sections narrower than this are flagged. Adjust any time after the run -- type here, click the graph, or drag the dashed line."/>
                    <TextBlock Text="m" VerticalAlignment="Center" Margin="0,0,14,0"
                               Opacity="0.7"/>
                    <Expander Header="Advanced" VerticalAlignment="Center"
                              Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Margin="4,4,0,0">
                            <TextBlock Text="Stations:" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtStations" Width="60" Margin="4,0,12,0"
                                     Text="1000" VerticalAlignment="Center"
                                     ToolTip="Number of width-measurement stations along the route."/>
                            <TextBlock Text="Boundary sampling (m):"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="txtBoundaryStep" Width="60"
                                     Margin="4,0,12,0" VerticalAlignment="Center"
                                     ToolTip="Voronoi boundary sampling spacing; blank = automatic (extent diagonal / 2000)."/>
                            <TextBlock Text="Simplify tol (m):"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="txtSimplify" Width="60" Margin="4,0,0,0"
                                     VerticalAlignment="Center"
                                     ToolTip="Boundary simplification tolerance; blank = automatic, 0 = none."/>
                        </StackPanel>
                    </Expander>
                    <CheckBox x:Name="chkOverlay" Content="Show route on map"
                              IsChecked="True" VerticalAlignment="Center"
                              Margin="0,0,14,0" Checked="OnOverlayToggle"
                              Unchecked="OnOverlayToggle"/>
                    <Button x:Name="btnRun" Content="Run Analysis" Padding="16,4"
                            FontWeight="SemiBold" Click="OnRun"/>
                    <ProgressBar x:Name="prgRun" Width="130" Height="14"
                                 Margin="12,0,0,0" VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5"
                           x:Name="txtRunStatus" Margin="0,4,0,0"
                           Opacity="0.8" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- ================= results ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="292"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#66000000" BorderThickness="1"
                    Background="White">
                <Grid>
                    <Canvas x:Name="cnvGraph" Background="White" ClipToBounds="True"
                            SizeChanged="OnGraphSize"
                            MouseLeftButtonDown="OnGraphMouseDown"
                            MouseMove="OnGraphMouseMove"
                            MouseLeftButtonUp="OnGraphMouseUp"/>
                    <TextBlock x:Name="txtGraphHint"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" Opacity="0.5" FontSize="13"
                               Text="Run the analysis to graph corridor width along the widest route.&#10;&#10;Then set the width threshold by typing, clicking the graph,&#10;or dragging the dashed threshold line."/>
                </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="#66000000" BorderThickness="1"
                    Margin="8,0,0,0">
                <FlowDocumentScrollViewer x:Name="statsViewer"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"/>
            </Border>
        </Grid>

        <!-- ================= footer ================= -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- status on its own full-width row: long saved-to paths were
                 being cut off behind the Close button -->
            <TextBlock Grid.Row="0" x:Name="txtStatus" Margin="2,0,2,6"
                       Opacity="0.75" TextWrapping="Wrap"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="btnSaveRoute"
                        Content="Save Route..." Padding="10,3"
                        IsEnabled="False" Click="OnSaveRoute"/>
                <Button Grid.Column="1" x:Name="btnSavePoints"
                        Content="Save Points..." Margin="8,0,0,0"
                        Padding="10,3" IsEnabled="False"
                        Click="OnSavePoints"/>
                <Button Grid.Column="2" x:Name="btnSaveSegments"
                        Content="Save Segments..." Margin="8,0,0,0"
                        Padding="10,3" IsEnabled="False"
                        Click="OnSaveSegments"/>
                <Button Grid.Column="3" x:Name="btnSaveGraph"
                        Content="Save Graph..." Margin="8,0,0,0"
                        Padding="10,3" IsEnabled="False"
                        Click="OnSaveGraph"/>
                <Button Grid.Column="4" x:Name="btnCopyStats"
                        Content="Copy Stats" Margin="8,0,0,0" Padding="10,3"
                        IsEnabled="False" Click="OnCopyStats"/>
                <Button Grid.Column="6" Content="Close" Padding="14,3"
                        Click="OnClose"/>
            </Grid>
        </Grid>
    </Grid>
</controls:ProWindow>
