<controls:ProWindow x:Class="WildlifeTools.Corridor.LandFacetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        Title="Land Facet Clustering" WindowStartupLocation="CenterOwner"
        Width="760" Height="620" MinWidth="560" MinHeight="440"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
  <controls:ProWindow.Resources>
    <Style x:Key="StepLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,18,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#7A7A7A" />
    </Style>
    <Style x:Key="StepLabelActive" TargetType="TextBlock" BasedOn="{StaticResource StepLabel}">
      <Setter Property="Foreground" Value="#1B3A5B" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="H" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,3" />
    </Style>
  </controls:ProWindow.Resources>

  <DockPanel Margin="12">
    <!-- Step indicator -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock x:Name="step1lbl" Text="1  Setup" Style="{StaticResource StepLabelActive}" />
      <TextBlock x:Name="step2lbl" Text="2  Outliers" Style="{StaticResource StepLabel}" />
      <TextBlock x:Name="step3lbl" Text="3  Clusters" Style="{StaticResource StepLabel}" />
      <TextBlock x:Name="step4lbl" Text="4  Facets" Style="{StaticResource StepLabel}" />
    </StackPanel>

    <!-- Navigation -->
    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="txtStatus" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"
                 Margin="0,0,10,0" TextWrapping="Wrap" MaxHeight="48" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="btnBack" Content="&#x25C0; Back" Width="90" Margin="4,0"
                Click="OnBack" IsEnabled="False" />
        <Button x:Name="btnNext" Content="Next &#x25B6;" Width="90" Margin="4,0"
                Click="OnNext" />
        <Button x:Name="btnClose" Content="Close" Width="90" Margin="12,0,0,0"
                Click="OnClose" />
      </StackPanel>
    </Grid>

    <!-- Step panels (only one visible at a time) -->
    <Grid>
      <!-- STEP 1: SETUP -->
      <Grid x:Name="panelSetup">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Categorical (template) raster" Style="{StaticResource H}" />
          <ComboBox x:Name="cboCat" DisplayMemberPath="Name"
                    SelectionChanged="OnCatChanged" />
          <TextBlock Text="Defines the analysis grid, extent and projection; a "
                     TextWrapping="Wrap" Foreground="#777" FontSize="11" Margin="0,2,0,0" />
          <TextBlock Text="separate set of land facets is built within each category."
                     TextWrapping="Wrap" Foreground="#777" FontSize="11" />

          <TextBlock Text="Clip to polygon (optional)" Style="{StaticResource H}" />
          <ComboBox x:Name="cboClip" DisplayMemberPath="Name"
                    SelectionChanged="OnClipChanged" />
          <TextBlock Text="Restrict the analysis to a Wildland-Blocks polygon layer."
                     TextWrapping="Wrap" Foreground="#777" FontSize="11" Margin="0,2,0,0" />

          <Button x:Name="btnRead" Content="Read inputs" Width="120"
                  HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnReadInputs" />
        </StackPanel>

        <StackPanel Grid.Column="2">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Variable rasters" Style="{StaticResource H}" />
            <TextBlock Text="(use [CONTROL] or [SHIFT] to select multiple)"
                       VerticalAlignment="Center" Foreground="#777" FontSize="11"
                       Margin="6,10,0,3" />
          </StackPanel>
          <ListBox x:Name="lstVars" Height="150" SelectionMode="Extended"
                   DisplayMemberPath="Name" SelectionChanged="OnVarsChanged" />
          <TextBlock Text="The continuous variables to cluster (elevation, slope, insolation, ...)."
                     TextWrapping="Wrap" Foreground="#777" FontSize="11" Margin="0,2,0,0" />

          <TextBlock Text="Classes found" Style="{StaticResource H}" />
          <ListView x:Name="lstClasses" Height="150"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.View>
              <GridView x:Name="gvClasses">
                <GridViewColumn Header="Value" Width="70"
                                DisplayMemberBinding="{Binding Category}" />
                <GridViewColumn Header="Cells" Width="90"
                                DisplayMemberBinding="{Binding Cells}" />
              </GridView>
            </ListView.View>
          </ListView>
        </StackPanel>
      </Grid>

      <!-- STEP 2: OUTLIERS -->
      <Grid x:Name="panelOutliers" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox x:Name="cboCategory" Width="150" DisplayMemberPath="Label"
                    SelectionChanged="OnCategoryChanged" />
          <Button x:Name="btnDetect" Content="Detect outliers" Margin="12,0,0,0"
                  Padding="8,2" Click="OnDetectOutliers" />
          <TextBlock x:Name="txtOutlierInfo" VerticalAlignment="Center"
                     Margin="16,0,0,0" Foreground="#555" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" Background="White">
          <Canvas x:Name="scatterCanvas" ClipToBounds="True"
                  SizeChanged="OnScatterSizeChanged" />
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Text="Outlier fraction:" VerticalAlignment="Center" />
          <Slider x:Name="sldFraction" Width="260" Minimum="0" Maximum="0.30" Value="0.10"
                  Margin="8,0" VerticalAlignment="Center" ValueChanged="OnFractionChanged" />
          <TextBox x:Name="txtFractionEdit" Width="52" VerticalAlignment="Center"
                   Text="10.0" TextAlignment="Right"
                   ToolTip="Type an exact percentage (0-30) and press Enter, or drag the slider."
                   KeyDown="OnFractionKeyDown" LostFocus="OnFractionCommit" />
          <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,0,0" />
        </StackPanel>
      </Grid>

      <!-- STEP 3: CLUSTERS -->
      <Grid x:Name="panelClusters" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="Fuzziness (&#x3C8;):" VerticalAlignment="Center" Margin="0,0,4,0" />
          <TextBox x:Name="txtPsi" Width="46" Text="1.5" VerticalAlignment="Center" />
          <TextBlock Text="Restarts:" VerticalAlignment="Center" Margin="14,0,4,0" />
          <TextBox x:Name="txtRestarts" Width="40" Text="12" VerticalAlignment="Center" />
          <Button x:Name="btnCluster" Content="Run clustering" Margin="14,0,0,0"
                  Padding="8,2" Click="OnRunClustering" />
          <TextBlock x:Name="txtClusterInfo" VerticalAlignment="Center"
                     Margin="16,0,0,0" Foreground="#555" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" Background="White">
          <Canvas x:Name="clusterCanvas" ClipToBounds="True"
                  SizeChanged="OnClusterSizeChanged" />
        </Border>
        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
          <TextBlock Text="Number of clusters (k):" VerticalAlignment="Center" Margin="0,0,6,0"
                     DockPanel.Dock="Left" />
          <ComboBox x:Name="cboK" Width="60" SelectionChanged="OnKChanged" DockPanel.Dock="Left" />
          <TextBlock x:Name="txtSuggestK" VerticalAlignment="Center" Margin="12,0,0,0"
                     Foreground="#555" DockPanel.Dock="Left" />
          <Button x:Name="btnClusterHelp" Content="How to read these charts…" DockPanel.Dock="Right"
                  Padding="8,2" Click="OnClusterHelp" />
        </DockPanel>
      </Grid>

      <!-- STEP 4: FACETS -->
      <Grid x:Name="panelFacets" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
          <TextBlock Text="Confusion-index threshold:" VerticalAlignment="Center" Margin="0,0,4,0"
                     DockPanel.Dock="Left" />
          <TextBox x:Name="txtConf" Width="46" Text="0.6" VerticalAlignment="Center"
                   DockPanel.Dock="Left" />
          <Button x:Name="btnFacetHelp" Content="Help…" DockPanel.Dock="Right"
                  Padding="8,2" Click="OnFacetHelp" />
          <TextBlock Text="  (cells above this — too ambiguous — are left NoData; outliers too)"
                     VerticalAlignment="Center" Foreground="#777" FontSize="11" DockPanel.Dock="Left" />
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="Output raster:" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox x:Name="txtOut" Width="380" VerticalAlignment="Center" />
          <Button x:Name="btnBrowse" Content="Browse..." Margin="6,0,0,0" Padding="8,2"
                  Click="OnBrowseOut" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
          <Button x:Name="btnGenerate" Content="Generate land facets" Padding="10,3"
                  Click="OnGenerate" />
          <ProgressBar x:Name="pbGen" Width="220" Height="16" Margin="12,0"
                       Minimum="0" Maximum="1" VerticalAlignment="Center" />
          <TextBlock x:Name="txtGenInfo" VerticalAlignment="Center" Foreground="#555" />
        </StackPanel>
        <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="1" Background="#FAFAFA"
                Padding="10">
          <TextBlock x:Name="txtFacetSummary" TextWrapping="Wrap" Foreground="#444"
                     Text="Set the confusion threshold and output path, then Generate. The land facets for the selected category will be written to the output raster (other cells NoData) and added to the map." />
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</controls:ProWindow>
