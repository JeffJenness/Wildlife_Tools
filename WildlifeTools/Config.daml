<?xml version="1.0" encoding="utf-8" ?>
<ArcGIS defaultAssembly="WildlifeTools.dll"
        defaultNamespace="WildlifeTools"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">

  <AddInInfo id="{9b04581c-dbfe-4025-8713-1cd30b3b1e47}" version="1.48.0" desktopVersion="3.7.1901" product="ArcGISPro">
    <Name>WildlifeTools</Name>
    <Description>Wildlife analysis tools for ArcGIS Pro, ported from the legacy ArcMap VB6 tools.</Description>
    <Image>Images\JennessLogo32.png</Image>
    <Author>Jeff Jenness</Author>
    <Company>Jenness Enterprises</Company>
    <Date>6/26/2026 9:21:21 AM</Date>
    <Subject>Framework, Geometry, Geoprocessing</Subject>
    <!-- Note subject can be one or more of these topics:
                    Content, Framework, Editing, Geodatabase, Geometry, Geoprocessing, Layouts, Map Authoring, Map Exploration -->
  </AddInInfo>

  <modules>
    <insertModule id="WildlifeTools_Module" className="Module1" autoLoad="true" caption="Wildlife Tools">
      <tabs>
        <tab id="WildlifeTools_Tab1" caption="Wildlife">
          <group refID="WildlifeTools_Group1"/>
          <group refID="WildlifeTools_GroupGraphics"/>
          <group refID="WildlifeTools_GroupCartography"/>
          <group refID="WildlifeTools_GroupTopo"/>
          <group refID="WildlifeTools_GroupDirectional"/>
          <group refID="WildlifeTools_GroupData"/>
          <group refID="WildlifeTools_GroupBreak"/>
        </tab>
      </tabs>

      <groups>
        <group id="WildlifeTools_Group1" caption="Home Range" appearsOnAddInTab="false">
          <menu refID="WildlifeTools_LoCoHMenu" size="large" />
          <menu refID="WildlifeTools_KernelDensityMenu" size="large" />
          <menu refID="WildlifeTools_MahalanobisMenu" size="large" />
        </group>
        <group id="WildlifeTools_GroupGraphics" caption="Graphics" appearsOnAddInTab="false">
          <toolPalette refID="WildlifeTools_AddGraphicsPalette" size="large" />
          <toolPalette refID="WildlifeTools_GraphicBackgroundsPalette" size="large" />
        </group>
        <group id="WildlifeTools_GroupCartography" caption="Cartography" appearsOnAddInTab="false">
          <toolPalette refID="WildlifeTools_NorthArrowsPalette" size="large" />
          <button refID="WildlifeTools_RemoveSlc" size="large" />
          <button refID="WildlifeTools_ShadowPolygons" size="large" />
          <menu refID="WildlifeTools_HillshadeVariationsMenu" size="large" />
        </group>
        <group id="WildlifeTools_GroupTopo" caption="Topographic Analysis" appearsOnAddInTab="false">
          <menu refID="WildlifeTools_TopographicRoughnessMenu" size="large" />
          <button refID="WildlifeTools_TopographicWetnessIndex" size="large" />
          <button refID="WildlifeTools_SlopeZonalStatistics" size="large" />
          <menu refID="WildlifeTools_TPIMenu" size="large" />
          <menu refID="WildlifeTools_AspectToolsMenu" size="large" />
        </group>
        <group id="WildlifeTools_GroupDirectional" caption="Terrain Graphs" appearsOnAddInTab="false">
          <button refID="WildlifeTools_PolarPlots" size="large" />
          <button refID="WildlifeTools_SlopeGraphic" size="large" />
        </group>
        <group id="WildlifeTools_GroupData" caption="Data Tools" appearsOnAddInTab="false">
          <button refID="WildlifeTools_FavoriteDatasets" size="large" />
          <button refID="WildlifeTools_AttributeSummary" size="large" />
        </group>
        <group id="WildlifeTools_GroupBreak" caption="Take a Break" appearsOnAddInTab="false">
          <button refID="WildlifeTools_ThoughtForTheDay" size="large" />
          <button refID="WildlifeTools_Sudoku" size="large" />
          <button refID="WildlifeTools_SlidingPuzzle" size="large" />
          <button refID="WildlifeTools_EasterEgg" size="large" />
        </group>
      </groups>

      <controls>
        <button id="WildlifeTools_LoCoHStandard"
                caption="LoCoH (Standard)"
                className="LoCoHStandardButton"
                loadOnClick="true"
                smallImage="Images\LoCoH_16.png"
                largeImage="Images\LoCoH_32.png"
                keytip="LC">
          <tooltip heading="Local Convex Hull (LoCoH) - Standard">
            Opens the Standard (k-) Local Convex Hull home-range tool from the Jenness Enterprises toolbox.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_LoCoHAdaptive"
                caption="LoCoH (Adaptive)"
                className="LoCoHAdaptiveButton"
                loadOnClick="true"
                smallImage="Images\LoCoH_a_16.png"
                largeImage="Images\LoCoH_a_32.png"
                keytip="LA">
          <tooltip heading="Local Convex Hull (LoCoH) - Adaptive">
            Opens the Adaptive (a-) Local Convex Hull home-range tool from the Jenness Enterprises toolbox.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_LoCoHFixedSphere"
                caption="LoCoH (Fixed Sphere)"
                className="LoCoHFixedSphereButton"
                loadOnClick="true"
                smallImage="Images\LoCoH_r_16.png"
                largeImage="Images\LoCoH_r_32.png"
                keytip="LF">
          <tooltip heading="Local Convex Hull (LoCoH) - Fixed Sphere">
            Opens the Fixed-sphere-of-influence (r-) Local Convex Hull home-range tool from the Jenness Enterprises toolbox.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_KernelDensityGenerate"
                caption="Kernel Density Enhanced"
                className="KernelDensityGenerateButton"
                loadOnClick="true"
                smallImage="Images\Normal_Curve_DarkBlue_16.png"
                largeImage="Images\Kernel_Density_Enhanced_32.png"
                keytip="KD">
          <tooltip heading="Kernel Density Enhanced">
            Opens the Kernel Density Enhanced tool from the Jenness Enterprises toolbox: a custom kernel-density surface from points, with selectable kernel shapes, planar/geodesic distances, and density / expected-count / proportion outputs.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_KernelDensityProportion"
                caption="KD to Proportion Surface"
                className="KernelDensityProportionButton"
                loadOnClick="true"
                smallImage="Images\Normal_Curve_GanadoRed_16.png"
                largeImage="Images\KD_to_Proportion_32.png"
                keytip="KP">
          <tooltip heading="Kernel Density to Proportion Surface">
            Opens the Kernel Density to Proportion Surface tool from the Jenness Enterprises toolbox: converts a kernel-density raster into a volume raster (percent of volume enclosed by each cell's isopleth) ready for contouring at 50/95/99.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_KernelDensityContours"
                caption="KD Probability Contours"
                className="KernelDensityContoursButton"
                loadOnClick="true"
                smallImage="Images\Normal_Curve_DarkGreen_16.png"
                largeImage="Images\KD_Probability_Contours_32.png"
                keytip="KC">
          <tooltip heading="Kernel Density Probability Contours">
            Opens the Kernel Density Probability Contours tool from the Jenness Enterprises toolbox: generates home-range probability isopleths (5%-100%) as polylines and/or polygon areas.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_MahalanobisRaster"
                caption="Mahalanobis Distance Raster"
                className="MahalanobisRasterButton"
                loadOnClick="true"
                smallImage="Images\M1_16.png"
                largeImage="Images\M1_32.png"
                keytip="MR">
          <tooltip heading="Mahalanobis Distance Raster">
            Opens the Mahalanobis Distance Raster tool from the Jenness Enterprises toolbox: builds a per-cell raster of Mahalanobis distances from a set of landscape variables.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_MahalanobisPoints"
                caption="Mahalanobis Distance at Points"
                className="MahalanobisPointsButton"
                loadOnClick="true"
                smallImage="Images\Mvector_16.png"
                largeImage="Images\Mvector_32.png"
                keytip="MP">
          <tooltip heading="Mahalanobis Distance at Points">
            Opens the Mahalanobis at Points tool from the Jenness Enterprises toolbox: computes a Mahalanobis value at each input point from a set of landscape variables.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_MahalanobisCovariance"
                caption="Calculate Statistical Matrices"
                className="MahalanobisCovarianceButton"
                loadOnClick="true"
                smallImage="Images\Stats_16b.png"
                largeImage="Images\Stats_32.png"
                keytip="MV">
          <tooltip heading="Calculate Statistical Matrices">
            Opens the Calculate Statistical Matrices tool from the Jenness Enterprises toolbox: computes mean, covariance, inverse covariance, and correlation tables for a set of landscape variables, for reuse by the Mahalanobis Raster and at Points tools.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_MahalanobisChiSquare"
                caption="Mahalanobis Chi-Square Transform"
                className="MahalanobisChiSquareButton"
                loadOnClick="true"
                smallImage="Images\chi_square_symbol_16.png"
                largeImage="Images\chi_square_symbol_32.png"
                keytip="MC">
          <tooltip heading="Mahalanobis Distance - Chi-Square Transform">
            Opens the Chi-Square Transform tool from the Jenness Enterprises toolbox: rescales a Mahalanobis squared-distance (D2) raster to a 0-1 chi-square typicality p-value.<disabledText />
          </tooltip>
        </button>
        <tool id="WildlifeTools_CompassRoseGraphic"
                caption="Compass graphic 1"
                className="CompassRoseGraphicTool"
                loadOnClick="true"
                smallImage="Images\CompassRose_16.png"
                largeImage="Images\CompassRose_32.png"
                keytip="CG">
          <tooltip heading="Compass graphic 1">
            Adds the Jennessent Compass Rose to the active map or layout as a picture graphic. On a map, draw a box to size it; on a layout, click to place it at a default size and then resize it with the selection handles.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_CompassRoseDotGraphic"
                caption="Compass graphic 1 - dot"
                className="CompassRoseDotGraphicTool"
                loadOnClick="true"
                smallImage="Images\CompassRoseDot_16.png"
                largeImage="Images\CompassRoseDot_32.png"
                keytip="CD">
          <tooltip heading="Compass graphic 1 - dot">
            Adds the Jennessent Compass Rose with the north dot to the active map or layout as a picture graphic. On a map, draw a box to size it; on a layout, click to place it at a default size and then resize it with the selection handles.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_Compass2Graphic"
                caption="Compass graphic 2"
                className="Compass2GraphicTool"
                loadOnClick="true"
                smallImage="Images\Compass2_16.png"
                largeImage="Images\Compass2_32.png"
                keytip="C2">
          <tooltip heading="Compass graphic 2">
            Adds the Compass_2d design (black cardinal star, gray intercardinal star, twin rings) to the active map or layout as a picture graphic. On a map, draw a box to size it; on a layout, click to place it at a default size and then resize it with the selection handles.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_Compass2DotGraphic"
                caption="Compass graphic 2 - dot"
                className="Compass2DotGraphicTool"
                loadOnClick="true"
                smallImage="Images\Compass2Dot_16.png"
                largeImage="Images\Compass2Dot_32.png"
                keytip="C4">
          <tooltip heading="Compass graphic 2 - dot">
            Adds the Compass_2d design with the gradient spearhead above the north point to the active map or layout as a picture graphic. On a map, draw a box to size it; on a layout, click to place it at a default size and then resize it with the selection handles.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_CompassRoseNorthArrow"
                caption="North arrow 1"
                className="CompassRoseNorthArrowTool"
                loadOnClick="true"
                smallImage="Images\CompassRose_16.png"
                largeImage="Images\CompassRose_32.png"
                condition="esri_layouts_layoutPaneCondition"
                keytip="CN">
          <tooltip heading="North arrow 1">
            Click the active layout to add a north arrow symbolized as the Jennessent Compass Rose, tied to the layout's map frame (or unassociated if the layout has no map frame yet), then resize it with the selection handles. Available only in a layout view.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_CompassRoseDotNorthArrow"
                caption="North arrow 1 - dot"
                className="CompassRoseDotNorthArrowTool"
                loadOnClick="true"
                smallImage="Images\CompassRoseDot_16.png"
                largeImage="Images\CompassRoseDot_32.png"
                condition="esri_layouts_layoutPaneCondition"
                keytip="CO">
          <tooltip heading="North arrow 1 - dot">
            Click the active layout to add a north arrow symbolized as the Jennessent Compass Rose with the north dot, tied to the layout's map frame (or unassociated if the layout has no map frame yet), then resize it with the selection handles. Available only in a layout view.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_Compass2NorthArrow"
                caption="North arrow 2"
                className="Compass2NorthArrowTool"
                loadOnClick="true"
                smallImage="Images\Compass2_16.png"
                largeImage="Images\Compass2_32.png"
                condition="esri_layouts_layoutPaneCondition"
                keytip="N2">
          <tooltip heading="North arrow 2">
            Click the active layout to add a north arrow symbolized as the Compass_2d design (black cardinal star, gray intercardinal star, twin rings), tied to the layout's map frame (or unassociated if the layout has no map frame yet), then resize it with the selection handles. Available only in a layout view.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_Compass2DotNorthArrow"
                caption="North arrow 2 - dot"
                className="Compass2DotNorthArrowTool"
                loadOnClick="true"
                smallImage="Images\Compass2Dot_16.png"
                largeImage="Images\Compass2Dot_32.png"
                condition="esri_layouts_layoutPaneCondition"
                keytip="N4">
          <tooltip heading="North arrow 2 - dot">
            Click the active layout to add a north arrow symbolized as the Compass_2d design with the gradient spearhead above the north point, tied to the layout's map frame (or unassociated if the layout has no map frame yet), then resize it with the selection handles. Available only in a layout view.<disabledText />
          </tooltip>
        </tool>
        <button id="WildlifeTools_AddGraphicCircle"
                caption="Circle"
                className="AddGraphicCircleButton"
                loadOnClick="true"
                smallImage="Images\CircleBackground_16.png"
                largeImage="Images\CircleBackground_32.png"
                keytip="CB">
          <tooltip heading="Circle">
            Draws a circle graphic behind the selected element or elements (graphics or layout map elements), then groups the circle and the selection into a new group with the circle underneath. Opens a dialog to set the name, polygon symbology, fill and outline transparency, and radius. Works on selected elements, not on features in a dataset.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_RectangleBackground"
                caption="Rectangle"
                className="RectangleBackgroundButton"
                loadOnClick="true"
                smallImage="Images\RectangleBackground_16.png"
                largeImage="Images\RectangleBackground_32.png"
                keytip="RB">
          <tooltip heading="Rectangle">
            Draws a rectangle graphic (with optional rounded corners) behind the selected element or elements (graphics or layout map elements), then groups the rectangle and the selection into a new group with the rectangle underneath. Opens a dialog to set the name, polygon symbology, fill and outline transparency, horizontal and vertical extent, and corner rounding. Works on selected elements, not on features in a dataset.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_PolygonBackground"
                caption="Polygon"
                className="PolygonBackgroundButton"
                loadOnClick="true"
                smallImage="Images\PolygonBackground_16.png"
                largeImage="Images\PolygonBackground_32.png"
                keytip="PB">
          <tooltip heading="Polygon">
            Draws a polygon graphic that fits the actual shape of the selected element or elements — traced from each element's geometry or its symbolized shape, with an optional buffer — then groups the polygon and the selection into a new group with the polygon underneath. On a map the buffer is in map units; on a layout choose millimeters, centimeters, inches, or points. Works on selected elements, not on features in a dataset.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_McpBackground"
                caption="Minimum Convex Polygon"
                className="McpBackgroundButton"
                loadOnClick="true"
                smallImage="Images\McpBackground_16.png"
                largeImage="Images\McpBackground_32.png"
                keytip="MB">
          <tooltip heading="Minimum Convex Polygon">
            Draws a minimum convex polygon around the selected element or elements — hulled from each element's geometry or its symbolized shape, with an optional buffer — then groups the polygon and the selection into a new group with the polygon underneath. On a map the buffer is in map units; on a layout choose millimeters, centimeters, inches, or points. Works on selected elements, not on features in a dataset.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_RemoveSlc"
                caption="Remove SLC"
                className="RemoveSlcButton"
                loadOnClick="true"
                smallImage="Images\RemoveSLC_16.png"
                largeImage="Images\RemoveSLC_32.png"
                condition="esri_layouts_layoutPaneCondition"
                keytip="RS">
          <tooltip heading="Remove SLC">
            Moves Esri's Service Layer Credits text out of the map frame by adding a Service Layer Credits dynamic text element parked below the layout page (top edge half an inch below the page bottom, left edge flush with the page), where it never prints. If the layout already has one, it is moved there instead. Available only in a layout view.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_ShadowPolygons"
                caption="Create Shadow Polygons"
                className="ShadowPolygonsButton"
                loadOnClick="true"
                smallImage="Images\ShadowPolygons_16.png"
                largeImage="Images\ShadowPolygons_32.png"
                keytip="SP">
          <tooltip heading="Create Shadow Polygons">
            Opens the Create Shadow Polygons tool from the Jenness Enterprises toolbox: concentric ring buffers around the dissolved polygons of a feature class, with a Transparency attribute that fades outward for a soft black cartographic shadow. Also available in the Cartography Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_EnhancedHillshade"
                caption="Enhanced Hillshade"
                className="EnhancedHillshadeButton"
                loadOnClick="true"
                smallImage="Images\EnhancedHillshade_16.png"
                largeImage="Images\EnhancedHillshade_32.png"
                keytip="EH">
          <tooltip heading="Enhanced Hillshade">
            Opens the Enhanced Hillshade tool from the Jenness Enterprises toolbox: a hillshade that is accurate on geographic (lat/long) DEMs via per-row spheroidal cell dimensions, with hillshade levels, hypsometric shading, vertical exaggeration, and optional modeled cast shadows. Also available in the Cartography Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_MDOWHillshade"
                caption="MDOW Hillshade"
                className="MDOWHillshadeButton"
                loadOnClick="true"
                smallImage="Images\MDOWHillshade_16.png"
                largeImage="Images\MDOWHillshade_32.png"
                keytip="MH">
          <tooltip heading="MDOW Hillshade">
            Opens the MDOW (Multi-Directional Oblique-Weighted) Hillshade tool from the Jenness Enterprises toolbox: blends four sun directions fanned around the primary illumination direction, weighted so every slope is lit obliquely - revealing terrain that a single-direction hillshade washes out (Mark 1992). Accurate on geographic (lat/long) DEMs via per-row spheroidal cell dimensions. Also available in the Cartography Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_MultiSunHillshade"
                caption="Multi-Sun Hillshade"
                className="MultiSunHillshadeButton"
                loadOnClick="true"
                smallImage="Images\MultiSunHillshade_16.png"
                largeImage="Images\MultiSunHillshade_32.png"
                keytip="MS">
          <tooltip heading="Multi-Sun Hillshade">
            Opens the Multi-Sun Hillshade tool from the Jenness Enterprises toolbox: a weighted average of standard hillshades from two to eight sun positions, each with its own azimuth, inclination, and weight - the classic Swiss multiple-light-source strategy for bringing out terrain a single sun washes out. Optional per-sun cast shadows and hypsometric shading; accurate on geographic (lat/long) DEMs. Also available in the Cartography Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_BlurredHillshade"
                caption="Blurred Hillshade"
                className="BlurredHillshadeButton"
                loadOnClick="true"
                smallImage="Images\BlurredHillshade_16.png"
                largeImage="Images\BlurredHillshade_32.png"
                keytip="BH">
          <tooltip heading="Blurred Hillshade">
            Opens the Blurred Hillshade tool from the Jenness Enterprises toolbox: a deliberately softened hillshade - the blurring component of the classic Swiss method - that de-emphasizes small terrain features so the shading reads as subtle and less distracting. Blur the DEM before shading or the finished hillshade after, with a radius in cells or ground units (sized geodesically on lat/long DEMs). All Enhanced Hillshade options included. Also available in the Cartography Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SurfaceAreaRatio"
                caption="Surface Area and Ratio"
                className="SurfaceAreaRatioButton"
                loadOnClick="true"
                smallImage="Images\SurfaceArea_16.png"
                largeImage="Images\SurfaceArea_32.png"
                keytip="SA">
          <tooltip heading="Surface Area and Ratio">
            Opens the Surface Area and Ratio tool from the Jenness Enterprises toolbox: the 8-triangle surface-area method of Jenness (2004, Wildlife Society Bulletin 32:829-839). Outputs any combination of 3D surface area, surface ratio (a roughness index), and planimetric cell area; correct on geographic (lat/long) DEMs via per-row spheroidal distances and cell areas. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_VRM"
                caption="Vector Ruggedness Measure (VRM)"
                className="VRMButton"
                loadOnClick="true"
                smallImage="Images\VRM_16.png"
                largeImage="Images\VRM_32.png"
                keytip="VR">
          <tooltip heading="Vector Ruggedness Measure (VRM)">
            Opens the VRM tool from the Jenness Enterprises toolbox: a topographic roughness index (Sappington et al. 2007) measuring the 3D dispersion of unit vectors orthogonal to the terrain surface within a neighborhood of each cell - the spherical analog of circular variance (Fisher 1993). Distinguishes steep-but-even terrain from steep, broken terrain; correct on geographic (lat/long) DEMs. Optionally remove the smooth underlying topography first (Dilts et al. 2023) for a fine-scale local roughness map (VRM-L). Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_ACR"
                caption="Arc-Chord Ratio (ACR)"
                className="ACRButton"
                loadOnClick="true"
                smallImage="Images\ACR_16.png"
                largeImage="Images\ACR_32.png"
                keytip="AC">
          <tooltip heading="Arc-Chord Ratio (ACR)">
            Opens the Arc-Chord Ratio tool from the Jenness Enterprises toolbox: a surface-roughness (rugosity) index decoupled from slope (Du Preez 2015) - each cell's 3D surface area divided by the area of its plane of best fit, equivalently the Jenness (2004) surface ratio times the cosine of the 3x3 best-fit-plane slope. A smooth tilted surface has ACR = 1, so larger values reflect genuine roughness rather than steepness. Optionally remove the smooth underlying topography first (Dilts et al. 2023) for a fine-scale local roughness map (ACR-L). Correct on geographic (lat/long) DEMs. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_FractalDimension"
                caption="Fractal Dimension"
                className="FractalDimensionButton"
                loadOnClick="true"
                smallImage="Images\FD_16.png"
                largeImage="Images\FD_32.png"
                keytip="FD">
          <tooltip heading="Fractal Dimension (surface roughness)">
            Opens the Fractal Dimension tool from the Jenness Enterprises toolbox: the local fractal dimension of the terrain surface (D from 2 for smooth to 3 for maximally rough), computed in a moving window by a selectable method -- triangular prism (Clarke 1986; Ju and Lam 2009), variogram or madogram (Gneiting, Sevcikova, and Percival 2012; their R package fractaldim), or differential box counting (Sarkar and Chaudhuri 1994). Like VRM, it is independent of overall slope, measuring how roughness varies across scales. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_TRI"
                caption="Terrain Ruggedness Index (TRI)"
                className="TRIButton"
                loadOnClick="true"
                smallImage="Images\TRI_16.png"
                largeImage="Images\TRI_32.png"
                keytip="TR">
          <tooltip heading="Terrain Ruggedness Index (TRI)">
            Opens the TRI tool from the Jenness Enterprises toolbox: a neighborhood terrain-ruggedness index with four selectable methods -- the root of summed squared differences (Riley, DeGloria, and Elliot 1999), the mean absolute difference (Wilson et al. 2007), a slope (distance-weighted) variant that corrects for diagonal neighbors being farther away, or the standard deviation of the neighborhood elevations. Different methods capture different notions of ruggedness. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_TopographyAlongLines"
                caption="Topography along Lines"
                className="TopographyAlongLinesButton"
                loadOnClick="true"
                smallImage="Images\TopoLines_16.png"
                largeImage="Images\TopoLines_32.png"
                keytip="TL">
          <tooltip heading="Topography along Lines">
            Opens the Topography along Lines tool from the Jenness Enterprises toolbox: it adds attribute fields describing the topography along each line of a polyline feature class -- planimetric and surface length, surface ratio, uphill/downhill and slope statistics, direction statistics (mean direction, circular and angular variance), sinuosity, fractal dimension, and more. Elevation comes from the polylines' own Z values or is sampled from a DEM by bilinear interpolation at a regular ground interval; each line is reduced to straight 3D segments. Direction-dependent statistics describe the line in the direction of its geometry (first vertex to last). Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SplitLinesIntoSegments"
                caption="Split Lines into Topography Segments"
                className="SplitLinesIntoSegmentsButton"
                loadOnClick="true"
                smallImage="Images\SplitSeg_16.png"
                largeImage="Images\SplitSeg_32.png"
                keytip="SS">
          <tooltip heading="Split Lines into Topography Segments">
            Opens the Split Lines into Topography Segments tool from the Jenness Enterprises toolbox: it converts each polyline into a new PolylineZ feature class with one true 3D feature per straight segment (sampled from the polylines' own Z values or a DEM, keeping the original vertices). Each segment can carry optional attributes -- start/end coordinates, planimetric and surface length, slope, bearing, deflection/inclination/3D-deflection angles, and more -- and you may copy any fields from the source table. The output displays in space in a Scene, and is symbolized with Unclassed Colors. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_LSRIOnDEM"
                caption="LSRI on DEM"
                className="LSRIOnDEMButton"
                loadOnClick="true"
                smallImage="Images\LSRI_DEM_16.png"
                largeImage="Images\LSRI_DEM_32.png"
                keytip="LD">
          <tooltip heading="LSRI on DEM (Land Surface Ruggedness Index)">
            Opens the LSRI on DEM tool from the Jenness Enterprises toolbox: the Land Surface Ruggedness Index (Beasom, Wiggers, and Giardino 1983), computed directly from a DEM by generating unsmoothed contours on the fly (same interval/base/z-factor logic as Esri's Contour tool) and measuring total contour length within a circular neighborhood of each cell. Similar in spirit to Esri's Line Density tool, but reports total length rather than density. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_LSRIOnContourPolylines"
                caption="LSRI on Contours"
                className="LSRIOnContourPolylinesButton"
                loadOnClick="true"
                smallImage="Images\LSRI_Contours_16.png"
                largeImage="Images\LSRI_Contours_32.png"
                keytip="LP">
          <tooltip heading="LSRI on Contours (Land Surface Ruggedness Index)">
            Opens the LSRI on Contours tool from the Jenness Enterprises toolbox: the Land Surface Ruggedness Index (Beasom, Wiggers, and Giardino 1983), computed directly from an existing contour (or any polyline) feature class by measuring total line length within a circular neighborhood of each cell. Honors the input's current selection. Similar in spirit to Esri's Line Density tool, but reports total length rather than density. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_TopographicWetnessIndex"
                caption="Topographic Wetness Index"
                className="TWIButton"
                loadOnClick="true"
                smallImage="Images\TWI_16.png"
                largeImage="Images\TWI_32.png"
                keytip="TW">
          <tooltip heading="Topographic Wetness Index (TWI / CTI)">
            Opens the Topographic Wetness Index tool from the Jenness Enterprises toolbox: TWI (also called the Compound Topographic Index) = ln( specific catchment area / (tan(slope) + epsilon) ), marking cells with large upslope area and/or gentle slope (wet valley bottoms and convergence zones) versus dry ridges and steep, diverging slopes (Beven and Kirkby 1979). Sink filling (priority-flood; Barnes, Lehman, and Mulla 2014), D8 flow direction (O'Callaghan and Mark 1984), and flow accumulation are computed internally -- no Spatial Analyst required -- or you can supply a pre-filled DEM and/or flow-accumulation raster. Slope comes from the original DEM. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_AspectTransformation"
                caption="Aspect Transformation"
                className="AspectTransformationButton"
                loadOnClick="true"
                smallImage="Images\AspectTrans_16.png"
                largeImage="Images\AspectTrans_32.png"
                keytip="AX">
          <tooltip heading="Aspect Transformation">
            Opens the Aspect Transformation tool from the Jenness Enterprises toolbox: generate one or more transformations of an aspect raster at once. Directional reclassifications assign each cell a named direction class (North/South, East/West, the four or eight cardinal and intercardinal directions) written to a Class attribute table. Trigonometric transforms produce continuous rasters: northness (cosine of aspect), eastness (sine), a trigonometric deviation from a chosen bearing (1 toward, -1 away; Trimble and Weitzman 1956, Beers et al. 1966), or a numeric deviation in degrees (0-180; Jenness 2015). Flat cells (aspect -1) can be kept as a Flat class / -1 or set to NoData. D-infinity flow-direction rasters are supported via a convention toggle. No Spatial Analyst required. Also available in the Aspect Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_AspectZonalStatistics"
                caption="Aspect Zonal Statistics as Table"
                className="AspectZonalStatisticsButton"
                loadOnClick="true"
                smallImage="Images\AspectZonal_16.png"
                largeImage="Images\AspectZonal_32.png"
                keytip="AZ">
          <tooltip heading="Aspect Zonal Statistics as Table">
            Opens the Aspect Zonal Statistics as Table tool from the Jenness Enterprises toolbox: summarizes an aspect raster per zone into a table of CIRCULAR statistics (mean direction, mean resultant length, circular variance and SD, median direction, circular range, von Mises concentration, Rayleigh test, and the 95% CI of the mean direction). Very similar to Esri's Zonal Statistics as Table, but built for aspect -- a circular variable where the ordinary zonal MEAN and STD are wrong -- and it requires no Spatial Analyst or Image Analyst extension. Zones come from an integer raster or point / polyline / polygon features; overlapping features in different zones are each analyzed in full. Point zones use bilinear weighted-mean-direction interpolation. Flat cells (aspect -1) are excluded from the statistics and counted per zone. D-infinity rasters are supported via a convention toggle that defaults from the raster's geoprocessing history. Also available in the Aspect Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SlopeZonalStatistics"
                caption="Slope Zonal Statistics as Table"
                className="SlopeZonalStatisticsButton"
                loadOnClick="true"
                smallImage="Images\SlopeZonal_16.png"
                largeImage="Images\SlopeZonal_32.png"
                keytip="SZ">
          <tooltip heading="Slope Zonal Statistics as Table">
            Opens the Slope Zonal Statistics as Table tool from the Jenness Enterprises toolbox: summarizes a slope raster per zone into a table (count, mean, median, standard deviation, min, max, range, 5th/95th percentiles, and the 95% confidence interval of the mean). Very similar to Esri’s Zonal Statistics as Table, but built for slope -- the mean, SD and CI are computed on the slope ANGLES, because percent slope is the tangent of the angle and averaging raw percent values biases steepness statistics high -- and it requires no Spatial Analyst or Image Analyst extension. Slope units (degrees, percent, rise:run, gradians) default automatically from the raster’s geoprocessing history; results are reported in the source unit. Negative slopes can be treated as positive (absolute steepness) or keep their sign so downhill balances uphill. Zones come from an integer raster or point / polyline / polygon features; overlapping features in different zones are each analyzed in full. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_ExtractAspectValuesToPoints"
                caption="Extract Aspect Values to Points"
                className="ExtractAspectValuesToPointsButton"
                loadOnClick="true"
                smallImage="Images\AspectPoint_16.png"
                largeImage="Images\AspectPoint_32.png"
                keytip="AP">
          <tooltip heading="Extract Aspect Values to Points">
            Opens the Extract Aspect Values to Points tool from the Jenness Enterprises toolbox: copies the input points and adds a field holding the aspect at each point, extracted from an aspect raster -- like Esri's Extract Values to Points, but built for aspect. The optional interpolation is a bilinear WEIGHTED MEAN DIRECTION (circular), never a linear average, so directions near north interpolate correctly (359 and 1 give ~0, not 180). Flat cells (aspect -1) are excluded from interpolation; all-flat neighbors give -1. D-infinity flow-direction rasters are supported via a convention toggle. No Spatial Analyst required. Also available in the Aspect Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_AspectFocalStatistics"
                caption="Aspect Focal Statistics"
                className="AspectFocalStatisticsButton"
                loadOnClick="true"
                smallImage="Images\Aspect_16.png"
                largeImage="Images\Aspect_32.png"
                keytip="AF">
          <tooltip heading="Aspect Focal Statistics">
            Opens the Aspect Focal Statistics tool from the Jenness Enterprises toolbox: neighborhood (focal) statistics for an aspect raster computed with CIRCULAR statistics. Aspect is a circular variable (0 and 360 degrees are the same direction), so ordinary Focal Statistics is invalid; this tool offers circular measures of central tendency and dispersion (mean direction, circular variance, standard deviation, resultant length, range, Rayleigh test, von Mises concentration, and more) over any neighborhood shape, on projected or geographic aspect rasters, with no Spatial Analyst. Flat cells (aspect -1) are ignored. D-infinity flow-direction rasters -- essentially aspect in the mathematical convention -- are supported via a convention toggle. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SimpleTPI"
                caption="Topographic Position Index"
                className="SimpleTPIButton"
                loadOnClick="true"
                smallImage="Images\TPI_16.png"
                largeImage="Images\TPI_32.png"
                keytip="TP">
          <tooltip heading="Topographic Position Index (TPI)">
            Opens the Topographic Position Index tool from the Jenness Enterprises toolbox: each cell's elevation minus the mean elevation of a neighborhood around it (Weiss 2001; Guisan et al. 1999). Positive values sit above their surroundings (ridges, hills), negative below (valleys, channels). Produces any of three outputs -- raw TPI in elevation units, or TPI standardized into standard-deviation units at DEM scale or at neighborhood scale. Computed internally, no Spatial Analyst. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SlopePosition"
                caption="Slope Position Classification"
                className="SlopePositionButton"
                loadOnClick="true"
                smallImage="Images\SlopePos_16.png"
                largeImage="Images\SlopePos_32.png"
                keytip="SP">
          <tooltip heading="Slope Position Classification">
            Opens the Slope Position Classification tool from the Jenness Enterprises toolbox: classifies a DEM into slope-position classes (valley, lower/middle/upper slope, flat, ridge) from a Topographic Position Index (elevation minus neighborhood mean) plus slope, using a saved classification system such as the Weiss 6-class or Dickson and Beier 4-class (Weiss 2001). TPI and slope are computed internally -- no Spatial Analyst -- or you may supply pre-computed rasters. Author the class rules and colors with the Classification System Builder. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_Landform"
                caption="Landform Classification"
                className="LandformButton"
                loadOnClick="true"
                smallImage="Images\Landform_16.png"
                largeImage="Images\Landform_32.png"
                keytip="LC">
          <tooltip heading="Landform Classification">
            Opens the Landform Classification tool from the Jenness Enterprises toolbox: classifies a DEM into landform categories (canyons, valleys, plains, open and upper slopes, ridges, peaks) from a small- and a large-neighborhood Topographic Position Index plus slope, using a saved classification system such as the Weiss 10-class (Weiss 2001). The two TPIs and slope are computed internally -- no Spatial Analyst -- or you may supply pre-computed rasters. Author the class rules and colors with the Classification System Builder. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_GeneralClassification"
                caption="General Raster Classification"
                className="GeneralClassificationButton"
                loadOnClick="true"
                smallImage="Images\GenClass_16.png"
                largeImage="Images\GenClass_32.png"
                keytip="GC">
          <tooltip heading="General Raster Classification">
            Opens the General Raster Classification tool from the Jenness Enterprises toolbox: classifies any single raster into categories using a saved 'general' classification system (threshold rules on the raster's raw or whole-raster standardized values). Similar in purpose to Esri's Reclassify tool, except that the classification scheme is authored once, as a reusable named system, in the Classification System Builder; that each class stores a name and color with the output; and that no Spatial Analyst or 3D Analyst extension is required. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_ClassificationBuilder"
                caption="Classification System Builder"
                className="Classification.ClassificationBuilderButton"
                loadOnClick="true"
                smallImage="Images\ClassBuilder_16.png"
                largeImage="Images\ClassBuilder_32.png"
                keytip="CB">
          <tooltip heading="Classification System Builder">
            Create, edit, duplicate, and delete the reusable classification systems (class thresholds, names, and colors -- with optional per-class transparency) applied by the Slope Position, Landform, and General Raster Classification tools. Systems are saved as JSON in a per-user location that survives add-in reinstalls, so your custom classifications stay available and can be shared by copying the files.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SimpleHypsometricShading"
                caption="Simple Hypsometric Shading"
                className="SimpleHypsometricShadingButton"
                loadOnClick="true"
                smallImage="Images\SimpleHypso_16.png"
                largeImage="Images\SimpleHypso_32.png"
                keytip="HY">
          <tooltip heading="Simple Hypsometric Shading">
            Opens the Simple Hypsometric Shading tool from the Jenness Enterprises toolbox: creates a group layer draping a DEM (black-to-white stretch at a chosen transparency) over an existing hillshade for classic elevation-tinted relief. No new dataset is created - the group layer references the existing rasters and stays fully editable. Also available in the Cartography Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_ThoughtForTheDay"
                caption="Thought for the Day"
                className="ThoughtForTheDayButton"
                loadOnClick="true"
                smallImage="Images\Heart_16.png"
                largeImage="Images\Heart_32.png"
                keytip="TD">
          <tooltip heading="Thought for the Day">
            Shows a random inspirational quote in a little pop-up card.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_PolarPlots"
                caption="Polar Plots"
                className="PolarPlots.PolarPlotButton"
                loadOnClick="true"
                smallImage="Images\PolarPlot_16.png"
                largeImage="Images\PolarPlot_32.png"
                keytip="PP">
          <tooltip heading="Polar Plots">
            Opens the interactive Polar Plots window: generate a circular plot of directional data from a feature class or table -- Peaks and Valleys, Circular Bins (Rose), Shade by Density, the External variants, or a Bearings plot -- adjust it live, and save it as an SVG file or place it as a grouped, fully editable graphic on the layout or map. Azimuths come from an attribute field or are derived from polyline direction (geodesic on lat/long data), optionally weighted by length or an attribute. Also reports circular descriptive statistics (mean direction, dispersion, Rayleigh test, von Mises concentration, and more) that can be copied as raw / rich / Esri-formatted text or placed on a layout as a text element in one click. Reusable style presets save every appearance option. A modernized recreation of the Jenness Enterprises Polar Plots extension for ArcMap.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SlopeGraphic"
                caption="Slope Graphic"
                className="SlopeGraphic.SlopeGraphicButton"
                loadOnClick="true"
                smallImage="Images\SlopeGraphic_16.png"
                largeImage="Images\SlopeGraphic_32.png"
                keytip="SG">
          <tooltip heading="Slope Graphic">
            Opens the interactive Slope Graphic window: an intuitive visual summary of the slope in an area -- a line inclined at the MEAN slope, a wedge spanning one standard deviation either side of it, a wedge spanning the full min-max range, an optional robust percentile wedge, a dashed median line, a protractor scale arc, and an arcing 95% confidence interval of the mean. Reads slope from a numeric field on a feature layer or table, or streams an entire slope raster (any size) into exact statistics; values may be in degrees, percent slope, rise:run ratio, or gradians. Adjust everything live and save the graphic as an SVG file or place it as a grouped, fully editable graphic on the layout or map, with slope statistics one click away. A modernized recreation of the Slope Graphic from the Jenness Enterprises Grid Tools extension for ArcView 3.x.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_FavoriteDatasets"
                caption="Load Favorite Datasets"
                className="DataTools.FavoriteDatasetsButton"
                loadOnClick="true"
                smallImage="Images\FavoriteData_16.png"
                largeImage="Images\FavoriteData_32.png"
                keytip="FD">
          <tooltip heading="Load Favorite Datasets">
            Opens the Load Favorite Datasets window: keep your most-used datasets in four groups you name yourself, then check any combination and add them all to the active map with one click -- no more hunting through folders and web servers. Any dataset a browse dialog can reach can be saved: feature classes, rasters, tables, and online services alike. Add items, remove them, and edit their descriptions; the lists are saved with your user profile and shared across projects. Datasets that appear to be unavailable (a missing path or an unreachable server) show in RED. A modernized recreation of the Load Favorite Datasets tool from the ArcMap SSI toolbar.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_AttributeSummary"
                caption="Attribute Summary Reports"
                className="DataTools.AttributeSummaryButton"
                loadOnClick="true"
                smallImage="Images\AttrSummary_16.png"
                largeImage="Images\AttrSummary_32.png"
                keytip="AR">
          <tooltip heading="Attribute Summary Reports">
            Opens the Attribute Summary Reports window: counts and proportions of the value classes in one or more attribute fields of a feature layer, standalone table, or raster attribute table -- summarize each field separately or the unique COMBINATIONS of several fields together, in an analysis order you control. Each report line is rendered from a format template you design with token buttons ({val1}, {Count}, {Prop2}, running numbers/letters/roman numerals, tabs, ...) with a live sample preview; formats can be saved and reloaded as presets. The report opens in a window ready to copy as plain text, rich text for Word, or a clean tab-separated table for Excel. A modernized recreation of the Summarize Attribute Fields tool from the ArcMap SSI toolbar.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_Sudoku"
                caption="Sudoku"
                className="Sudoku.SudokuButton"
                loadOnClick="true"
                smallImage="Images\Sudoku_16.png"
                largeImage="Images\Sudoku_32.png"
                keytip="SD">
          <tooltip heading="Sudoku">
            Opens a Sudoku puzzle in a floating window, so the map keeps working while you think. Three difficulty levels; every puzzle has exactly one solution. Click a cell and type 1-9; arrow keys move (wrapping at the edges) and Tab snakes through the grid. Check colors your entries blue (correct) or red (incorrect), and Reveal Cell will confess a single answer -- after asking if you are sure you want it.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SlidingPuzzle"
                caption="Sliding Puzzle"
                className="Puzzle.SlidingPuzzleButton"
                loadOnClick="true"
                smallImage="Images\Puzzle_16.png"
                largeImage="Images\Puzzle_32.png"
                keytip="SP">
          <tooltip heading="Sliding Puzzle">
            Turns a snapshot of your current map or layout into a sliding-tile puzzle in a floating window, so the map keeps working while you play. A map is cropped to its largest visible square (switchable 4x4, 5x5, or 6x6 tiles); a layout uses the whole page, with the tile count you pick along the short edge and a matching near-square count along the long edge. One tile is removed and the rest are scrambled; slide tiles into the gap to rebuild the picture. Peek shows the finished image, and Numbers turns on an easier mode.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_EasterEgg"
                caption="ArcMap Easter Egg"
                className="EasterEggButton"
                loadOnClick="true"
                smallImage="Images\Jerry_16.png"
                largeImage="Images\Jerry_32.png"
                keytip="EE">
          <tooltip heading="ArcMap Easter Egg">
            Opens a little pop-up card celebrating a classic ArcMap easter egg: back in ArcMap 8.3 and 9.0, typing the letters "jerry" during an edit session made a picture of Jerry Garcia appear on your map. The card shows the original artwork (recovered from the ArcMap 8.3 install) and the story behind it, with a credited link to the source photograph.<disabledText />
          </tooltip>
        </button>
      </controls>
      <palettes>
        <!-- Dropdown palettes (same control Esri's Select tool uses): one face button
             on the ribbon, the four compass variants in the dropdown. -->
        <toolPalette id="WildlifeTools_AddGraphicsPalette"
                     caption="Add Graphics"
                     extendedCaption="Open the compass graphics tool palette"
                     itemsInRow="1"
                     showItemCaption="true"
                     keytip="AG"
                     smallImage="Images\CompassRoseDot_16.png"
                     largeImage="Images\CompassRoseDot_32.png">
          <tooltip heading="Jennessent Graphics">
            Adds a Jennessent graphic to the active map or layout as a picture graphic. On a map, draw a box to size it; on a layout, click to place it at a default size and then resize it with the selection handles.<disabledText />
          </tooltip>
          <tool refID="WildlifeTools_CompassRoseGraphic" />
          <tool refID="WildlifeTools_CompassRoseDotGraphic" />
          <tool refID="WildlifeTools_Compass2Graphic" />
          <tool refID="WildlifeTools_Compass2DotGraphic" />
        </toolPalette>
        <toolPalette id="WildlifeTools_GraphicBackgroundsPalette"
                     caption="Graphic Backgrounds"
                     extendedCaption="Open the graphic background tool palette"
                     itemsInRow="1"
                     showItemCaption="true"
                     keytip="GB"
                     smallImage="Images\CircleBackground_16.png"
                     largeImage="Images\CircleBackground_32.png">
          <tooltip heading="Graphic Background">
            Draws a background graphic behind the selected element or elements (graphics or layout map elements), then groups the background and the selection into a new group with the background underneath. Opens a dialog to set the name, polygon symbology, fill and outline transparency, and size. Works on selected elements, not on features in a dataset.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_AddGraphicCircle" />
          <button refID="WildlifeTools_RectangleBackground" />
          <button refID="WildlifeTools_PolygonBackground" />
          <button refID="WildlifeTools_McpBackground" />
        </toolPalette>
        <toolPalette id="WildlifeTools_NorthArrowsPalette"
                     caption="North Arrows"
                     extendedCaption="Open the compass north arrow tool palette"
                     itemsInRow="1"
                     showItemCaption="true"
                     keytip="NA"
                     condition="esri_layouts_layoutPaneCondition"
                     smallImage="Images\CompassRoseDot_16.png"
                     largeImage="Images\CompassRoseDot_32.png">
          <tooltip heading="Jennessent North Arrows">
            Click the active layout to add a north arrow symbolized as a Jennessent graphic, tied to the layout's map frame (or unassociated if the layout has no map frame yet), then resize it with the selection handles. Available only in a layout view.<disabledText />
          </tooltip>
          <tool refID="WildlifeTools_CompassRoseNorthArrow" />
          <tool refID="WildlifeTools_CompassRoseDotNorthArrow" />
          <tool refID="WildlifeTools_Compass2NorthArrow" />
          <tool refID="WildlifeTools_Compass2DotNorthArrow" />
        </toolPalette>
      </palettes>
      <menus>
        <!-- Menus (not toolPalettes) so each ribbon entry stays a stable,
             always-dropping-down button: a palette face executes the current
             child on click and mutates to the last-used item's identity, which
             is wrong for these sets of distinct tools. -->
        <menu id="WildlifeTools_LoCoHMenu"
              caption="Local Convex Hulls"
              keytip="LH"
              smallImage="Images\LoCoH_16.png"
              largeImage="Images\LoCoH_32.png">
          <tooltip heading="Local Convex Hulls">
            The Local Convex Hull (LoCoH) home-range tools from the Jenness Enterprises toolbox: the fixed (k-), adaptive (a-), and fixed-sphere-of-influence (r-) methods for estimating an animal's home range from location points.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_LoCoHStandard" />
          <button refID="WildlifeTools_LoCoHAdaptive" />
          <button refID="WildlifeTools_LoCoHFixedSphere" />
        </menu>
        <menu id="WildlifeTools_KernelDensityMenu"
              caption="Kernel Density Tools"
              keytip="KT"
              smallImage="Images\Normal_Curve_DarkBlue_16.png"
              largeImage="Images\Kernel_Density_Enhanced_32.png">
          <tooltip heading="Kernel Density Tools">
            The kernel-density home-range tools from the Jenness Enterprises toolbox: build a custom kernel-density surface from points, convert it to a proportion (volume) surface, and generate probability contours or isopleth areas.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_KernelDensityGenerate" />
          <button refID="WildlifeTools_KernelDensityProportion" />
          <button refID="WildlifeTools_KernelDensityContours" />
        </menu>
        <menu id="WildlifeTools_MahalanobisMenu"
              caption="Mahalanobis Tools"
              keytip="MT"
              smallImage="Images\M1_16.png"
              largeImage="Images\M1_32.png">
          <tooltip heading="Mahalanobis Tools">
            The Mahalanobis-distance habitat-analysis tools from the Jenness Enterprises toolbox: build a Mahalanobis distance raster or point values from landscape variables, compute the reusable statistical matrices, and rescale a squared-distance raster to a chi-square typicality p-value.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_MahalanobisRaster" />
          <button refID="WildlifeTools_MahalanobisPoints" />
          <button refID="WildlifeTools_MahalanobisCovariance" />
          <button refID="WildlifeTools_MahalanobisChiSquare" />
        </menu>
        <!-- A menu (not a toolPalette) so the ribbon entry stays a stable,
             always-dropping-down "Hillshade Variations" button: palette faces
             execute the current child on click and mutate to the last-used
             item's identity, which is wrong for these five distinct tools. -->
        <menu id="WildlifeTools_HillshadeVariationsMenu"
              caption="Hillshade Variations"
              keytip="HV"
              smallImage="Images\EnhancedHillshade_16.png"
              largeImage="Images\EnhancedHillshade_32.png">
          <tooltip heading="Hillshade Variations">
            Geodesic-correct hillshade tools from the Jenness Enterprises toolbox, including the "Swiss method" strategies for more attractive relief shading: multi-directional illumination (MDOW and Multi-Sun), blurring, and hypsometric (elevation-tinted) shading. Also available in the Cartography Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_EnhancedHillshade" />
          <button refID="WildlifeTools_MDOWHillshade" />
          <button refID="WildlifeTools_MultiSunHillshade" />
          <button refID="WildlifeTools_BlurredHillshade" />
          <button refID="WildlifeTools_SimpleHypsometricShading" />
        </menu>
        <menu id="WildlifeTools_TopographicRoughnessMenu"
              caption="Topographic Roughness"
              keytip="RG"
              smallImage="Images\Roughness_16.png"
              largeImage="Images\Roughness_32.png">
          <tooltip heading="Topographic Roughness">
            Tools for measuring the roughness or ruggedness of a landscape, from the Jenness Enterprises toolbox. There are many reasonable ways to define topographic roughness -- variation in elevation, steepness, surface area, variation in the direction the terrain faces, contour density, fractal dimension -- and no single right one: different measures suit different questions. This menu collects the raster measures (Surface Area and Ratio, Vector Ruggedness Measure, Arc-Chord Ratio, Terrain Ruggedness Index, Fractal Dimension, and the classic Land Surface Ruggedness Index, from a DEM or from existing contour lines), plus two tools that describe the terrain actually traversed along linear features such as trails or movement paths (Topography along Lines and Split Lines into Topography Segments) -- often more relevant to a moving animal than the general ruggedness of the surrounding landscape. All computed internally -- no Spatial Analyst. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_SurfaceAreaRatio" />
          <button refID="WildlifeTools_VRM" />
          <button refID="WildlifeTools_ACR" />
          <button refID="WildlifeTools_TRI" />
          <button refID="WildlifeTools_FractalDimension" />
          <button refID="WildlifeTools_LSRIOnDEM" />
          <button refID="WildlifeTools_LSRIOnContourPolylines" />
          <button refID="WildlifeTools_TopographyAlongLines" />
          <button refID="WildlifeTools_SplitLinesIntoSegments" />
        </menu>
        <menu id="WildlifeTools_AspectToolsMenu"
              caption="Aspect Tools"
              keytip="AT"
              smallImage="Images\Aspect_16.png"
              largeImage="Images\Aspect_32.png">
          <tooltip heading="Aspect Tools">
            Tools from the Jenness Enterprises toolbox for symbolizing, analyzing, and transforming aspect. Aspect is a circular variable (0 and 360 degrees are the same direction), so ordinary raster tools that treat it as a linear number give wrong answers; these tools handle it correctly. There is deliberately no tool here to CALCULATE aspect: ArcGIS Pro already has two good ones (the Aspect tool and Surface Parameters). These tools operate on an aspect raster you have already made. All computed internally -- no Spatial Analyst. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_AspectFocalStatistics" />
          <button refID="WildlifeTools_ExtractAspectValuesToPoints" />
          <button refID="WildlifeTools_AspectTransformation" />
          <button refID="WildlifeTools_AspectZonalStatistics" />
        </menu>
        <menu id="WildlifeTools_TPIMenu"
              caption="TPI Tools"
              keytip="TT"
              smallImage="Images\TPI_16.png"
              largeImage="Images\TPI_32.png">
          <tooltip heading="TPI Tools">
            The Topographic Position Index family from the Jenness Enterprises toolbox: compute TPI itself (raw, standardized, or percentile), classify terrain into slope-position or landform categories using reusable classification systems, classify any raster with the General Raster Classification tool, and author the classification systems (class thresholds, names, and colors) in the Classification System Builder. All computed internally -- no Spatial Analyst. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_SimpleTPI" />
          <button refID="WildlifeTools_SlopePosition" />
          <button refID="WildlifeTools_Landform" />
          <button refID="WildlifeTools_GeneralClassification" />
          <button refID="WildlifeTools_ClassificationBuilder" />
        </menu>
      </menus>

    </insertModule>
  </modules>
</ArcGIS>
