<?xml version="1.0" encoding="utf-8" ?>
<ArcGIS defaultAssembly="WildlifeTools.dll"
        defaultNamespace="WildlifeTools"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">

  <AddInInfo id="{9b04581c-dbfe-4025-8713-1cd30b3b1e47}" version="1.17.0" desktopVersion="3.7.1901" product="ArcGISPro">
    <Name>WildlifeTools</Name>
    <Description>Wildlife analysis tools for ArcGIS Pro, ported from the legacy ArcMap VB6 tools.</Description>
    <Image>Images\JennessLogo32.png</Image>
    <Author>Jeff Jenness</Author>
    <Company>Jenness Enterprises</Company>
    <Date>6/26/2026 9:21:21 AM</Date>
    <Subject>Framework, Geometry, Geoprocessing</Subject>
    <!-- Note subject can be one or more of these topics:
                    Content, Framework, Editing, Geodatabase, Geometry, Geoprocessing, Layouts, Map Authoring, Map Exploration -->
  </AddInInfo>

  <modules>
    <insertModule id="WildlifeTools_Module" className="Module1" autoLoad="true" caption="Wildlife Tools">
      <tabs>
        <tab id="WildlifeTools_Tab1" caption="Wildlife">
          <group refID="WildlifeTools_Group1"/>
          <group refID="WildlifeTools_GroupMahalanobis"/>
          <group refID="WildlifeTools_GroupGraphics"/>
          <group refID="WildlifeTools_GroupCartography"/>
          <group refID="WildlifeTools_GroupBreak"/>
        </tab>
      </tabs>

      <groups>
        <group id="WildlifeTools_Group1" caption="Home Range" appearsOnAddInTab="false">
          <button refID="WildlifeTools_LoCoHStandard" size="large" />
          <button refID="WildlifeTools_LoCoHAdaptive" size="large" />
          <button refID="WildlifeTools_LoCoHFixedSphere" size="large" />
          <button refID="WildlifeTools_KernelDensityGenerate" size="large" />
          <button refID="WildlifeTools_KernelDensityProportion" size="large" />
          <button refID="WildlifeTools_KernelDensityContours" size="large" />
        </group>
        <group id="WildlifeTools_GroupMahalanobis" caption="Mahalanobis Tools" appearsOnAddInTab="false">
          <button refID="WildlifeTools_MahalanobisRaster" size="large" />
          <button refID="WildlifeTools_MahalanobisPoints" size="large" />
          <button refID="WildlifeTools_MahalanobisCovariance" size="large" />
          <button refID="WildlifeTools_MahalanobisChiSquare" size="large" />
        </group>
        <group id="WildlifeTools_GroupGraphics" caption="Graphics" appearsOnAddInTab="false">
          <toolPalette refID="WildlifeTools_AddGraphicsPalette" size="large" />
          <toolPalette refID="WildlifeTools_GraphicBackgroundsPalette" size="large" />
        </group>
        <group id="WildlifeTools_GroupCartography" caption="Cartography" appearsOnAddInTab="false">
          <toolPalette refID="WildlifeTools_NorthArrowsPalette" size="large" />
        </group>
        <group id="WildlifeTools_GroupBreak" caption="Take a Break" appearsOnAddInTab="false">
          <button refID="WildlifeTools_ThoughtForTheDay" size="large" />
        </group>
      </groups>

      <controls>
        <button id="WildlifeTools_LoCoHStandard"
                caption="LoCoH (Standard)"
                className="LoCoHStandardButton"
                loadOnClick="true"
                smallImage="Images\LoCoH_16.png"
                largeImage="Images\LoCoH_32.png"
                keytip="LC">
          <tooltip heading="Local Convex Hull (LoCoH) - Standard">
            Opens the Standard (k-) Local Convex Hull home-range tool from the Jenness Enterprises toolbox.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_LoCoHAdaptive"
                caption="LoCoH (Adaptive)"
                className="LoCoHAdaptiveButton"
                loadOnClick="true"
                smallImage="Images\LoCoH_a_16.png"
                largeImage="Images\LoCoH_a_32.png"
                keytip="LA">
          <tooltip heading="Local Convex Hull (LoCoH) - Adaptive">
            Opens the Adaptive (a-) Local Convex Hull home-range tool from the Jenness Enterprises toolbox.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_LoCoHFixedSphere"
                caption="LoCoH (Fixed Sphere)"
                className="LoCoHFixedSphereButton"
                loadOnClick="true"
                smallImage="Images\LoCoH_r_16.png"
                largeImage="Images\LoCoH_r_32.png"
                keytip="LF">
          <tooltip heading="Local Convex Hull (LoCoH) - Fixed Sphere">
            Opens the Fixed-sphere-of-influence (r-) Local Convex Hull home-range tool from the Jenness Enterprises toolbox.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_KernelDensityGenerate"
                caption="Kernel Density Enhanced"
                className="KernelDensityGenerateButton"
                loadOnClick="true"
                smallImage="Images\Normal_Curve_DarkBlue_16.png"
                largeImage="Images\Kernel_Density_Enhanced_32.png"
                keytip="KD">
          <tooltip heading="Kernel Density Enhanced">
            Opens the Kernel Density Enhanced tool from the Jenness Enterprises toolbox: a custom kernel-density surface from points, with selectable kernel shapes, planar/geodesic distances, and density / expected-count / proportion outputs.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_KernelDensityProportion"
                caption="KD to Proportion Surface"
                className="KernelDensityProportionButton"
                loadOnClick="true"
                smallImage="Images\Normal_Curve_GanadoRed_16.png"
                largeImage="Images\KD_to_Proportion_32.png"
                keytip="KP">
          <tooltip heading="Kernel Density to Proportion Surface">
            Opens the Kernel Density to Proportion Surface tool from the Jenness Enterprises toolbox: converts a kernel-density raster into a volume raster (percent of volume enclosed by each cell's isopleth) ready for contouring at 50/95/99.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_KernelDensityContours"
                caption="KD Probability Contours"
                className="KernelDensityContoursButton"
                loadOnClick="true"
                smallImage="Images\Normal_Curve_DarkGreen_16.png"
                largeImage="Images\KD_Probability_Contours_32.png"
                keytip="KC">
          <tooltip heading="Kernel Density Probability Contours">
            Opens the Kernel Density Probability Contours tool from the Jenness Enterprises toolbox: generates home-range probability isopleths (5%-100%) as polylines and/or polygon areas.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_MahalanobisRaster"
                caption="Mahalanobis Distance Raster"
                className="MahalanobisRasterButton"
                loadOnClick="true"
                smallImage="Images\M1_16.png"
                largeImage="Images\M1_32.png"
                keytip="MR">
          <tooltip heading="Mahalanobis Distance Raster">
            Opens the Mahalanobis Distance Raster tool from the Jenness Enterprises toolbox: builds a per-cell raster of Mahalanobis distances from a set of landscape variables.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_MahalanobisPoints"
                caption="Mahalanobis Distance at Points"
                className="MahalanobisPointsButton"
                loadOnClick="true"
                smallImage="Images\Mvector_16.png"
                largeImage="Images\Mvector_32.png"
                keytip="MP">
          <tooltip heading="Mahalanobis Distance at Points">
            Opens the Mahalanobis at Points tool from the Jenness Enterprises toolbox: computes a Mahalanobis value at each input point from a set of landscape variables.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_MahalanobisCovariance"
                caption="Calculate Statistical Matrices"
                className="MahalanobisCovarianceButton"
                loadOnClick="true"
                smallImage="Images\Stats_16b.png"
                largeImage="Images\Stats_32.png"
                keytip="MV">
          <tooltip heading="Calculate Statistical Matrices">
            Opens the Calculate Statistical Matrices tool from the Jenness Enterprises toolbox: computes mean, covariance, inverse covariance, and correlation tables for a set of landscape variables, for reuse by the Mahalanobis Raster and at Points tools.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_MahalanobisChiSquare"
                caption="Mahalanobis Chi-Square Transform"
                className="MahalanobisChiSquareButton"
                loadOnClick="true"
                smallImage="Images\chi_square_symbol_16.png"
                largeImage="Images\chi_square_symbol_32.png"
                keytip="MC">
          <tooltip heading="Mahalanobis Distance - Chi-Square Transform">
            Opens the Chi-Square Transform tool from the Jenness Enterprises toolbox: rescales a Mahalanobis squared-distance (D2) raster to a 0-1 chi-square typicality p-value.<disabledText />
          </tooltip>
        </button>
        <tool id="WildlifeTools_CompassRoseGraphic"
                caption="Compass graphic 1"
                className="CompassRoseGraphicTool"
                loadOnClick="true"
                smallImage="Images\CompassRose_16.png"
                largeImage="Images\CompassRose_32.png"
                keytip="CG">
          <tooltip heading="Compass graphic 1">
            Adds the Jennessent Compass Rose to the active map or layout as a picture graphic. On a map, draw a box to size it; on a layout, click to place it at a default size and then resize it with the selection handles.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_CompassRoseDotGraphic"
                caption="Compass graphic 1 - dot"
                className="CompassRoseDotGraphicTool"
                loadOnClick="true"
                smallImage="Images\CompassRoseDot_16.png"
                largeImage="Images\CompassRoseDot_32.png"
                keytip="CD">
          <tooltip heading="Compass graphic 1 - dot">
            Adds the Jennessent Compass Rose with the north dot to the active map or layout as a picture graphic. On a map, draw a box to size it; on a layout, click to place it at a default size and then resize it with the selection handles.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_Compass2Graphic"
                caption="Compass graphic 2"
                className="Compass2GraphicTool"
                loadOnClick="true"
                smallImage="Images\Compass2_16.png"
                largeImage="Images\Compass2_32.png"
                keytip="C2">
          <tooltip heading="Compass graphic 2">
            Adds the Compass_2d design (black cardinal star, gray intercardinal star, twin rings) to the active map or layout as a picture graphic. On a map, draw a box to size it; on a layout, click to place it at a default size and then resize it with the selection handles.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_Compass2DotGraphic"
                caption="Compass graphic 2 - dot"
                className="Compass2DotGraphicTool"
                loadOnClick="true"
                smallImage="Images\Compass2Dot_16.png"
                largeImage="Images\Compass2Dot_32.png"
                keytip="C4">
          <tooltip heading="Compass graphic 2 - dot">
            Adds the Compass_2d design with the gradient spearhead above the north point to the active map or layout as a picture graphic. On a map, draw a box to size it; on a layout, click to place it at a default size and then resize it with the selection handles.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_CompassRoseNorthArrow"
                caption="North arrow 1"
                className="CompassRoseNorthArrowTool"
                loadOnClick="true"
                smallImage="Images\CompassRose_16.png"
                largeImage="Images\CompassRose_32.png"
                condition="esri_layouts_layoutPaneCondition"
                keytip="CN">
          <tooltip heading="North arrow 1">
            Click the active layout to add a north arrow symbolized as the Jennessent Compass Rose, tied to the layout's map frame (or unassociated if the layout has no map frame yet), then resize it with the selection handles. Available only in a layout view.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_CompassRoseDotNorthArrow"
                caption="North arrow 1 - dot"
                className="CompassRoseDotNorthArrowTool"
                loadOnClick="true"
                smallImage="Images\CompassRoseDot_16.png"
                largeImage="Images\CompassRoseDot_32.png"
                condition="esri_layouts_layoutPaneCondition"
                keytip="CO">
          <tooltip heading="North arrow 1 - dot">
            Click the active layout to add a north arrow symbolized as the Jennessent Compass Rose with the north dot, tied to the layout's map frame (or unassociated if the layout has no map frame yet), then resize it with the selection handles. Available only in a layout view.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_Compass2NorthArrow"
                caption="North arrow 2"
                className="Compass2NorthArrowTool"
                loadOnClick="true"
                smallImage="Images\Compass2_16.png"
                largeImage="Images\Compass2_32.png"
                condition="esri_layouts_layoutPaneCondition"
                keytip="N2">
          <tooltip heading="North arrow 2">
            Click the active layout to add a north arrow symbolized as the Compass_2d design (black cardinal star, gray intercardinal star, twin rings), tied to the layout's map frame (or unassociated if the layout has no map frame yet), then resize it with the selection handles. Available only in a layout view.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_Compass2DotNorthArrow"
                caption="North arrow 2 - dot"
                className="Compass2DotNorthArrowTool"
                loadOnClick="true"
                smallImage="Images\Compass2Dot_16.png"
                largeImage="Images\Compass2Dot_32.png"
                condition="esri_layouts_layoutPaneCondition"
                keytip="N4">
          <tooltip heading="North arrow 2 - dot">
            Click the active layout to add a north arrow symbolized as the Compass_2d design with the gradient spearhead above the north point, tied to the layout's map frame (or unassociated if the layout has no map frame yet), then resize it with the selection handles. Available only in a layout view.<disabledText />
          </tooltip>
        </tool>
        <button id="WildlifeTools_AddGraphicCircle"
                caption="Circle"
                className="AddGraphicCircleButton"
                loadOnClick="true"
                smallImage="Images\CircleBackground_16.png"
                largeImage="Images\CircleBackground_32.png"
                keytip="CB">
          <tooltip heading="Circle">
            Draws a circle graphic behind the selected element or elements (graphics or layout map elements), then groups the circle and the selection into a new group with the circle underneath. Opens a dialog to set the name, polygon symbology, fill and outline transparency, and radius. Works on selected elements, not on features in a dataset.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_RectangleBackground"
                caption="Rectangle"
                className="RectangleBackgroundButton"
                loadOnClick="true"
                smallImage="Images\RectangleBackground_16.png"
                largeImage="Images\RectangleBackground_32.png"
                keytip="RB">
          <tooltip heading="Rectangle">
            Draws a rectangle graphic (with optional rounded corners) behind the selected element or elements (graphics or layout map elements), then groups the rectangle and the selection into a new group with the rectangle underneath. Opens a dialog to set the name, polygon symbology, fill and outline transparency, horizontal and vertical extent, and corner rounding. Works on selected elements, not on features in a dataset.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_PolygonBackground"
                caption="Polygon"
                className="PolygonBackgroundButton"
                loadOnClick="true"
                smallImage="Images\PolygonBackground_16.png"
                largeImage="Images\PolygonBackground_32.png"
                keytip="PB">
          <tooltip heading="Polygon">
            Draws a polygon graphic that fits the actual shape of the selected element or elements — traced from each element's geometry or its symbolized shape, with an optional buffer — then groups the polygon and the selection into a new group with the polygon underneath. On a map the buffer is in map units; on a layout choose millimeters, centimeters, inches, or points. Works on selected elements, not on features in a dataset.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_McpBackground"
                caption="Minimum Convex Polygon"
                className="McpBackgroundButton"
                loadOnClick="true"
                smallImage="Images\McpBackground_16.png"
                largeImage="Images\McpBackground_32.png"
                keytip="MP">
          <tooltip heading="Minimum Convex Polygon">
            Draws a minimum convex polygon around the selected element or elements — hulled from each element's geometry or its symbolized shape, with an optional buffer — then groups the polygon and the selection into a new group with the polygon underneath. On a map the buffer is in map units; on a layout choose millimeters, centimeters, inches, or points. Works on selected elements, not on features in a dataset.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_ThoughtForTheDay"
                caption="Thought for the Day"
                className="ThoughtForTheDayButton"
                loadOnClick="true"
                smallImage="Images\Heart_16.png"
                largeImage="Images\Heart_32.png"
                keytip="TD">
          <tooltip heading="Thought for the Day">
            Shows a random inspirational quote in a little pop-up card.<disabledText />
          </tooltip>
        </button>
      </controls>
      <palettes>
        <!-- Dropdown palettes (same control Esri's Select tool uses): one face button
             on the ribbon, the four compass variants in the dropdown. -->
        <toolPalette id="WildlifeTools_AddGraphicsPalette"
                     caption="Add Graphics"
                     extendedCaption="Open the compass graphics tool palette"
                     itemsInRow="1"
                     showItemCaption="true"
                     keytip="AG"
                     smallImage="Images\CompassRoseDot_16.png"
                     largeImage="Images\CompassRoseDot_32.png">
          <tool refID="WildlifeTools_CompassRoseGraphic" />
          <tool refID="WildlifeTools_CompassRoseDotGraphic" />
          <tool refID="WildlifeTools_Compass2Graphic" />
          <tool refID="WildlifeTools_Compass2DotGraphic" />
        </toolPalette>
        <toolPalette id="WildlifeTools_GraphicBackgroundsPalette"
                     caption="Graphic Backgrounds"
                     extendedCaption="Open the graphic background tool palette"
                     itemsInRow="1"
                     showItemCaption="true"
                     keytip="GB"
                     smallImage="Images\CircleBackground_16.png"
                     largeImage="Images\CircleBackground_32.png">
          <button refID="WildlifeTools_AddGraphicCircle" />
          <button refID="WildlifeTools_RectangleBackground" />
          <button refID="WildlifeTools_PolygonBackground" />
          <button refID="WildlifeTools_McpBackground" />
        </toolPalette>
        <toolPalette id="WildlifeTools_NorthArrowsPalette"
                     caption="North Arrows"
                     extendedCaption="Open the compass north arrow tool palette"
                     itemsInRow="1"
                     showItemCaption="true"
                     keytip="NA"
                     condition="esri_layouts_layoutPaneCondition"
                     smallImage="Images\CompassRoseDot_16.png"
                     largeImage="Images\CompassRoseDot_32.png">
          <tool refID="WildlifeTools_CompassRoseNorthArrow" />
          <tool refID="WildlifeTools_CompassRoseDotNorthArrow" />
          <tool refID="WildlifeTools_Compass2NorthArrow" />
          <tool refID="WildlifeTools_Compass2DotNorthArrow" />
        </toolPalette>
      </palettes>

    </insertModule>
  </modules>
</ArcGIS>
