<?xml version="1.0" encoding="utf-8" ?>
<ArcGIS defaultAssembly="WildlifeTools.dll"
        defaultNamespace="WildlifeTools"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">

  <AddInInfo id="{9b04581c-dbfe-4025-8713-1cd30b3b1e47}" version="1.99.34" desktopVersion="3.7.1901" product="ArcGISPro">
    <Name>Wildlife and Forestry Tools</Name>
    <Description>Wildlife and forestry analysis tools for ArcGIS Pro, ported from the legacy ArcMap VB6 tools.</Description>
    <Image>Images\JennessLogo32.png</Image>
    <Author>Jeff Jenness</Author>
    <Company>Jenness Enterprises</Company>
    <Date>9/10/2026 8:42:22 PM</Date>
    <Subject>Framework, Geometry, Geoprocessing</Subject>
    <!-- Note subject can be one or more of these topics:
                    Content, Framework, Editing, Geodatabase, Geometry, Geoprocessing, Layouts, Map Authoring, Map Exploration -->
  </AddInInfo>

  <modules>
    <insertModule id="WildlifeTools_Module" className="Module1" autoLoad="true" caption="Wildlife and Forestry Tools">
      <tabs>
        <tab id="WildlifeTools_Tab1" caption="Wildlife and Forestry">
          <group refID="WildlifeTools_Group1"/>
          <group refID="WildlifeTools_GroupTopo"/>
          <group refID="WildlifeTools_GroupCorridor"/>
          <group refID="WildlifeTools_GroupEcological"/>
          <group refID="WildlifeTools_GroupGeometric"/>
          <group refID="WildlifeTools_GroupData"/>
          <group refID="WildlifeTools_GroupDirectional"/>
          <group refID="WildlifeTools_GroupCartography"/>
          <group refID="WildlifeTools_GroupBreak"/>
        </tab>
      </tabs>

      <groups>
        <group id="WildlifeTools_Group1" caption="Home Range" appearsOnAddInTab="false" sizePriorities="25,125,225" largeImage="Images\LoCoH_32.png" smallImage="Images\LoCoH_32.png">
          <!-- The gallery sits DIRECTLY in the group with no size attr,
               mirroring Esri's own Analysis > Tools gallery
               (esri_geoprocessing_ToolsGallery); placing it in a sized
               subgroup inflated the whole ribbon row. -->
          <gallery refID="WildlifeTools_HomeRangeGallery" inline="true" />
        </group>
        <!-- WildlifeTools_GroupGraphics retired 2026-08-29: merged into the
             Cartography group (gallery rows + the two placement palettes). -->
        <group id="WildlifeTools_GroupCartography" caption="Cartography" appearsOnAddInTab="false" sizePriorities="25,125,225" largeImage="Images\CompassRose_32.png" smallImage="Images\CompassRose_32.png">
          <gallery refID="WildlifeTools_CartographyGallery" inline="true" />
          <toolPalette refID="WildlifeTools_AddGraphicsPalette" size="large" />
          <toolPalette refID="WildlifeTools_NorthArrowsPalette" size="large" />
        </group>
        <group id="WildlifeTools_GroupEcological" caption="Ecological Analysis" appearsOnAddInTab="false" sizePriorities="25,125,225" largeImage="Images\ClassificationAccuracy_32.png" smallImage="Images\ClassificationAccuracy_32.png">
          <gallery refID="WildlifeTools_EcologicalGallery" inline="true" />
        </group>
        <group id="WildlifeTools_GroupTopo" caption="Topographic Analysis" appearsOnAddInTab="false" sizePriorities="25,125,225" largeImage="Images\TRI_32.png" smallImage="Images\TRI_32.png">
          <gallery refID="WildlifeTools_TopographicGallery" inline="true" />
        </group>
        <group id="WildlifeTools_GroupDirectional" caption="Terrain Graphs" appearsOnAddInTab="false" sizePriorities="25,125,225" largeImage="Images\PolarPlot_32.png" smallImage="Images\PolarPlot_32.png">
          <subgroup refID="WildlifeTools_SubDirectional" />
        </group>
        <group id="WildlifeTools_GroupCorridor" caption="Corridor Designer Tools" appearsOnAddInTab="false" sizePriorities="25,125,225" largeImage="Images\LandFacet_32.png" smallImage="Images\LandFacet_32.png">
          <gallery refID="WildlifeTools_CorridorDesignerGallery" inline="true" />
          <button refID="WildlifeTools_LandFacetDescribe" size="large" />
        </group>
        <group id="WildlifeTools_GroupData" caption="Data Tools" appearsOnAddInTab="false" sizePriorities="25,125,225" largeImage="Images\FavoriteData_32.png" smallImage="Images\FavoriteData_32.png">
          <subgroup refID="WildlifeTools_SubData" />
        </group>
        <group id="WildlifeTools_GroupGeometric" caption="Geometric Tools" appearsOnAddInTab="false" sizePriorities="25,125,225" largeImage="Images\Voronoi_32.png" smallImage="Images\Voronoi_32.png">
          <gallery refID="WildlifeTools_GeometricGallery" inline="true" />
        </group>
        <group id="WildlifeTools_GroupBreak" caption="Take a Break" appearsOnAddInTab="false" sizePriorities="25,125,225" largeImage="Images\Sudoku_32.png" smallImage="Images\Sudoku_32.png">
          <subgroup refID="WildlifeTools_SubBreak" />
        </group>
      </groups>
      <subgroups>
        <!-- One subgroup per group so the ribbon can DEMOTE the buttons (large
             -> captioned small icons) as the window narrows, BEFORE the group
             collapses to its single chunk; without subgroups the only shrink
             the framework can perform is the collapse itself. -->
        <!-- WildlifeTools_SubHomeRange retired 2026-08-29: the Home Range
             group now hosts its gallery directly (see the group above). -->
        <!-- WildlifeTools_SubGraphics and WildlifeTools_SubCartography retired
             2026-08-29: the merged Cartography group hosts its gallery and the
             two placement palettes directly. -->
        <!-- WildlifeTools_SubTopo retired 2026-08-29: the Topographic Analysis group now hosts its gallery directly. -->
        <!-- WildlifeTools_SubCorridor retired 2026-08-29: the Corridor Designer group now hosts its gallery directly, with the Data Report button beside it. -->
        <subgroup id="WildlifeTools_SubDirectional" size="LargeThenMediumWhenMedium">

          <button refID="WildlifeTools_PolarPlots" size="large" />
          <button refID="WildlifeTools_SlopeGraphic" size="large" />
        </subgroup>
        <subgroup id="WildlifeTools_SubData" size="LargeThenMediumWhenMedium">

          <button refID="WildlifeTools_FavoriteDatasets" size="large" />
          <button refID="WildlifeTools_AttributeSummary" size="large" />
          <button refID="WildlifeTools_SelectRandom" size="large" />
        </subgroup>
        <!-- WildlifeTools_SubGeometric retired 2026-08-29: the Geometric Tools group now hosts its gallery directly. -->
        <subgroup id="WildlifeTools_SubBreak" size="LargeThenMediumWhenMedium">
          <button refID="WildlifeTools_ThoughtForTheDay" size="large" />
          <button refID="WildlifeTools_Sudoku" size="large" />
          <button refID="WildlifeTools_SlidingPuzzle" size="large" />
          <button refID="WildlifeTools_EasterEgg" size="large" />
        </subgroup>
      </subgroups>


      <controls>
        <button id="WildlifeTools_LoCoHStandard"
                caption="LoCoH (Standard)"
                className="LoCoHStandardButton"
                loadOnClick="true"
                smallImage="Images\LoCoH_16.png"
                largeImage="Images\LoCoH_32.png"
                keytip="LC">
          <tooltip heading="Local Convex Hull (LoCoH) - Standard">
            Opens the Standard (k-) Local Convex Hull home-range tool from the Jenness Enterprises toolbox.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_LoCoHAdaptive"
                caption="LoCoH (Adaptive)"
                className="LoCoHAdaptiveButton"
                loadOnClick="true"
                smallImage="Images\LoCoH_a_16.png"
                largeImage="Images\LoCoH_a_32.png"
                keytip="LA">
          <tooltip heading="Local Convex Hull (LoCoH) - Adaptive">
            Opens the Adaptive (a-) Local Convex Hull home-range tool from the Jenness Enterprises toolbox.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_LoCoHFixedSphere"
                caption="LoCoH (Fixed Sphere)"
                className="LoCoHFixedSphereButton"
                loadOnClick="true"
                smallImage="Images\LoCoH_r_16.png"
                largeImage="Images\LoCoH_r_32.png"
                keytip="LF">
          <tooltip heading="Local Convex Hull (LoCoH) - Fixed Sphere">
            Opens the Fixed-sphere-of-influence (r-) Local Convex Hull home-range tool from the Jenness Enterprises toolbox.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_LocohParameterExplorer"
                caption="LoCoH Parameter Explorer"
                className="LocohParameterButton"
                loadOnClick="true"
                smallImage="Images\LocohExplorer_16.png"
                largeImage="Images\LocohExplorer_32.png"
                keytip="LE">
          <tooltip heading="LoCoH Parameter Explorer">
            Charts the 50 / 75 / 95 percent isopleth areas across a sweep of k, a or r values for a point layer -- the Getz et al. (2007) leveling-off analysis for choosing the LoCoH parameter, with the published starting heuristic marked.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_KernelDensityGenerate"
                caption="Kernel Density Enhanced"
                className="KernelDensityGenerateButton"
                loadOnClick="true"
                smallImage="Images\Normal_Curve_DarkBlue_16.png"
                largeImage="Images\Kernel_Density_Enhanced_32.png"
                keytip="KD">
          <tooltip heading="Kernel Density Enhanced">
            Opens the Kernel Density Enhanced tool from the Jenness Enterprises toolbox: a custom kernel-density surface from points, with selectable kernel shapes, planar/geodesic distances, and density / expected-count / proportion outputs.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_KernelDensityProportion"
                caption="KD to Proportion Surface"
                className="KernelDensityProportionButton"
                loadOnClick="true"
                smallImage="Images\Normal_Curve_GanadoRed_16.png"
                largeImage="Images\KD_to_Proportion_32.png"
                keytip="KP">
          <tooltip heading="Kernel Density to Proportion Surface">
            Opens the Kernel Density to Proportion Surface tool from the Jenness Enterprises toolbox: converts a kernel-density raster into a volume raster (percent of volume enclosed by each cell's isopleth) ready for contouring at 50/95/99.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_KernelDensityContours"
                caption="KD Probability Contours"
                className="KernelDensityContoursButton"
                loadOnClick="true"
                smallImage="Images\Normal_Curve_DarkGreen_16.png"
                largeImage="Images\KD_Probability_Contours_32.png"
                keytip="KC">
          <tooltip heading="Kernel Density Probability Contours">
            Opens the Kernel Density Probability Contours tool from the Jenness Enterprises toolbox: generates home-range probability isopleths (5%-100%) as polylines and/or polygon areas.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_MahalanobisRaster"
                caption="Mahalanobis Distance Raster"
                className="MahalanobisRasterButton"
                loadOnClick="true"
                smallImage="Images\M1_16.png"
                largeImage="Images\M1_32.png"
                keytip="MR">
          <tooltip heading="Mahalanobis Distance Raster">
            Opens the Mahalanobis Distance Raster tool from the Jenness Enterprises toolbox: builds a per-cell raster of Mahalanobis distances from a set of landscape variables.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_MahalanobisPoints"
                caption="Mahalanobis Distance at Points"
                className="MahalanobisPointsButton"
                loadOnClick="true"
                smallImage="Images\Mvector_16.png"
                largeImage="Images\Mvector_32.png"
                keytip="MP">
          <tooltip heading="Mahalanobis Distance at Points">
            Opens the Mahalanobis at Points tool from the Jenness Enterprises toolbox: computes a Mahalanobis value at each input point from a set of landscape variables.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_MahalanobisCovariance"
                caption="Calculate Statistical Matrices"
                className="MahalanobisCovarianceButton"
                loadOnClick="true"
                smallImage="Images\Stats_16b.png"
                largeImage="Images\Stats_32.png"
                keytip="MV">
          <tooltip heading="Calculate Statistical Matrices">
            Opens the Calculate Statistical Matrices tool from the Jenness Enterprises toolbox: computes mean, covariance, inverse covariance, and correlation tables for a set of landscape variables, for reuse by the Mahalanobis Raster and at Points tools.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_MahalanobisChiSquare"
                caption="Mahalanobis Chi-Square Transform"
                className="MahalanobisChiSquareButton"
                loadOnClick="true"
                smallImage="Images\chi_square_symbol_16.png"
                largeImage="Images\chi_square_symbol_32.png"
                keytip="MC">
          <tooltip heading="Mahalanobis Distance - Chi-Square Transform">
            Opens the Chi-Square Transform tool from the Jenness Enterprises toolbox: rescales a Mahalanobis squared-distance (D2) raster to a 0-1 chi-square typicality p-value.<disabledText />
          </tooltip>
        </button>
        <tool id="WildlifeTools_CompassRoseGraphic"
                caption="Compass graphic 1"
                className="CompassRoseGraphicTool"
                loadOnClick="true"
                smallImage="Images\CompassRose_16.png"
                largeImage="Images\CompassRose_32.png"
                keytip="CG">
          <tooltip heading="Compass graphic 1">
            Adds the Jennessent Compass Rose to the active map or layout as a picture graphic. On a map, draw a box to size it; on a layout, click to place it at a default size and then resize it with the selection handles.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_CompassRoseDotGraphic"
                caption="Compass graphic 1 - dot"
                className="CompassRoseDotGraphicTool"
                loadOnClick="true"
                smallImage="Images\CompassRoseDot_16.png"
                largeImage="Images\CompassRoseDot_32.png"
                keytip="CD">
          <tooltip heading="Compass graphic 1 - dot">
            Adds the Jennessent Compass Rose with the north dot to the active map or layout as a picture graphic. On a map, draw a box to size it; on a layout, click to place it at a default size and then resize it with the selection handles.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_Compass2Graphic"
                caption="Compass graphic 2"
                className="Compass2GraphicTool"
                loadOnClick="true"
                smallImage="Images\Compass2_16.png"
                largeImage="Images\Compass2_32.png"
                keytip="C2">
          <tooltip heading="Compass graphic 2">
            Adds the Compass_2d design (black cardinal star, gray intercardinal star, twin rings) to the active map or layout as a picture graphic. On a map, draw a box to size it; on a layout, click to place it at a default size and then resize it with the selection handles.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_Compass2DotGraphic"
                caption="Compass graphic 2 - dot"
                className="Compass2DotGraphicTool"
                loadOnClick="true"
                smallImage="Images\Compass2Dot_16.png"
                largeImage="Images\Compass2Dot_32.png"
                keytip="C4">
          <tooltip heading="Compass graphic 2 - dot">
            Adds the Compass_2d design with the gradient spearhead above the north point to the active map or layout as a picture graphic. On a map, draw a box to size it; on a layout, click to place it at a default size and then resize it with the selection handles.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_CompassRoseNorthArrow"
                caption="North arrow 1"
                className="CompassRoseNorthArrowTool"
                loadOnClick="true"
                smallImage="Images\CompassRose_16.png"
                largeImage="Images\CompassRose_32.png"
                condition="esri_layouts_layoutPaneCondition"
                keytip="CN">
          <tooltip heading="North arrow 1">
            Click the active layout to add a north arrow symbolized as the Jennessent Compass Rose, tied to the layout's map frame (or unassociated if the layout has no map frame yet), then resize it with the selection handles. Available only in a layout view.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_CompassRoseDotNorthArrow"
                caption="North arrow 1 - dot"
                className="CompassRoseDotNorthArrowTool"
                loadOnClick="true"
                smallImage="Images\CompassRoseDot_16.png"
                largeImage="Images\CompassRoseDot_32.png"
                condition="esri_layouts_layoutPaneCondition"
                keytip="CO">
          <tooltip heading="North arrow 1 - dot">
            Click the active layout to add a north arrow symbolized as the Jennessent Compass Rose with the north dot, tied to the layout's map frame (or unassociated if the layout has no map frame yet), then resize it with the selection handles. Available only in a layout view.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_Compass2NorthArrow"
                caption="North arrow 2"
                className="Compass2NorthArrowTool"
                loadOnClick="true"
                smallImage="Images\Compass2_16.png"
                largeImage="Images\Compass2_32.png"
                condition="esri_layouts_layoutPaneCondition"
                keytip="N2">
          <tooltip heading="North arrow 2">
            Click the active layout to add a north arrow symbolized as the Compass_2d design (black cardinal star, gray intercardinal star, twin rings), tied to the layout's map frame (or unassociated if the layout has no map frame yet), then resize it with the selection handles. Available only in a layout view.<disabledText />
          </tooltip>
        </tool>
        <tool id="WildlifeTools_Compass2DotNorthArrow"
                caption="North arrow 2 - dot"
                className="Compass2DotNorthArrowTool"
                loadOnClick="true"
                smallImage="Images\Compass2Dot_16.png"
                largeImage="Images\Compass2Dot_32.png"
                condition="esri_layouts_layoutPaneCondition"
                keytip="N4">
          <tooltip heading="North arrow 2 - dot">
            Click the active layout to add a north arrow symbolized as the Compass_2d design with the gradient spearhead above the north point, tied to the layout's map frame (or unassociated if the layout has no map frame yet), then resize it with the selection handles. Available only in a layout view.<disabledText />
          </tooltip>
        </tool>
        <button id="WildlifeTools_AddGraphicCircle"
                caption="Circle"
                className="AddGraphicCircleButton"
                loadOnClick="true"
                smallImage="Images\CircleBackground_16.png"
                largeImage="Images\CircleBackground_32.png"
                keytip="CB">
          <tooltip heading="Circle">
            Draws a circle graphic behind the selected element or elements (graphics or layout map elements), then groups the circle and the selection into a new group with the circle underneath. Opens a dialog to set the name, polygon symbology, fill and outline transparency, and radius. Works on selected elements, not on features in a dataset.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_RectangleBackground"
                caption="Rectangle"
                className="RectangleBackgroundButton"
                loadOnClick="true"
                smallImage="Images\RectangleBackground_16.png"
                largeImage="Images\RectangleBackground_32.png"
                keytip="RB">
          <tooltip heading="Rectangle">
            Draws a rectangle graphic (with optional rounded corners) behind the selected element or elements (graphics or layout map elements), then groups the rectangle and the selection into a new group with the rectangle underneath. Opens a dialog to set the name, polygon symbology, fill and outline transparency, horizontal and vertical extent, and corner rounding. Works on selected elements, not on features in a dataset.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_PolygonBackground"
                caption="Polygon"
                className="PolygonBackgroundButton"
                loadOnClick="true"
                smallImage="Images\PolygonBackground_16.png"
                largeImage="Images\PolygonBackground_32.png"
                keytip="PB">
          <tooltip heading="Polygon">
            Draws a polygon graphic that fits the actual shape of the selected element or elements â€” traced from each element's geometry or its symbolized shape, with an optional buffer â€” then groups the polygon and the selection into a new group with the polygon underneath. On a map the buffer is in map units; on a layout choose millimeters, centimeters, inches, or points. Works on selected elements, not on features in a dataset.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_McpBackground"
                caption="Minimum Convex Polygon"
                className="McpBackgroundButton"
                loadOnClick="true"
                smallImage="Images\McpBackground_16.png"
                largeImage="Images\McpBackground_32.png"
                keytip="MB">
          <tooltip heading="Minimum Convex Polygon">
            Draws a minimum convex polygon around the selected element or elements â€” hulled from each element's geometry or its symbolized shape, with an optional buffer â€” then groups the polygon and the selection into a new group with the polygon underneath. On a map the buffer is in map units; on a layout choose millimeters, centimeters, inches, or points. Works on selected elements, not on features in a dataset.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_RemoveSlc"
                caption="Remove SLC"
                className="RemoveSlcButton"
                loadOnClick="true"
                smallImage="Images\RemoveSLC_16.png"
                largeImage="Images\RemoveSLC_32.png"
                condition="esri_layouts_layoutPaneCondition"
                keytip="RS">
          <tooltip heading="Remove SLC">
            Moves Esri's Service Layer Credits text out of the map frame by adding a Service Layer Credits dynamic text element parked below the layout page (top edge half an inch below the page bottom, left edge flush with the page), where it never prints. If the layout already has one, it is moved there instead. Available only in a layout view.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_ShadowPolygons"
                caption="Create Shadow Polygons"
                className="ShadowPolygonsButton"
                loadOnClick="true"
                smallImage="Images\ShadowPolygons_16.png"
                largeImage="Images\ShadowPolygons_32.png"
                keytip="SP">
          <tooltip heading="Create Shadow Polygons">
            Opens the Create Shadow Polygons tool from the Jenness Enterprises toolbox: concentric ring buffers around the dissolved polygons of a feature class, with a Transparency attribute that fades outward for a soft black cartographic shadow. Also available in the Cartography Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_EnhancedHillshade"
                caption="Enhanced Hillshade"
                className="EnhancedHillshadeButton"
                loadOnClick="true"
                smallImage="Images\EnhancedHillshade_16.png"
                largeImage="Images\EnhancedHillshade_32.png"
                keytip="EH">
          <tooltip heading="Enhanced Hillshade">
            Opens the Enhanced Hillshade tool from the Jenness Enterprises toolbox: a hillshade that is accurate on geographic (lat/long) DEMs via per-row spheroidal cell dimensions, with hillshade levels, hypsometric shading, vertical exaggeration, and optional modeled cast shadows. Also available in the Cartography Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_MDOWHillshade"
                caption="MDOW Hillshade"
                className="MDOWHillshadeButton"
                loadOnClick="true"
                smallImage="Images\MDOWHillshade_16.png"
                largeImage="Images\MDOWHillshade_32.png"
                keytip="MH">
          <tooltip heading="MDOW Hillshade">
            Opens the MDOW (Multi-Directional Oblique-Weighted) Hillshade tool from the Jenness Enterprises toolbox: blends four sun directions fanned around the primary illumination direction, weighted so every slope is lit obliquely - revealing terrain that a single-direction hillshade washes out (Mark 1992). Accurate on geographic (lat/long) DEMs via per-row spheroidal cell dimensions. Also available in the Cartography Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_MultiSunHillshade"
                caption="Multi-Sun Hillshade"
                className="MultiSunHillshadeButton"
                loadOnClick="true"
                smallImage="Images\MultiSunHillshade_16.png"
                largeImage="Images\MultiSunHillshade_32.png"
                keytip="MS">
          <tooltip heading="Multi-Sun Hillshade">
            Opens the Multi-Sun Hillshade tool from the Jenness Enterprises toolbox: a weighted average of standard hillshades from two to eight sun positions, each with its own azimuth, inclination, and weight - the classic Swiss multiple-light-source strategy for bringing out terrain a single sun washes out. Optional per-sun cast shadows and hypsometric shading; accurate on geographic (lat/long) DEMs. Also available in the Cartography Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_BlurredHillshade"
                caption="Blurred Hillshade"
                className="BlurredHillshadeButton"
                loadOnClick="true"
                smallImage="Images\BlurredHillshade_16.png"
                largeImage="Images\BlurredHillshade_32.png"
                keytip="BH">
          <tooltip heading="Blurred Hillshade">
            Opens the Blurred Hillshade tool from the Jenness Enterprises toolbox: a deliberately softened hillshade - the blurring component of the classic Swiss method - that de-emphasizes small terrain features so the shading reads as subtle and less distracting. Blur the DEM before shading or the finished hillshade after, with a radius in cells or ground units (sized geodesically on lat/long DEMs). All Enhanced Hillshade options included. Also available in the Cartography Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SurfaceAreaRatio"
                caption="Surface Area and Ratio"
                className="SurfaceAreaRatioButton"
                loadOnClick="true"
                smallImage="Images\SurfaceArea_16.png"
                largeImage="Images\SurfaceArea_32.png"
                keytip="SA">
          <tooltip heading="Surface Area and Ratio">
            Opens the Surface Area and Ratio tool from the Jenness Enterprises toolbox: the 8-triangle surface-area method of Jenness (2004, Wildlife Society Bulletin 32:829-839). Outputs any combination of 3D surface area, surface ratio (a roughness index), and planimetric cell area; correct on geographic (lat/long) DEMs via per-row spheroidal distances and cell areas so the cell size appropriately changes with latitude. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_VRM"
                caption="Vector Ruggedness Measure (VRM)"
                className="VRMButton"
                loadOnClick="true"
                smallImage="Images\VRM_16.png"
                largeImage="Images\VRM_32.png"
                keytip="VR">
          <tooltip heading="Vector Ruggedness Measure (VRM)">
            Opens the VRM tool from the Jenness Enterprises toolbox: a topographic roughness index (Sappington et al. 2007) measuring the 3D dispersion of unit vectors orthogonal to the terrain surface within a neighborhood of each cell - the spherical analog of circular variance (Fisher 1993). Distinguishes steep-but-even terrain from steep, broken terrain; correct on geographic (lat/long) DEMs. Optionally remove the smooth underlying topography first (Dilts et al. 2023) for a fine-scale local roughness map (VRM-L). Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_ACR"
                caption="Arc-Chord Ratio (ACR)"
                className="ACRButton"
                loadOnClick="true"
                smallImage="Images\ACR_16.png"
                largeImage="Images\ACR_32.png"
                keytip="AC">
          <tooltip heading="Arc-Chord Ratio (ACR)">
            Opens the Arc-Chord Ratio tool from the Jenness Enterprises toolbox: a surface-roughness (rugosity) index decoupled from slope (Du Preez 2015) - each cell's 3D surface area divided by the area of its plane of best fit, equivalently the Jenness (2004) surface ratio times the cosine of the 3x3 best-fit-plane slope. A smooth tilted surface has ACR = 1, so larger values reflect genuine roughness rather than steepness. Optionally remove the smooth underlying topography first (Dilts et al. 2023) for a fine-scale local roughness map (ACR-L). Correct on geographic (lat/long) DEMs. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_FractalDimension"
                caption="Fractal Dimension"
                className="FractalDimensionButton"
                loadOnClick="true"
                smallImage="Images\FD_16.png"
                largeImage="Images\FD_32.png"
                keytip="FD">
          <tooltip heading="Fractal Dimension (surface roughness)">
            Opens the Fractal Dimension tool from the Jenness Enterprises toolbox: the local fractal dimension of the terrain surface (D from 2 for smooth to 3 for maximally rough), computed in a moving window by a selectable method -- triangular prism (Clarke 1986; Ju and Lam 2009), variogram or madogram (Gneiting, Sevcikova, and Percival 2012; their R package fractaldim), or differential box counting (Sarkar and Chaudhuri 1994). Like VRM, it is independent of overall slope, measuring how roughness varies across scales. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_TRI"
                caption="Terrain Ruggedness Index (TRI)"
                className="TRIButton"
                loadOnClick="true"
                smallImage="Images\TRI_16.png"
                largeImage="Images\TRI_32.png"
                keytip="TR">
          <tooltip heading="Terrain Ruggedness Index (TRI)">
            Opens the TRI tool from the Jenness Enterprises toolbox: a neighborhood terrain-ruggedness index with four selectable methods -- the root of summed squared differences (Riley, DeGloria, and Elliot 1999), the mean absolute difference (Wilson et al. 2007), a slope (distance-weighted) variant that corrects for diagonal neighbors being farther away, or the standard deviation of the neighborhood elevations. Different methods capture different notions of ruggedness. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_TopographyAlongLines"
                caption="Topography along Lines"
                className="TopographyAlongLinesButton"
                loadOnClick="true"
                smallImage="Images\TopoLines_16.png"
                largeImage="Images\TopoLines_32.png"
                keytip="TL">
          <tooltip heading="Topography along Lines">
            Opens the Topography along Lines tool from the Jenness Enterprises toolbox: it adds attribute fields describing the topography along each line of a polyline feature class -- planimetric and surface length, surface ratio, uphill/downhill and slope statistics, direction statistics (mean direction, circular and angular variance), sinuosity, fractal dimension, and more. Elevation comes from the polylines' own Z values or is sampled from a DEM by bilinear interpolation at a regular ground interval; each line is reduced to straight 3D segments. Direction-dependent statistics describe the line in the direction of its geometry (first vertex to last). Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SplitLinesIntoSegments"
                caption="Split Lines into Topography Segments"
                className="SplitLinesIntoSegmentsButton"
                loadOnClick="true"
                smallImage="Images\SplitSeg_16.png"
                largeImage="Images\SplitSeg_32.png"
                keytip="SS">
          <tooltip heading="Split Lines into Topography Segments">
            Opens the Split Lines into Topography Segments tool from the Jenness Enterprises toolbox: it converts each polyline into a new PolylineZ feature class with one true 3D feature per straight segment (sampled from the polylines' own Z values or a DEM, keeping the original vertices). Each segment can carry optional attributes -- start/end coordinates, planimetric and surface length, slope, bearing, deflection/inclination/3D-deflection angles, and more -- and you may copy any fields from the source table. The output displays in space in a Scene, and is symbolized with Unclassed Colors. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_LSRIOnDEM"
                caption="LSRI on DEM"
                className="LSRIOnDEMButton"
                loadOnClick="true"
                smallImage="Images\LSRI_DEM_16.png"
                largeImage="Images\LSRI_DEM_32.png"
                keytip="LD">
          <tooltip heading="LSRI on DEM (Land Surface Ruggedness Index)">
            Opens the LSRI on DEM tool from the Jenness Enterprises toolbox: the Land Surface Ruggedness Index (Beasom, Wiggers, and Giardino 1983), computed directly from a DEM by generating unsmoothed contours on the fly (same interval/base/z-factor logic as Esri's Contour tool) and measuring total contour length within a circular neighborhood of each cell. Similar in spirit to Esri's Line Density tool, but reports total length rather than density. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_LSRIOnContourPolylines"
                caption="LSRI on Contours"
                className="LSRIOnContourPolylinesButton"
                loadOnClick="true"
                smallImage="Images\LSRI_Contours_16.png"
                largeImage="Images\LSRI_Contours_32.png"
                keytip="LP">
          <tooltip heading="LSRI on Contours (Land Surface Ruggedness Index)">
            Opens the LSRI on Contours tool from the Jenness Enterprises toolbox: the Land Surface Ruggedness Index (Beasom, Wiggers, and Giardino 1983), computed directly from an existing contour (or any polyline) feature class by measuring total line length within a circular neighborhood of each cell. Honors the input's current selection. Similar in spirit to Esri's Line Density tool, but reports total length rather than density. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_TopographicWetnessIndex"
                caption="Topographic Wetness Index"
                className="TWIButton"
                loadOnClick="true"
                smallImage="Images\TWI_16.png"
                largeImage="Images\TWI_32.png"
                keytip="TW">
          <tooltip heading="Topographic Wetness Index (TWI / CTI)">
            Opens the Topographic Wetness Index tool from the Jenness Enterprises toolbox: TWI (also called the Compound Topographic Index) = ln( specific catchment area / (tan(slope) + epsilon) ), marking cells with large upslope area and/or gentle slope (wet valley bottoms and convergence zones) versus dry ridges and steep, diverging slopes (Beven and Kirkby 1979). Sink filling (priority-flood; Barnes, Lehman, and Mulla 2014), D8 flow direction (O'Callaghan and Mark 1984), and flow accumulation are computed internally -- no Spatial Analyst required -- or you can supply a pre-filled DEM and/or flow-accumulation raster. Slope comes from the original DEM. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_AspectTransformation"
                caption="Aspect Transformation"
                className="AspectTransformationButton"
                loadOnClick="true"
                smallImage="Images\AspectTrans_16.png"
                largeImage="Images\AspectTrans_32.png"
                keytip="AX">
          <tooltip heading="Aspect Transformation">
            Opens the Aspect Transformation tool from the Jenness Enterprises toolbox: generate one or more transformations of an aspect raster at once. Directional reclassifications assign each cell a named direction class (North/South, East/West, the four or eight cardinal and intercardinal directions) written to a Class attribute table. Trigonometric transforms produce continuous rasters: northness (cosine of aspect), eastness (sine), a trigonometric deviation from a chosen bearing (1 toward, -1 away; Trimble and Weitzman 1956, Beers et al. 1966), or a numeric deviation in degrees (0-180; Jenness 2015). Flat cells (aspect -1) can be kept as a Flat class / -1 or set to NoData. D-infinity flow-direction rasters are supported via a convention toggle. No Spatial Analyst required. Also available in the Aspect Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_AspectZonalStatistics"
                caption="Aspect Zonal Statistics as Table"
                className="AspectZonalStatisticsButton"
                loadOnClick="true"
                smallImage="Images\AspectZonal_16.png"
                largeImage="Images\AspectZonal_32.png"
                keytip="AZ">
          <tooltip heading="Aspect Zonal Statistics as Table">
            Opens the Aspect Zonal Statistics as Table tool from the Jenness Enterprises toolbox: summarizes an aspect raster per zone into a table of CIRCULAR statistics (mean direction, mean resultant length, circular variance and SD, median direction, circular range, von Mises concentration, Rayleigh test, and the 95% CI of the mean direction). Very similar to Esri's Zonal Statistics as Table, but built for aspect -- a circular variable where the ordinary zonal MEAN and STD are wrong -- and it requires no Spatial Analyst or Image Analyst extension. Zones come from an integer raster or point / polyline / polygon features; overlapping features in different zones are each analyzed in full. Point zones use bilinear weighted-mean-direction interpolation. Flat cells (aspect -1) are excluded from the statistics and counted per zone. D-infinity rasters are supported via a convention toggle that defaults from the raster's geoprocessing history. Also available in the Aspect Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SlopeZonalStatistics"
                caption="Slope Zonal Statistics as Table"
                className="SlopeZonalStatisticsButton"
                loadOnClick="true"
                smallImage="Images\SlopeZonal_16.png"
                largeImage="Images\SlopeZonal_32.png"
                keytip="SZ">
          <tooltip heading="Slope Zonal Statistics as Table">
            Opens the Slope Zonal Statistics as Table tool from the Jenness Enterprises toolbox: summarizes a slope raster per zone into a table (count, mean, median, standard deviation, min, max, range, 5th/95th percentiles, and the 95% confidence interval of the mean). Very similar to Esriâ€™s Zonal Statistics as Table, but built for slope -- the mean, SD and CI are computed on the slope ANGLES, because percent slope is the tangent of the angle and averaging raw percent values biases steepness statistics high -- and it requires no Spatial Analyst or Image Analyst extension. Slope units (degrees, percent, rise:run, gradians) default automatically from the rasterâ€™s geoprocessing history; results are reported in the source unit. Negative slopes can be treated as positive (absolute steepness) or keep their sign so downhill balances uphill. Zones come from an integer raster or point / polyline / polygon features; overlapping features in different zones are each analyzed in full. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_ExtractAspectValuesToPoints"
                caption="Extract Aspect Values to Points"
                className="ExtractAspectValuesToPointsButton"
                loadOnClick="true"
                smallImage="Images\AspectPoint_16.png"
                largeImage="Images\AspectPoint_32.png"
                keytip="AP">
          <tooltip heading="Extract Aspect Values to Points">
            Opens the Extract Aspect Values to Points tool from the Jenness Enterprises toolbox: copies the input points and adds a field holding the aspect at each point, extracted from an aspect raster -- like Esri's Extract Values to Points, but built for aspect. The optional interpolation is a bilinear WEIGHTED MEAN DIRECTION (circular), never a linear average, so directions near north interpolate correctly (359 and 1 give ~0, not 180). Flat cells (aspect -1) are excluded from interpolation; all-flat neighbors give -1. D-infinity flow-direction rasters are supported via a convention toggle. No Spatial Analyst required. Also available in the Aspect Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_AspectFocalStatistics"
                caption="Aspect Focal Statistics"
                className="AspectFocalStatisticsButton"
                loadOnClick="true"
                smallImage="Images\Aspect_16.png"
                largeImage="Images\Aspect_32.png"
                keytip="AF">
          <tooltip heading="Aspect Focal Statistics">
            Opens the Aspect Focal Statistics tool from the Jenness Enterprises toolbox: neighborhood (focal) statistics for an aspect raster computed with CIRCULAR statistics. Aspect is a circular variable (0 and 360 degrees are the same direction), so ordinary Focal Statistics is invalid; this tool offers circular measures of central tendency and dispersion (mean direction, circular variance, standard deviation, resultant length, range, Rayleigh test, von Mises concentration, and more) over any neighborhood shape, on projected or geographic aspect rasters, with no Spatial Analyst. Flat cells (aspect -1) are ignored. D-infinity flow-direction rasters -- essentially aspect in the mathematical convention -- are supported via a convention toggle. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_LandFacet"
                caption="Land Facet Clustering"
                className="Corridor.LandFacetButton"
                loadOnClick="true"
                smallImage="Images\LandFacet_16.png"
                largeImage="Images\LandFacet_32.png"
                keytip="LF">
          <tooltip heading="Land Facet Clustering">
            Opens the Land Facet Clustering wizard: an all-in-ArcGIS-Pro replacement for the Land Facet Corridor Designer's export-to-R / run-fuzzy-clustering-in-R / import-from-R round trip. It groups the cells of a categorical landscape (for example topographic-position or soil classes) into land facets by fuzzy c-means clustering of continuous variables (elevation, slope, insolation, ...) -- no R required. A four-step wizard walks through reading the inputs (with an optional Wildland Blocks clip), interactive kernel-density outlier detection, choosing the number of clusters from eight validity indices with a suggested consensus value, and generating the facets. It classifies every category in one pass into a SINGLE combined raster with unique facet IDs, symbolized by category hue and cluster shade, and records the analysis (facet list, variable order, clustering settings) in the output's metadata so the Land Facet Density and Mahalanobis tools can pick up from there. A port and modernization of the Brost &amp; Beier method (Land Facet Corridor Designer), with the clustering and validity numerics validated against the original R.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_LandFacetDensity"
                caption="Land Facet Density"
                className="Corridor.LandFacetDensityButton"
                loadOnClick="true"
                smallImage="Images\LandFacetDensity_16.png"
                largeImage="Images\LandFacetDensity_32.png"
                keytip="DS">
          <tooltip heading="Land Facet Density">
            Opens the Land Facet Density tool from the Jenness Enterprises toolbox: for every land facet in a land facet raster, the proportion of the surrounding neighborhood composed of that facet, from 0 to 1. The result is ONE multi-band raster with a band per facet, computed in a single pass, rather than the one-raster-per-facet the original ArcMap Calculate Density Surface tool produced. Density is used twice in a Land Facet corridor analysis: the high-density regions inside the Wildland Blocks become the corridor termini, and density is one of the variables in the Mahalanobis cost surface, where its ideal value is 100% rather than its mean. Values are stored as integers scaled by 10,000 (divide by 10,000 for the proportion), and the band-to-facet mapping is recorded in the output's metadata, since raster band names do not survive a copy into a geodatabase. Run it on the output of the Land Facet Clustering tool and every band is labelled with its category and cluster automatically. Needs no Spatial Analyst. Also available in the Corridor Designer Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_LandFacetMahalanobis"
                caption="Land Facet Mahalanobis"
                className="Corridor.LandFacetMahalanobisButton"
                loadOnClick="true"
                smallImage="Images\LandFacetMahal_16.png"
                largeImage="Images\LandFacetMahal_32.png"
                keytip="MD">
          <tooltip heading="Land Facet Mahalanobis">
            Opens the Land Facet Mahalanobis tool from the Jenness Enterprises toolbox: one Mahalanobis distance cost (resistance) surface per land facet, measuring how far every cell departs, in multivariate standard deviations, from the conditions typical of that facet. The mean vector and covariance matrix come ONLY from the facet's cells inside the Wildland Blocks, which act as training data, while the surface itself covers the whole analysis area -- so the output extends well beyond the blocks, as a corridor must. Each facet gets its own single-band raster, ready to use directly as the cost surface in least-cost corridor modelling. Supply a Land Facet Density raster and density joins the analysis with a characteristic value of 100% rather than its mean, the substitution the original workflow left to the analyst to remember. Variables and facets are filled in automatically from the land facet raster's own analysis record. Needs no Spatial Analyst. Also available in the Corridor Designer Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_InvertRaster"
                caption="Invert Raster"
                className="Corridor.InvertRasterButton"
                loadOnClick="true"
                smallImage="Images\InvertRaster_16.png"
                largeImage="Images\InvertRaster_32.png"
                keytip="IR">
          <tooltip heading="Invert Raster">
            Opens the Invert Raster tool from the Jenness Enterprises toolbox: numerically inverts a raster (each cell becomes 1/(x + c)) so a surface where HIGH values mean good habitat -- a Diversity Indices surface, a Land Facet Density raster -- becomes a least-cost surface where that good ground is CHEAP to cross, ready for CorridorDesigner or Cost Distance. The dialog follows the input: a single-band raster asks for one output raster, while a multi-band Land Facet Density raster asks for a workspace and prefix and writes one single-band cost raster per facet in a single run, named from the density raster's own records, with the stored integer scaling converted back to 0-1 proportions first so the constant keeps its intended meaning. The small constant c (default 0.1, the Land Facet manual's strong recommendation) prevents zero cells from dividing to NoData and reproduces the published diversity resistance formula 1/(H' + 0.1). Every output records its place in the Land Facet analysis chain. DO NOT invert a Land Facet Mahalanobis distance raster (D or D2) -- it is already a valid cost surface (low distance = near-ideal = cheap), and inverting it reverses that meaning; the tool warns if you try. A modernized port of the Land Facet Corridor Designer's Invert Raster tool. Needs no Spatial Analyst. Also available in the Corridor Designer Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_FindRasterExtremes"
                caption="Find Raster Extreme Values"
                className="FindRasterExtremesButton"
                loadOnClick="true"
                smallImage="Images\FindExtremes_16.png"
                largeImage="Images\FindExtremes_32.png"
                keytip="FE">
          <tooltip heading="Find Raster Extreme Values">
            Opens the Find Raster Extreme Values tool from the Jenness Enterprises toolbox: finds the regional extremes of ANY raster surface and writes one point per extreme. On a DEM those are summits and sinks â€” a low point is a cell (or connected flat) with no lower neighbor, a peak is the same thing on the inverted surface â€” but the tool works identically on any continuous raster: run it on a slope raster to find the steepest and flattest points on the landscape, on a habitat-suitability surface to pin the locations of best and worst habitat, on temperature, wetness, density, or any other modeled surface. Flat tops and flat-bottomed basins yield one point each; flats that drain (benches) are excluded. Each point carries the source raster name and workspace, the cell value, X and Y (honoring the Output Coordinates environment), its prominence â€” for a DEM, true topographic prominence or depression depth; for any other surface, how far the value stands above or below its surroundings â€” and an edge-of-data flag for extremes whose neighbors are unknown. Optional minimum-prominence and dominance-window filters screen out noise. Needs no Spatial Analyst. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_IdentifyTermini"
                caption="Identify Termini Polygons"
                className="Corridor.IdentifyTerminiButton"
                loadOnClick="true"
                smallImage="Images\Termini_16.png"
                largeImage="Images\Termini_32.png"
                keytip="IT">
          <tooltip heading="Identify Termini Polygons">
            Opens the Identify Termini Polygons tool from the Jenness Enterprises toolbox: finds the corridor termini within each Wildland Block -- the concentrations of a quality surface that the least-cost corridors will run between. Works equally on a species habitat-suitability surface (traditional Corridor Designer workflows) or a Land Facet Density/Diversity surface (climate-resilience corridors). Cells above a threshold are aggregated into regions (edge- or corner-touching cells connect), and each block keeps the regions at least a given percentage (default 50%) of the size of its largest region. A multi-band raster is processed category by category in ONE run, into a single polygon feature class with a Category field; any number of Wildland Block features is allowed. The threshold is a fixed value (0 for density: any density at all), each block's own median (for diversity and habitat-suitability surfaces), or -- with no thresholding at all -- the whole Wildland Block polygon used directly as its own terminus, a baseline corridor endpoint that needs no quality surface. Every output records its place in the analysis chain. A modernized, generalized port of the Land Facet Corridor Designer's Identify Termini Polygons tool. Needs no Spatial Analyst. Also available in the Corridor Designer Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_LeastCostCorridor"
                caption="Least-Cost Corridor"
                className="Corridor.LeastCostCorridorButton"
                loadOnClick="true"
                smallImage="Images\LeastCostCorridor_16.png"
                largeImage="Images\LeastCostCorridor_32.png"
                keytip="CR">
          <tooltip heading="Least-Cost Corridor">
            Opens the Least-Cost Corridor tool from the Jenness Enterprises toolbox: combines cost-distance surfaces and Wildland Block start/end points into corridor polygons between every pair of blocks, for every category present in an Identify Termini Polygons output (run that tool first -- its output, not the raw Wildland Blocks layer, is what this tool needs). A modernized, generalized port of the CorridorDesigner CorridorModel tool -- its traditional and still most common use is a species habitat-suitability surface (inverted with Invert Raster into a cost surface); a Land Facet Mahalanobis distance raster is used directly with no inversion (low distance is already cheap to cross); a Land Facet Density or Diversity surface needs inversion first, used when the corridor should not depend on any particular future vegetation type. Computes accumulated cost distance and the corridor combine internally (no Spatial Analyst), honors geodesic distances on a geographic coordinate system, and extracts the result at a series of percentile-width thresholds (0.1%, 1%, 2%, ... by default) in one combined output. Also available in the Corridor Designer Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_FillCorridorHoles"
                caption="Fill Corridor Holes"
                className="Corridor.FillCorridorHolesButton"
                loadOnClick="true"
                smallImage="Images\FillCorridorHoles_16.png"
                largeImage="Images\FillCorridorHoles_32.png"
                keytip="FH">
          <tooltip heading="Fill Corridor Holes">
            Opens the Fill Corridor Holes tool from the Jenness Enterprises toolbox: closes small interior holes in one or more polygon feature classes -- typically a Least-Cost Corridor output, but works on any polygon dataset. Every hole (interior ring) smaller than a size threshold (square meters, kilometers, feet or miles) is filled; holes at or above the threshold are left as real, meaningful gaps such as a lake or a genuinely excluded area. Hole size is measured as true geodesic area, correct on any coordinate system including a geographic one -- Esri's own Eliminate Polygon Part tool was tested and rejected for this purpose because its area threshold is planar only and silently misbehaves on unprojected data. Every attribute field is preserved unchanged; only the geometry is edited. Accepts multiple inputs in one run, each written to an output workspace with a name suffix (default "_holes_removed"). Respects a per-input selection (only the selected features are processed; an input with none uses all of them), and records the selected/total count when one was active. When an input already carries a Land Facet linkage record, the same record is kept on the output with this step noted, so the Corridor Analysis Data Report keeps describing it as the same analysis product. A modernized port of the original CorridorDesigner "Fill holes in corridor" tool. Needs no Spatial Analyst. Also available in the Corridor Designer Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_UnionCorridors"
                caption="Union Corridors"
                className="Corridor.UnionCorridorsButton"
                loadOnClick="true"
                smallImage="Images\UnionCorridors_16.png"
                largeImage="Images\UnionCorridors_32.png"
                keytip="UC">
          <tooltip heading="Union Corridors">
            Opens the Union Corridors tool from the Jenness Enterprises toolbox: combines every input polygon feature class into ONE seamless combined shape -- unions them together, then dissolves the result into a single multipart polygon. Per-input attributes are deliberately NOT preserved, matching the original tool: the point is a single combined shape answering "is this ground part of ANY corridor", not which one. SELECT BEFORE YOU RUN -- a corridor feature class typically holds many percentile-width bands as separate features (the Percentile field); to union just the 5% bands across several species, select Percentile = 5 on each input's layer in the map before running this tool. An input with no active selection contributes all of its features. HONORING A SELECTION ONLY WORKS FOR INPUTS ALREADY LOADED IN THE MAP -- the tool itself happily accepts datasets picked via the GP dialog's Browse button (all of their features are used), but a browsed dataset is a bare path with no concept of a selection at all; to use a subset of a feature class, load it into the map and select there first, then pick that layer here instead of browsing to the dataset. Warns when the inputs carry DIFFERENT Land Facet analysis ids -- combining genuinely unrelated analyses (different species, different clustering runs), not just different categories within one. A modernized port of the original CorridorDesigner "Create union of all corridors" tool. Needs no Spatial Analyst. Also available in the Corridor Designer Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_HsmRemapBuilder"
                caption="Create HSM Remap Table"
                className="Corridor.HsmRemapButton"
                loadOnClick="true"
                smallImage="Images\HsmRemap_16.png"
                largeImage="Images\HsmRemap_32.png"
                keytip="HT">
          <tooltip heading="Create HSM Remap Table">
            Opens an interactive remap-table builder for the Create Habitat Suitability Model tool. Pick a single-band raster (a map layer or a raster on disk); the window draws its histogram and statistics, and as you enter remap rows, translucent washes show which value ranges are covered so far, with a preview strip tinting each range by its new 0-100 suitability score. Toggle between Reclassify by Range (From / To / New Value) and Reclassify by Value (Original Value / New Value); helper buttons fill equal intervals or list every unique value. Saves next to the source raster in the format that fits: an ASCII remap file beside a file raster (GeoTIFF etc.), or a geodatabase remap TABLE beside a geodatabase raster -- both accepted directly by the Create Habitat Suitability Model tool, whose dialog auto-fills matching remap sources by name. Warns when the remap does not cover the raster's full value range, or when the new values stray outside (or fail to use) the 0-100 suitability scale.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_HabitatSuitabilityModel"
                caption="Create Habitat Suitability Model"
                className="Corridor.HabitatSuitabilityModelButton"
                loadOnClick="true"
                smallImage="Images\HabitatSuitability_16.png"
                largeImage="Images\HabitatSuitability_32.png"
                keytip="HC">
          <tooltip heading="Create Habitat Suitability Model">
            Opens the Create Habitat Suitability Model tool from the Jenness Enterprises toolbox: builds a habitat suitability model (HSM) on the 0-100 scale (100 = best habitat) from any number of habitat factor rasters -- land cover, elevation, distance to roads... Each factor is reclassified onto 0-100 with a tab-delimited ASCII remap file (the original CorridorDesigner format, so existing remap files drop straight in), then the factors are combined by weighted GEOMETRIC mean (recommended: a zero score in any factor zeroes the cell -- Liebig's Law of the Minimum) or weighted ADDITIVE mean (equivalent to Weighted Overlay), with weights summing to 100. Optionally saves each reclassified factor for reuse in Combine Habitat Factors when experimenting with weights. Needs no Spatial Analyst. Also available in the Corridor Designer Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_CombineHabitatFactors"
                caption="Combine Habitat Factors"
                className="Corridor.CombineHabitatFactorsButton"
                loadOnClick="true"
                smallImage="Images\CombineFactors_16.png"
                largeImage="Images\CombineFactors_32.png"
                keytip="HF">
          <tooltip heading="Combine Habitat Factors">
            Opens the Combine Habitat Factors tool from the Jenness Enterprises toolbox: combines habitat factor rasters ALREADY scored on the 0-100 suitability scale into one habitat suitability model, by weighted geometric or additive mean with weights summing to 100. Use it to experiment with different weights or combination methods without re-running the reclassification step -- the Create Habitat Suitability Model tool can save its reclassified factors exactly for this. Needs no Spatial Analyst. Also available in the Corridor Designer Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_NormalizeExistingHSM"
                caption="Normalize Existing HSM"
                className="Corridor.NormalizeExistingHsmButton"
                loadOnClick="true"
                smallImage="Images\NormalizeHSM_16.png"
                largeImage="Images\NormalizeHSM_32.png"
                keytip="HN">
          <tooltip heading="Normalize Existing HSM">
            Opens the Normalize Existing HSM tool from the Jenness Enterprises toolbox: linearly stretches a habitat suitability model built outside CorridorDesigner (a logistic-regression surface, an expert model on another scale...) onto the 0-100 suitability scale the HSM chain expects. You name the value meaning WORST habitat (becomes 0) and BEST habitat (becomes 100); a model where low values mean good habitat inverts naturally. Values beyond the anchors are clamped to 0-100 by default. Needs no Spatial Analyst. Also available in the Corridor Designer Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_ReclassifyFeaturesInHSM"
                caption="Reclassify Features in HSM"
                className="Corridor.ReclassifyFeaturesInHsmButton"
                loadOnClick="true"
                smallImage="Images\ReclassFeaturesHSM_16.png"
                largeImage="Images\ReclassFeaturesHSM_32.png"
                keytip="HR">
          <tooltip heading="Reclassify Features in HSM">
            Opens the Reclassify Features in HSM tool from the Jenness Enterprises toolbox: assigns a fixed suitability score (0-100) to every cell of a habitat suitability model that falls inside your polygon features -- for influences the base habitat factors could not capture: a fenced right-of-way scored 0, a wildlife-friendly easement scored higher, a mapped disturbance footprint. Cells outside the polygons keep their original scores; NoData stays NoData. A polygon layer's active map selection is honored -- only the selected features are used. Needs no Spatial Analyst. Also available in the Corridor Designer Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_CriticalHabitatFeature"
                caption="Critical Habitat Feature"
                className="Corridor.CriticalHabitatFeatureButton"
                loadOnClick="true"
                smallImage="Images\CriticalFeature_16.png"
                largeImage="Images\CriticalFeature_32.png"
                keytip="HX">
          <tooltip heading="Critical Habitat Feature">
            Opens the Critical Habitat Feature tool from the Jenness Enterprises toolbox: rescales a habitat suitability model by DISTANCE from a critical habitat feature -- a resource the species must stay near, or a hazard it must avoid. You provide distance bands (in map units) with a percentage for each; every cell's suitability is multiplied by the percentage of the band its distance falls in. The classic example: a riparian species keeps 100% of its score within 30 m of water, 80% from 30-60 m, 60% from 60-100 m, and 0% beyond. The critical feature can be a feature layer (an active selection is honored) or a raster (every data cell is the feature). Needs no Spatial Analyst. Also available in the Corridor Designer Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_HabitatPatches"
                caption="Create Habitat Patches"
                className="Corridor.HabitatPatchesButton"
                loadOnClick="true"
                smallImage="Images\HabitatPatches_16.png"
                largeImage="Images\HabitatPatches_32.png"
                keytip="HP">
          <tooltip heading="Create Habitat Patches">
            Turn a habitat suitability model into habitat patch polygons classified by size: the HSM is averaged over a moving window, cells at or above your quality threshold are grouped into patches (touching edges or corners), and each patch is classified by geodesic area as too small, a breeding patch, or a population patch. One polygon per patch with class and hectares. A port of the CorridorDesigner Patch Configuration tool. No Spatial Analyst needed.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_ClipData"
                caption="Clip Data to Analysis Area"
                className="Corridor.ClipDataToAnalysisAreaButton"
                loadOnClick="true"
                smallImage="Images\ClipData_16.png"
                largeImage="Images\ClipData_32.png"
                keytip="CA">
          <tooltip heading="Clip Data to Analysis Area">
            Clip any mix of rasters and feature classes to an analysis area polygon in one run: drag layers in from the map or multi-select datasets from disk. A folder output produces shapefiles and GeoTIFFs; a geodatabase produces native feature classes and rasters. Optionally project everything to one coordinate system, with geographic transformations suggested automatically and chosen per source datum. A port of the CorridorDesigner Clip Analysis Layers tool. No Spatial Analyst needed.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_PatchAnalysis"
                caption="Patch Analysis"
                className="Corridor.PatchAnalysisButton"
                loadOnClick="true"
                smallImage="Images\PatchAnalysis_16.png"
                largeImage="Images\PatchAnalysis_32.png"
                keytip="PA">
          <tooltip heading="Patch Analysis">
            Find the route through a corridor that minimizes the patch-to-patch gaps an animal must cross between termini, using patches of good habitat as stepping stones, and report each termini pair's critical gap -- the largest expanse of unsuitable habitat crossed in one push. Exact vector shortest paths inside the corridor polygon (no raster approximation), any number of termini, geodesic lengths. A modernized port of the CorridorDesigner Evaluation Tools' Patch Analysis. No Spatial Analyst needed.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_Bottleneck"
                caption="Bottleneck Analysis"
                className="Corridor.BottleneckButton"
                loadOnClick="true"
                smallImage="Images\Bottleneck_16.png"
                largeImage="Images\Bottleneck_32.png"
                keytip="BA">
          <tooltip heading="Bottleneck Analysis">
            Find the route through a corridor between two wildland blocks with the WIDEST bottleneck -- the maximin route on the corridor's medial axis, chosen over every strand at once -- and graph the corridor width along it. Adjust the width threshold live (type, click the graph, or drag the line) with below-threshold stretches red on both the graph and the map; save the route, station points, and segments. Blocks come from map layers or feature classes on disk, narrowed to a single polygon by map selection or SQL. A modernized port of the CorridorDesigner Evaluation Tools' Bottleneck Analysis. No Spatial Analyst needed.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_WeightedSummaryStatistics"
                caption="Weighted Summary Statistics"
                className="Corridor.WeightedSummaryStatisticsButton"
                loadOnClick="true"
                smallImage="Images\WeightedStats_16.png"
                largeImage="Images\WeightedStats_32.png"
                keytip="WS">
          <tooltip heading="Weighted Summary Statistics">
            Summarize numeric fields of polylines or polygons two ways, side by side: ordinary record statistics AND geometry-weighted statistics, where every record is weighted by its geodesic length or area. For per-unit-landscape attributes (habitat suitability, canopy cover, resistance) the weighted mean is the value of an average hectare -- the statistic an animal actually experiences -- and it does not change however the landscape is subdivided into polygons. Optional case field for per-class rows; map selections honored. A port of the Summary Statistics tool from the CorridorDesigner Evaluation Tools. No Spatial Analyst needed.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_Histogram"
                caption="Histograms and Statistics"
                className="Corridor.HistogramButton"
                loadOnClick="true"
                smallImage="Images\Histogram_16.png"
                largeImage="Images\Histogram_32.png"
                keytip="HH">
          <tooltip heading="Histograms and Habitat Suitability Statistics">
            Compare the distribution of habitat suitability across corridor alternatives: side-by-side histograms of any rasters, feature layers or tables, with optional weighted kernel-density curves showing each distribution's shape. Show amounts (cells, hectares, acres -- converted automatically, even across different cell sizes) or percentages; clip each dataset to a polygon as it is added, with no pre-clipping; every option updates the chart live. Export the graphic as PNG or SVG, place it on a layout as editable graphics, save statistics to CSV / dBASE / geodatabase tables, and save dataset combinations as presets. A modernized port of the CorridorDesigner Evaluation Tools' histogram tool. No Spatial Analyst needed.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_Crosstab"
                caption="Cross-Tab Statistics"
                className="Corridor.CrosstabButton"
                loadOnClick="true"
                smallImage="Images\Crosstab_16.png"
                largeImage="Images\Crosstab_32.png"
                keytip="XT">
          <tooltip heading="Cross-Tab Statistics">
            Build a cross-tabulation (contingency) table -- a two-dimensional histogram showing how much of the landscape falls in each joint range of two variables. Sources: two fields of one table or feature class (weighted equally, by an attribute, or by geodesic feature size); two polygon layers (intersection regions, area-weighted); two rasters (paired cell values); or a polygon layer against a raster, sampled per cell or per polygon with a zonal statistic. Fields may be numeric or text: a text field such as ownership type or land-cover name becomes one named class per value, and a raster takes its class names from its layer's unique-value symbology or from a name column in its attribute table (a permanent Join Field; a map-level Add Join is not visible to the tool), so land cover by ownership comes out labeled with no typing. Optionally restrict everything to an analysis polygon -- features are clipped before their size is measured. Edit class names and ranges live, show counts / sizes (hectares, acres, ...) or percentages, flip rows and columns; copy the table, its image, or the full report, export the table to a geodatabase / dBASE / CSV, and place it on a layout as editable graphics. A modernized port of the CorridorDesigner Evaluation Tools' Cross-Tab Statistics. No Spatial Analyst needed.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_CumulativeSurface"
                caption="Cumulative Surface"
                className="Corridor.CumulativeSurfaceButton"
                loadOnClick="true"
                smallImage="Images\CumulativeSurface_16.png"
                largeImage="Images\CumulativeSurface_32.png"
                keytip="CU">
          <tooltip heading="Cumulative Surface">
            How many layers occur on each cell? Combine any mix of polygon layers and rasters -- patch maps, corridors, whole-species footprints, dragged into the dialog together -- into one integer raster whose cell value counts the layers present there: an estimate of the relative importance (or number of species served) of preserving that ground. Each layer counts at most once per cell; a raster counts where its value is neither NoData nor 0, so a corridor raster's background never counts. Optionally honor each layer's selection, label the legend ("3 Species"), and exclude cells where no layer occurs. Symbolized with the color-blind-friendly viridis ramp: dark violet (fewest) through teal to bright yellow (most). A modernized port of the CorridorDesigner Evaluation Tools' Cumulative Surface Tool. No Spatial Analyst needed.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_Voronoi"
                caption="Voronoi (Thiessen) Polygons"
                className="Geometric.VoronoiButton"
                loadOnClick="true"
                smallImage="Images\Voronoi_16.png"
                largeImage="Images\Voronoi_32.png"
                keytip="VP">
          <tooltip heading="Voronoi (Thiessen) Polygons within Boundary">
            Build Voronoi (Thiessen) polygons around a point feature class -- each cell is the region closer to its generating point than to any other -- optionally clipped to a boundary polygon such as a management or analysis area. Without a boundary, cells fill the points' extent expanded 10% per axis. Geographic data is tessellated exactly on the sphere with true great-circle bisectors, optionally refined to ellipsoidal geodesics; projected data is tessellated planar. Transfers chosen point attributes to the cells, links every cell to its point by Point_FID, and can add a geodesic area field. Works at every license level.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_AdaptiveVoronoi"
                caption="Adaptive Voronoi Polygons"
                className="Geometric.AdaptiveVoronoiButton"
                loadOnClick="true"
                smallImage="Images\AdaptiveVoronoi_16.png"
                largeImage="Images\AdaptiveVoronoi_32.png"
                keytip="AV">
          <tooltip heading="Adaptive Voronoi Polygons">
            Subdivide a boundary polygon into compact, nearly equal-area cells arranged in a honeycomb-like pattern. Voronoi polygons are built around seed points (from a point feature class, or random points placed inside the boundary), clipped to the boundary, and each point then moves to its clipped cell's centroid; the process repeats until the cells settle, an iteration limit is reached, or a time limit expires. Over the iterations the cell areas equalize -- an ecologically defensible way to cut an analysis or management area into workable, near-circular pieces rather than narrow slices. Geographic data runs exactly on the sphere. Works at every license level.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_RepeatingShapes"
                caption="Repeating Shapes"
                className="Geometric.RepeatingShapesButton"
                loadOnClick="true"
                smallImage="Images\RepeatingShapes_16.png"
                largeImage="Images\RepeatingShapes_32.png"
                keytip="RS">
          <tooltip heading="Repeating Shapes">
            Tessellate an area of interest with hexagons, squares, triangles or brick-course rectangles, or lay out sampling points or circles in a square or triangular arrangement, at any orientation angle. The area comes from a polygon layer (selection honored), line or point features (every shape touching them is kept -- hexagons over a river, squares over observation locations), or an extent; edge shapes are kept whole (the classic behavior), kept by center, or clipped. Opens a friendly picture-gallery window (sizes update as you type; runs still land in Geoprocessing History); the same tool is also available in the Geoprocessing pane and ModelBuilder. A modernized port of Jeff Jenness's classic Repeating Shapes extension, rebuilt on vectorized generation for speed. Works at every license level.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_RandomPoints"
                caption="Random Point Generator"
                className="Geometric.RandomPointsButton"
                loadOnClick="true"
                smallImage="Images\RandomPoints_16.png"
                largeImage="Images\RandomPoints_32.png"
                keytip="RP">
          <tooltip heading="Random Point Generator">
            Generate uniform random points inside polygon features (selection honored, holes respected), ALONG polyline features, within the data cells of an integer raster's categories (NoData excluded; requires an attribute table), or in a plain extent -- with two optional hard constraints Esri's Create Random Points only half covers: a minimum separation between points AND a minimum separation from the area boundary (line ends for polylines; NoData/edge cells for rasters). Stratified sampling replicates Esri's Create Spatial Sampling Locations model: strata by individual polygon/polyline, raster category, contiguous raster region, or a strata ID field; counts allocated equally, proportionally to area/length, from a population field, or by density (per acre, square mile, hectare or square kilometer of area; per foot, mile, meter or kilometer of line). An optional seed makes runs exactly reproducible; geographic data is handled with equal-area honesty everywhere. A modernized port of Jeff Jenness's classic Random Point Generator extension. Works at every license level.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_RandomArrays"
                caption="Random Sample Array Generator"
                className="Geometric.RandomArraysButton"
                loadOnClick="true"
                smallImage="Images\RandomArrays_16.png"
                largeImage="Images\RandomArrays_32.png"
                keytip="RA">
          <tooltip heading="Random Sample Array Generator">
            Generate randomly placed ARRAYS of sampling points -- the standard field design of multiple sampling stations per plot -- inside polygon features, along polyline features, within the data cells of an integer raster's categories, or in a plain extent. Each array is built around a randomly placed focal location using the Random Point Generator's stratified sampling design; counts, the minimum distance between arrays, and the minimum distance from the boundary all refer to the arrays themselves (footprints: nearest points, never centers). Array shapes: a grid of rows and columns, a triangular lattice filling a circle, a circle of evenly spaced points (optionally including the center), or a one-dimensional array along a polyline that walks straight through junctions and warns when a Y confluence forces a branch choice. Arrays can be required to fit entirely inside the area (rejected placements are redrawn -- every array complete) or allowed to extend beyond it. Orientation: fixed angle, random per array, or aligned to the line direction. An optional seed makes runs exactly reproducible. Works at every license level.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_GrtsSample"
                caption="Spatially Balanced Sample (GRTS)"
                className="Geometric.GrtsButton"
                loadOnClick="true"
                smallImage="Images\GrtsSample_16.png"
                largeImage="Images\GrtsSample_32.png"
                keytip="SB">
          <tooltip heading="Spatially Balanced Sample (GRTS)">
            Select a SPATIALLY BALANCED probability sample from a point, polyline, or polygon frame using the generalized random-tessellation stratified (GRTS) design of Stevens and Olsen (2004) -- the standard of large environmental monitoring programs, as implemented in the spsurvey R package. Every location keeps its full, known inclusion probability (design-based inference intact), but each realized draw spreads over the frame the way pure randomness only promises on average. Options: stratification by a field with proportional or equal allocation; unequal (PPS) inclusion probability from a weight field (point frames); legacy sites guaranteed into the sample; a minimum distance between sites; and REPLACEMENT SITES drawn in the same design -- sites are written in reverse hierarchical order, so any leading run of SiteIDs is itself spatially balanced and replacements are consumed in SiteID order when field sites prove inaccessible. Design weights (1/inclusion probability) ride along for Horvitz-Thompson estimation, and the report scores the draw's spatial balance. Esri's Create Spatially Balanced Points requires the Geostatistical Analyst extension; this tool works at every license level.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_Centerline"
                caption="Centerline and Width"
                className="Geometric.CenterlineButton"
                loadOnClick="true"
                smallImage="Images\CenterlineWidth_16.png"
                largeImage="Images\CenterlineWidth_32.png"
                keytip="CW">
          <tooltip heading="Centerline and Width">
            Collapse polygons -- rivers, canals, corridors, valley bottoms -- to their centerlines, carrying the local polygon width along every result. The centerline is the polygon's medial axis (the same construction as Bottleneck Analysis): output either the main centerline (the skeleton's longest path) or the full branched skeleton with tributary branches, short boundary-noise spurs pruned. Every line carries minimum, mean and maximum width in meters; optional station points carry the exact width at evenly spaced stations (the width profile), and optional segments carry width statistics per piece for graduated-color width mapping. Holes are handled natively (the skeleton routes around islands), any attribute fields transfer from the source polygons, and line ends can extend to the polygon boundary. A license-free replacement for Esri's Polygon To Centerline. Works at every license level.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_LongestLine"
                caption="Longest Line in Polygon (Fetch)"
                className="Geometric.LongestLineButton"
                loadOnClick="true"
                smallImage="Images\LongestLine_16.png"
                largeImage="Images\LongestLine_32.png"
                keytip="LF">
          <tooltip heading="Longest Line in Polygon (Fetch)">
            Find the longest straight line that fits entirely inside each polygon -- the FETCH when the polygon is a body of water: the longest straight path over which wind can raise waves. Holes (islands) block the line; the line passes through two polygon vertices and may extend past them to the boundary; each feature reports its line with endpoints, geodesic length and azimuth. A second mode casts directional fetch rays from station points at a fixed bearing increment, ending at the first shoreline or a maximum fetch distance, with a per-station summary (the geometric core of the author's 2014 Wave Energy extension). A modernized, vectorized port of Jeff Jenness's classic ArcView Longest Straight Line extension -- what once ran overnight now runs in seconds. Geographic data runs in azimuthal-equidistant working projections; station radials are true geodesics. Works at every license level.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_RadiatingLines"
                caption="Radiating Lines and Points"
                className="Geometric.RadiatingLinesButton"
                loadOnClick="true"
                smallImage="Images\RadiatingLines_16.png"
                largeImage="Images\RadiatingLines_32.png"
                keytip="RN">
          <tooltip heading="Radiating Lines and Points">
            Cast a fan of evenly spaced lines outward from every input point -- the classic way to lay out regularly spaced sampling locations, transect starts or exposure rays around points of interest. Give the number of lines or the bearing interval (typing either fills in the other) and a line length in real units; the first line points north or is randomized (seed-reproducible). Any number of optional barrier polyline and polygon feature classes stop each line at its first crossing of a barrier line or polygon boundary, with a Blocked flag and the truncated length -- it is the boundary that blocks, so an origin inside a barrier polygon still radiates. Outputs are the lines and/or a point feature class of every origin and endpoint, each carrying bearing, geodesic length in meters, coordinates and any transferred attribute fields. A modernized port of Jeff Jenness's ArcView Radiating Lines and Points extension, originally written for the study published as Ekebom et al. (2003); geographic data uses per-point azimuthal-equidistant projections so every radial is a true geodesic. Works at every license level.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_InscribedGeometry"
                caption="Maximum Inscribed Geometry"
                className="Geometric.InscribedGeometryButton"
                loadOnClick="true"
                smallImage="Images\InscribedGeometry_16.png"
                largeImage="Images\InscribedGeometry_32.png"
                keytip="MI">
          <tooltip heading="Maximum Inscribed Geometry">
            Find the largest circle, rectangle, convex polygon (MCP) or ellipse -- or all four -- that fits entirely inside each polygon, with interior holes acting as barriers: the deliberate dual of Esri's Minimum Bounding Geometry, which fits shapes around features instead. The circle is exact (it sits on the polygon's medial axis); the rectangle searches every orientation or one you fix; the convex polygon solves the classic potato-peeling problem on a controllable discretization; the ellipse is always genuinely inside, and exact for convex inputs. Each shape carries its geodesic area, center, and dimensions (radius; length, width and azimuth; axes; vertex count) plus any transferred attribute fields. An Advanced simplify tolerance pre-simplifies raster-traced boundaries for speed, as in the Fetch tool. Geographic inputs use per-feature equidistant projections, so all measures are true geodesic meters. Works at every license level.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_ConcaveHull"
                caption="Concave Hull"
                className="Geometric.ConcaveHullButton"
                loadOnClick="true"
                smallImage="Images\ConcaveHull_16.png"
                largeImage="Images\ConcaveHull_32.png"
                keytip="CV">
          <tooltip heading="Concave Hull">
            Build a concave hull -- the shape of a cloud of points -- where the convex hull would bridge straight across every bay and gap. Three classic methods: chi (characteristic) shapes, always one simple polygon containing every point; alpha shapes, the only method that can return multiple disjoint parts and interior holes (two herds, telemetry ringing a lake); and the k-nearest-neighbours hull. One Concavity setting runs from 0 (the convex hull) to 100 (maximum detail), or blank for each method's automatic choice; exact per-method parameters live under Advanced. An optional case field builds one hull per group (per animal, per survey), each with point count, the parameter used, part and hole counts, and geodesic area and perimeter. The same methods behind the concave-hull tools of PostGIS, CGAL and QGIS; Esri's closest analog (Aggregate Points) needs an Advanced license. Also consider the Local Convex Hull (LoCoH) tools, which capture shape while also identifying areas of higher point density. Works at every license level.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_EstShortestPath"
                caption="Estimated Shortest Path through Points"
                className="Geometric.EstShortestPathButton"
                loadOnClick="true"
                smallImage="Images\EstPath_16.png"
                largeImage="Images\EstPath_32.png"
                keytip="EP">
          <tooltip heading="Estimated Shortest Path through Points">
Orders a set of points into a short travel route -- a survey route you can load into a GPS. Three route types: a simple shortest path (starting and ending at whichever two points give the shortest total), a round trip from a single start/end point (for example, where you left the truck), or a fixed start to a fixed end. Legs are straight lines between locations, not road-network routes. The solver is a polished traveling-salesperson heuristic, typically within a few percent of the true optimum, and deterministic. Outputs the route polyline and an optional copy of the points numbered in visit order. Pairs naturally with the Random Point Generator, Random Sample Array Generator, Repeating Shapes, and Spatially Balanced Sample tools. Works at every license level.
          </tooltip>
        </button>
        <button id="WildlifeTools_LandFacetDescribe"
                caption="Corridor Analysis Data Report"
                className="Corridor.LandFacetDescribeButton"
                loadOnClick="true"
                smallImage="Images\LandFacetDescribe_16.png"
                largeImage="Images\LandFacetDescribe_32.png"
                keytip="DB">
          <tooltip heading="Corridor Analysis Data Report">
            Opens a window that reports, in plain language, where a dataset stands in the Land Facet Corridor analysis: which source data led to it, how each step was analyzed (the clustering variables in order, the density neighborhood and its denominator rule, the Mahalanobis sampling inside the Wildland Blocks, the inversion constant), and its position in the overall sequence. The report follows the dataset's recorded sources back to the original clustering run and WARNS when a source has been regenerated since -- a sign the described dataset may be out of date. Datasets not involved in a Land Facet analysis are reported as such (with their Jenness provenance summary quoted when they were made by these tools). Read-only; the report can be copied as text or formatted, or saved to a file for a methods section or a data delivery.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_DiversityIndices"
                caption="Diversity Indices"
                className="DiversityIndicesButton"
                loadOnClick="true"
                smallImage="Images\Diversity_16.png"
                largeImage="Images\Diversity_32.png"
                keytip="DV">
          <tooltip heading="Diversity Indices">
            Opens the Diversity Indices tool from the Jenness Enterprises toolbox: neighborhood (focal) diversity of a CATEGORICAL raster, where each cell is a class (typically a species or vegetation/community type). Over a moving neighborhood of any shape and size it computes the effective number of species (Hill numbers of order q -- the default and most defensible modern measure), Shannon's index, the Gini-Simpson index, or Simpson's concentration. Works on projected or geographic rasters (with the same geodesic per-row adjustment as the other neighborhood tools) and needs no Spatial Analyst. A modernized port of the Land Facet Corridor Designer's ArcMap Shannon's Index tool, which built the diversity surface used for the facet-interspersion corridor. Also available in the Corridor Designer Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SimpleTPI"
                caption="Topographic Position Index"
                className="SimpleTPIButton"
                loadOnClick="true"
                smallImage="Images\TPI_16.png"
                largeImage="Images\TPI_32.png"
                keytip="TP">
          <tooltip heading="Topographic Position Index (TPI)">
            Opens the Topographic Position Index tool from the Jenness Enterprises toolbox: each cell's elevation minus the mean elevation of a neighborhood around it (Weiss 2001; Guisan et al. 1999). Positive values sit above their surroundings (ridges, hills), negative below (valleys, channels). Produces any of three outputs -- raw TPI in elevation units, or TPI standardized into standard-deviation units at DEM scale or at neighborhood scale. Computed internally, no Spatial Analyst. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SlopePosition"
                caption="Slope Position Classification"
                className="SlopePositionButton"
                loadOnClick="true"
                smallImage="Images\SlopePos_16.png"
                largeImage="Images\SlopePos_32.png"
                keytip="SP">
          <tooltip heading="Slope Position Classification">
            Opens the Slope Position Classification tool from the Jenness Enterprises toolbox: classifies a DEM into slope-position classes (valley, lower/middle/upper slope, flat, ridge) from a Topographic Position Index (elevation minus neighborhood mean) plus slope, using a saved classification system such as the Weiss 6-class or Dickson and Beier 4-class (Weiss 2001). TPI and slope are computed internally -- no Spatial Analyst -- or you may supply pre-computed rasters. Author the class rules and colors with the Classification System Builder. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_Landform"
                caption="Landform Classification"
                className="LandformButton"
                loadOnClick="true"
                smallImage="Images\Landform_16.png"
                largeImage="Images\Landform_32.png"
                keytip="LC">
          <tooltip heading="Landform Classification">
            Opens the Landform Classification tool from the Jenness Enterprises toolbox: classifies a DEM into landform categories (canyons, valleys, plains, open and upper slopes, ridges, peaks) from a small- and a large-neighborhood Topographic Position Index plus slope, using a saved classification system such as the Weiss 10-class (Weiss 2001). The two TPIs and slope are computed internally -- no Spatial Analyst -- or you may supply pre-computed rasters. Author the class rules and colors with the Classification System Builder. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_GeneralClassification"
                caption="General Raster Classification"
                className="GeneralClassificationButton"
                loadOnClick="true"
                smallImage="Images\GenClass_16.png"
                largeImage="Images\GenClass_32.png"
                keytip="GC">
          <tooltip heading="General Raster Classification">
            Opens the General Raster Classification tool from the Jenness Enterprises toolbox: classifies any single raster into categories using a saved 'general' classification system (threshold rules on the raster's raw or whole-raster standardized values). Similar in purpose to Esri's Reclassify tool, except that the classification scheme is authored once, as a reusable named system, in the Classification System Builder; that each class stores a name and color with the output; and that no Spatial Analyst or 3D Analyst extension is required. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_ClassificationBuilder"
                caption="Classification System Builder"
                className="Classification.ClassificationBuilderButton"
                loadOnClick="true"
                smallImage="Images\ClassBuilder_16.png"
                largeImage="Images\ClassBuilder_32.png"
                keytip="CB">
          <tooltip heading="Classification System Builder">
            Create, edit, duplicate, and delete the reusable classification systems (class thresholds, names, and colors -- with optional per-class transparency) applied by the Slope Position, Landform, and General Raster Classification tools. Systems are saved as JSON in a per-user location that survives add-in reinstalls, so your custom classifications stay available; Export and Import buttons share them with colleagues as JSON files.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SimpleHypsometricShading"
                caption="Simple Hypsometric Shading"
                className="SimpleHypsometricShadingButton"
                loadOnClick="true"
                smallImage="Images\SimpleHypso_16.png"
                largeImage="Images\SimpleHypso_32.png"
                keytip="HY">
          <tooltip heading="Simple Hypsometric Shading">
            Opens the Simple Hypsometric Shading tool from the Jenness Enterprises toolbox: creates a group layer draping a DEM (black-to-white stretch at a chosen transparency) over an existing hillshade for classic elevation-tinted relief. No new dataset is created - the group layer references the existing rasters and stays fully editable. Also available in the Cartography Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_ThoughtForTheDay"
                caption="Thought for the Day"
                className="ThoughtForTheDayButton"
                loadOnClick="true"
                smallImage="Images\Heart_16.png"
                largeImage="Images\Heart_32.png"
                keytip="TD">
          <tooltip heading="Thought for the Day">
            Shows a random inspirational quote in a little pop-up card.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_PolarPlots"
                caption="Polar Plots"
                className="PolarPlots.PolarPlotButton"
                loadOnClick="true"
                smallImage="Images\PolarPlot_16.png"
                largeImage="Images\PolarPlot_32.png"
                keytip="PP">
          <tooltip heading="Polar Plots">
            Opens the interactive Polar Plots window: generate a circular plot of directional data -- Peaks and Valleys, Circular Bins (Rose), Shade by Density, External Peaks and Valleys, External Bins, Bearings, Wind Rose, Smoothed Density, or Dot Plot -- adjust it live, and save it as an SVG file or add it to a layout as a grouped, fully editable graphic. Directions come from an attribute field, from polyline direction (geodesic on lat/long data, optionally weighted by length or an attribute), or from an entire aspect raster (six of the nine plot types; clip the raster to the study area first). Optional overlays show the mean direction and its 95% confidence interval. Also reports circular descriptive statistics (mean direction, dispersion, Rayleigh test, von Mises concentration, and more) that can be copied as raw / rich / Esri-formatted text or added to a layout as a text element in one click. Reusable style presets save every appearance option. A modernized recreation of the Jenness Enterprises Polar Plots extension for ArcMap.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SlopeGraphic"
                caption="Slope Graphic"
                className="SlopeGraphic.SlopeGraphicButton"
                loadOnClick="true"
                smallImage="Images\SlopeGraphic_16.png"
                largeImage="Images\SlopeGraphic_32.png"
                keytip="SG">
          <tooltip heading="Slope Graphic">
            Opens the interactive Slope Graphic window: an intuitive visual summary of the slope in an area -- a line inclined at the MEAN slope, a wedge spanning one standard deviation either side of it, a wedge spanning the full min-max range, an optional robust percentile wedge, a dashed median line, a protractor scale arc, and an arcing 95% confidence interval of the mean. Reads slope from a numeric field on a feature layer or table, or streams an entire slope raster (any size) into exact statistics; values may be in degrees, percent slope, rise:run ratio, or gradians. Adjust everything live and save the graphic as an SVG file or place it as a grouped, fully editable graphic on a layout, with slope statistics one click away. A modernized recreation of the Slope Graphic from the Jenness Enterprises Grid Tools extension for ArcView 3.x.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_FavoriteDatasets"
                caption="Load Favorite Datasets"
                className="DataTools.FavoriteDatasetsButton"
                loadOnClick="true"
                smallImage="Images\FavoriteData_16.png"
                largeImage="Images\FavoriteData_32.png"
                keytip="FD">
          <tooltip heading="Load Favorite Datasets">
            Opens the Load Favorite Datasets window: keep your most-used datasets in four groups you name yourself, then check any combination and add them all to the active map with one click -- no more hunting through folders and web servers. Any dataset a browse dialog can reach can be saved: feature classes, rasters, tables, and online services alike. Add items, remove them, and edit their descriptions; the lists are saved with your user profile and shared across projects. Datasets that appear to be unavailable (a missing path or an unreachable server) show in RED. A modernized recreation of the Load Favorite Datasets tool from the ArcMap SSI toolbar.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SelectRandom"
                caption="Select Random Records"
                className="DataTools.SelectRandomButton"
                loadOnClick="true"
                smallImage="Images\SelectRandom_16.png"
                largeImage="Images\SelectRandom_32.png"
                keytip="SX">
          <tooltip heading="Select Random Records">
            Randomly or systematically select features or table rows: a fixed number, a percentage, a statistically derived sample size (Auto Calculate from a confidence level and margin of error, finite-population corrected), a fixed number with selection probability proportional to geodesic area or length, or systematic designs (every Xth record with an optional random start, or all odd- or even-numbered records, walked in a sort-field order). Offers the four standard selection methods -- Add-to draws only from the currently unselected records, while Remove-from and Subset-of treat the current selection as the population -- plus an analysis extent (intersecting or entirely within), standalone tables, and a reproducibility seed. A no-extension replication and extension of Esri's Data Reviewer Select Random Sample tool. Works at every license level.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_AttributeSummary"
                caption="Attribute Summary Reports"
                className="DataTools.AttributeSummaryButton"
                loadOnClick="true"
                smallImage="Images\AttrSummary_16.png"
                largeImage="Images\AttrSummary_32.png"
                keytip="AR">
          <tooltip heading="Attribute Summary Reports">
            Opens the Attribute Summary Reports window: counts and proportions of the value classes in one or more attribute fields of a feature layer, standalone table, or raster attribute table -- summarize each field separately or the unique COMBINATIONS of several fields together, in an analysis order you control. Each report line is rendered from a format template you design with token buttons ({val1}, {Count}, {Prop2}, running numbers/letters/roman numerals, tabs, ...) with a live sample preview; formats can be saved and reloaded as presets. The report opens in a window ready to copy as plain text, rich text for Word, or a clean tab-separated table for Excel. A modernized recreation of the Summarize Attribute Fields tool from the ArcMap SSI toolbar.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_ClassAccuracy"
                caption="Classification Accuracy (Kappa)"
                className="DataTools.ClassificationAccuracyButton"
                loadOnClick="true"
                smallImage="Images\ClassificationAccuracy_16.png"
                largeImage="Images\ClassificationAccuracy_32.png"
                keytip="KA">
          <tooltip heading="Classification Accuracy (Kappa)">
            Assess the accuracy of a categorical map or model against reference classes: the error matrix, Cohen's Kappa with variance, Z test and confidence interval, weighted kappa for ordinal classes, per-class conditional kappa, user's/producer's accuracies, sensitivity, specificity, omission and commission, predictive power, F1, Gwet's AC1, Pontius-Millones quantity and allocation disagreement -- and, with map proportions, the Olofsson et al. (2014) area-weighted accuracies and error-adjusted area estimates with confidence intervals that current journals expect. Values come from fields or are extracted from classified rasters or polygons, optionally as the majority in a circle around each sample (locational uncertainty). An analysis field compares observers or models automatically, and every report ends with a ready-to-run R snippet reproducing the analysis (algorithms validated against R's reference packages). A modernized port of Jenness and Wynne's classic Kappa extension; unlike Esri's Compute Confusion Matrix, needs no extension license. Works at every license level.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_CompareAccuracy"
                caption="Compare Accuracy Analyses"
                className="DataTools.CompareAccuracyButton"
                loadOnClick="true"
                smallImage="Images\CompareAccuracy_16.png"
                largeImage="Images\CompareAccuracy_32.png"
                keytip="KZ">
          <tooltip heading="Compare Accuracy Analyses">
            Compare the Kappa statistics of two or more accuracy analyses -- different models, observers, algorithms or imagery dates: a Z test of each kappa against chance, pairwise Z tests between analyses, and the Fleiss common-kappa chi-square test of overall equality. Enter each analysis's kappa and variance, both printed by the Classification Accuracy (Kappa) tool -- or use that tool's analysis field to run the comparisons automatically in one pass. A port of the classic Kappa extension's Compare Kappa Analyses tool. Works at every license level.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_AccSampleSize"
                caption="Estimate Sample Size"
                className="DataTools.AccuracySampleSizeButton"
                loadOnClick="true"
                smallImage="Images\AccuracySampleSize_16.png"
                largeImage="Images\AccuracySampleSize_32.png"
                keytip="KS">
          <tooltip heading="Estimate Sample Size">
            Estimate the reference sample size needed for a statistically defensible accuracy assessment. Pick one of four methods: Congalton and Green's multinomial approach (Tortora 1978) as the worst case with no map proportions known, refined by the largest class proportion, or from per-class proportions with individual precision requirements -- each with the optional finite population correction -- or the Olofsson et al. (2014) sample size for a target standard error of overall accuracy. Reproduces the classic Kappa extension's published sample-size table exactly, and returns the recommended size as a derived output for ModelBuilder. Pair it with the Random Point Generator and Select Random Records tools to draw the design, then assess with Classification Accuracy (Kappa). Works at every license level.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_Sudoku"
                caption="Sudoku"
                className="Sudoku.SudokuButton"
                loadOnClick="true"
                smallImage="Images\Sudoku_16.png"
                largeImage="Images\Sudoku_32.png"
                keytip="SD">
          <tooltip heading="Sudoku">
            Opens a Sudoku puzzle in a floating window, so the map keeps working while you think. Three difficulty levels; every puzzle has exactly one solution. Click a cell and type 1-9; arrow keys move (wrapping at the edges) and Tab snakes through the grid. Check colors your entries blue (correct) or red (incorrect), and Reveal Cell will confess a single answer -- after asking if you are sure you want it.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_SlidingPuzzle"
                caption="Sliding Puzzle"
                className="Puzzle.SlidingPuzzleButton"
                loadOnClick="true"
                smallImage="Images\Puzzle_16.png"
                largeImage="Images\Puzzle_32.png"
                keytip="SP">
          <tooltip heading="Sliding Puzzle">
            Turns a snapshot of your current map or layout into a sliding-tile puzzle in a floating window, so the map keeps working while you play. A map is cropped to its largest visible square (switchable 4x4, 5x5, or 6x6 tiles); a layout uses the whole page, with the tile count you pick along the short edge and a matching near-square count along the long edge. One tile is removed and the rest are scrambled; slide tiles into the gap to rebuild the picture. Peek shows the finished image, and Numbers turns on an easier mode.<disabledText />
          </tooltip>
        </button>
        <button id="WildlifeTools_EasterEgg"
                caption="ArcMap Easter Egg"
                className="EasterEggButton"
                loadOnClick="true"
                smallImage="Images\Jerry_16.png"
                largeImage="Images\Jerry_32.png"
                keytip="EE">
          <tooltip heading="ArcMap Easter Egg">
            Opens a little pop-up card celebrating a classic ArcMap easter egg: back in ArcMap 8.3 and 9.0, typing the letters "jerry" during an edit session made a picture of Jerry Garcia appear on your map. The card shows the original artwork (recovered from the ArcMap 8.3 install) and the story behind it, with a credited link to the source photograph.<disabledText />
          </tooltip>
        </button>
      </controls>
      <galleries>
        <!-- In-ribbon gallery for the Home Range group (the control behind
             Esri's Analysis > Tools group): a few tools show full-size on
             the ribbon, and the expanded dropdown lists every tool in
             titled rows matching the classic menu groupings. Items are
             built at runtime from the existing button definitions. -->
        <gallery id="WildlifeTools_HomeRangeGallery"
                 caption="Home Range Tools"
                 className="HomeRangeGallery"
                 itemsInRow="4"
                 itemWidth="76"
                 itemHeight="62"
                 showItemCaption="true"
                 showItemCaptionBelow="true"
                 showGroup="true"
                 resizable="true"
                 loadOnClick="false"
                 dataTemplateFile="pack://application:,,,/WildlifeTools;component/GalleryTemplates.xaml"
                 templateID="WildlifeToolGalleryItem"
                 largeImage="Images\LoCoH_32.png"
                 smallImage="Images\LoCoH_32.png"
                 keytip="HO">
          <tooltip heading="Home Range Tools">
            Home-range and habitat-analysis tools: Local Convex Hull (LoCoH) home ranges, enhanced kernel density with probability contours and proportion surfaces, and the Mahalanobis habitat-similarity family. Expand the gallery to see all ten tools grouped by family.<disabledText />
          </tooltip>
        </gallery>
        <gallery id="WildlifeTools_TopographicGallery"
                 caption="Topographic Analysis Tools"
                 className="TopographicGallery"
                 itemsInRow="5"
                 itemWidth="76"
                 itemHeight="62"
                 showItemCaption="true"
                 showItemCaptionBelow="true"
                 showGroup="true"
                 resizable="true"
                 loadOnClick="false"
                 dataTemplateFile="pack://application:,,,/WildlifeTools;component/GalleryTemplates.xaml"
                 templateID="WildlifeToolGalleryItem"
                 largeImage="Images\TRI_32.png"
                 smallImage="Images\TRI_32.png"
                 keytip="TA">
          <tooltip heading="Topographic Analysis Tools">
            Terrain analysis at every license level: topographic roughness and ruggedness (surface area and ratio, VRM, ACR, TRI, fractal dimension, LSRI, and roughness along lines), the topographic wetness index, slope zonal statistics, raster extreme values, the TPI landform family with the Classification System Builder, and aspect statistics computed correctly in circular space. Expand the gallery to see all 21 tools grouped by family.<disabledText />
          </tooltip>
        </gallery>
        <gallery id="WildlifeTools_CorridorDesignerGallery"
                 caption="Corridor Designer Tools"
                 className="CorridorDesignerGallery"
                 itemsInRow="5"
                 itemWidth="76"
                 itemHeight="62"
                 showItemCaption="true"
                 showItemCaptionBelow="true"
                 showGroup="true"
                 resizable="true"
                 loadOnClick="false"
                 dataTemplateFile="pack://application:,,,/WildlifeTools;component/GalleryTemplates.xaml"
                 templateID="WildlifeToolGalleryItem"
                 largeImage="Images\LandFacet_32.png"
                 smallImage="Images\LandFacet_32.png"
                 keytip="CC">
          <tooltip heading="Corridor Designer Tools">
            The complete CorridorDesigner workflow, by Jenness, Majka, Brost and Beier: habitat suitability modeling, land facet corridor modeling, corridor building and modification, corridor evaluation, and the ancillary analysis tools. Expand the gallery to see all 23 tools grouped by workflow stage; the Corridor Analysis Data Report sits beside the gallery.<disabledText />
          </tooltip>
        </gallery>
        <gallery id="WildlifeTools_GeometricGallery"
                 caption="Geometric Tools"
                 className="GeometricGallery"
                 itemsInRow="4"
                 itemWidth="76"
                 itemHeight="62"
                 showItemCaption="true"
                 showItemCaptionBelow="true"
                 showGroup="true"
                 resizable="true"
                 loadOnClick="false"
                 dataTemplateFile="pack://application:,,,/WildlifeTools;component/GalleryTemplates.xaml"
                 templateID="WildlifeToolGalleryItem"
                 largeImage="Images\Voronoi_32.png"
                 smallImage="Images\Voronoi_32.png"
                 keytip="GE">
          <tooltip heading="Geometric Tools">
            Tools that build and analyze vector geometry: Voronoi and repeating-shape tessellations, random point and sample-array generators, and tools that derive new geometry from existing features such as centerlines, longest interior lines, radiating lines, maximum inscribed shapes and concave hulls.<disabledText />
          </tooltip>
        </gallery>
        <gallery id="WildlifeTools_EcologicalGallery"
                 caption="Ecological Analysis"
                 className="EcologicalGallery"
                 itemsInRow="3"
                 itemWidth="76"
                 itemHeight="62"
                 showItemCaption="true"
                 showItemCaptionBelow="true"
                 showGroup="true"
                 resizable="true"
                 loadOnClick="false"
                 dataTemplateFile="pack://application:,,,/WildlifeTools;component/GalleryTemplates.xaml"
                 templateID="WildlifeToolGalleryItem"
                 largeImage="Images\ClassificationAccuracy_32.png"
                 smallImage="Images\ClassificationAccuracy_32.png"
                 keytip="EA">
          <tooltip heading="Ecological Analysis">
            Statistical tools for ecological analysis, beginning with the Kappa accuracy-assessment suite: assess a classification against reference data, compare accuracy analyses, and estimate the reference sample size a defensible assessment needs.<disabledText />
          </tooltip>
        </gallery>
        <gallery id="WildlifeTools_CartographyGallery"
                 caption="Cartography Tools"
                 className="CartographyGallery"
                 itemsInRow="5"
                 itemWidth="76"
                 itemHeight="62"
                 showItemCaption="true"
                 showItemCaptionBelow="true"
                 showGroup="true"
                 resizable="true"
                 loadOnClick="false"
                 dataTemplateFile="pack://application:,,,/WildlifeTools;component/GalleryTemplates.xaml"
                 templateID="WildlifeToolGalleryItem"
                 largeImage="Images\EnhancedHillshade_32.png"
                 smallImage="Images\EnhancedHillshade_32.png"
                 keytip="CT">
          <tooltip heading="Cartography Tools">
            Tools for more attractive maps: the geodesic-correct hillshade variations (including the "Swiss method" strategies), background graphics drawn behind selected elements, and cartographic helpers for soft shadow polygons and for parking Esri's Service Layer Credits text off the printed page.<disabledText />
          </tooltip>
        </gallery>
      </galleries>
      <palettes>
        <!-- Dropdown palettes (same control Esri's Select tool uses): one face button
             on the ribbon, the four compass variants in the dropdown. -->
        <toolPalette id="WildlifeTools_AddGraphicsPalette"
                     caption="Add Graphics"
                     extendedCaption="Open the compass graphics tool palette"
                     itemsInRow="1"
                     showItemCaption="true"
                     keytip="AG"
                     smallImage="Images\CompassRoseDot_16.png"
                     largeImage="Images\CompassRoseDot_32.png">
          <tooltip heading="Jennessent Graphics">
            Adds a Jennessent graphic to the active map or layout as a picture graphic. On a map, draw a box to size it; on a layout, click to place it at a default size and then resize it with the selection handles.<disabledText />
          </tooltip>
          <tool refID="WildlifeTools_CompassRoseGraphic" />
          <tool refID="WildlifeTools_CompassRoseDotGraphic" />
          <tool refID="WildlifeTools_Compass2Graphic" />
          <tool refID="WildlifeTools_Compass2DotGraphic" />
        </toolPalette>
        <toolPalette id="WildlifeTools_GraphicBackgroundsPalette"
                     caption="Graphic Backgrounds"
                     extendedCaption="Open the graphic background tool palette"
                     itemsInRow="1"
                     showItemCaption="true"
                     keytip="GB"
                     smallImage="Images\CircleBackground_16.png"
                     largeImage="Images\CircleBackground_32.png">
          <tooltip heading="Graphic Background">
            Draws a background graphic behind the selected element or elements (graphics or layout map elements), then groups the background and the selection into a new group with the background underneath. Opens a dialog to set the name, polygon symbology, fill and outline transparency, and size. Works on selected elements, not on features in a dataset.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_AddGraphicCircle" />
          <button refID="WildlifeTools_RectangleBackground" />
          <button refID="WildlifeTools_PolygonBackground" />
          <button refID="WildlifeTools_McpBackground" />
        </toolPalette>
        <toolPalette id="WildlifeTools_NorthArrowsPalette"
                     caption="North Arrows"
                     extendedCaption="Open the compass north arrow tool palette"
                     itemsInRow="1"
                     showItemCaption="true"
                     keytip="NA"
                     condition="esri_layouts_layoutPaneCondition"
                     smallImage="Images\CompassRoseDot_16.png"
                     largeImage="Images\CompassRoseDot_32.png">
          <tooltip heading="Jennessent North Arrows">
            Click the active layout to add a north arrow symbolized as a Jennessent graphic, tied to the layout's map frame (or unassociated if the layout has no map frame yet), then resize it with the selection handles. Available only in a layout view.<disabledText />
          </tooltip>
          <tool refID="WildlifeTools_CompassRoseNorthArrow" />
          <tool refID="WildlifeTools_CompassRoseDotNorthArrow" />
          <tool refID="WildlifeTools_Compass2NorthArrow" />
          <tool refID="WildlifeTools_Compass2DotNorthArrow" />
        </toolPalette>
      </palettes>
      <menus>
        <!-- Menus (not toolPalettes) so each ribbon entry stays a stable,
             always-dropping-down button: a palette face executes the current
             child on click and mutates to the last-used item's identity, which
             is wrong for these sets of distinct tools. -->
        <menu id="WildlifeTools_LoCoHMenu"
              caption="Local Convex Hulls"
              keytip="LH"
              smallImage="Images\LoCoH_16.png"
              largeImage="Images\LoCoH_32.png">
          <tooltip heading="Local Convex Hulls">
            The Local Convex Hull (LoCoH) home-range tools from the Jenness Enterprises toolbox: the fixed (k-), adaptive (a-), and fixed-sphere-of-influence (r-) methods for estimating an animal's home range from location points.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_LoCoHStandard" />
          <button refID="WildlifeTools_LoCoHAdaptive" />
          <button refID="WildlifeTools_LoCoHFixedSphere" />
        </menu>
        <menu id="WildlifeTools_KernelDensityMenu"
              caption="Kernel Density Tools"
              keytip="KT"
              smallImage="Images\Normal_Curve_DarkBlue_16.png"
              largeImage="Images\Kernel_Density_Enhanced_32.png">
          <tooltip heading="Kernel Density Tools">
            The kernel-density home-range tools from the Jenness Enterprises toolbox: build a custom kernel-density surface from points, convert it to a proportion (volume) surface, and generate probability contours or isopleth areas.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_KernelDensityGenerate" />
          <button refID="WildlifeTools_KernelDensityProportion" />
          <button refID="WildlifeTools_KernelDensityContours" />
        </menu>
        <menu id="WildlifeTools_MahalanobisMenu"
              caption="Mahalanobis Tools"
              keytip="MT"
              smallImage="Images\M1_16.png"
              largeImage="Images\M1_32.png">
          <tooltip heading="Mahalanobis Tools">
            The Mahalanobis-distance habitat-analysis tools from the Jenness Enterprises toolbox: build a Mahalanobis distance raster or point values from landscape variables, compute the reusable statistical matrices, and rescale a squared-distance raster to a chi-square typicality p-value.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_MahalanobisRaster" />
          <button refID="WildlifeTools_MahalanobisPoints" />
          <button refID="WildlifeTools_MahalanobisCovariance" />
          <button refID="WildlifeTools_MahalanobisChiSquare" />
        </menu>
        <!-- A menu (not a toolPalette) so the ribbon entry stays a stable,
             always-dropping-down "Hillshade Variations" button: palette faces
             execute the current child on click and mutate to the last-used
             item's identity, which is wrong for these five distinct tools. -->
        <menu id="WildlifeTools_HillshadeVariationsMenu"
              caption="Hillshade Variations"
              keytip="HV"
              smallImage="Images\EnhancedHillshade_16.png"
              largeImage="Images\EnhancedHillshade_32.png">
          <tooltip heading="Hillshade Variations">
            Geodesic-correct hillshade tools from the Jenness Enterprises toolbox, including the "Swiss method" strategies for more attractive relief shading: multi-directional illumination (MDOW and Multi-Sun), blurring, and hypsometric (elevation-tinted) shading. Also available in the Cartography Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_EnhancedHillshade" />
          <button refID="WildlifeTools_MDOWHillshade" />
          <button refID="WildlifeTools_MultiSunHillshade" />
          <button refID="WildlifeTools_BlurredHillshade" />
          <button refID="WildlifeTools_SimpleHypsometricShading" />
        </menu>
        <menu id="WildlifeTools_TopographicRoughnessMenu"
              caption="Topographic Roughness"
              keytip="RG"
              smallImage="Images\Roughness_16.png"
              largeImage="Images\Roughness_32.png">
          <tooltip heading="Topographic Roughness">
            Tools for measuring the roughness or ruggedness of a landscape, from the Jenness Enterprises toolbox. There are many reasonable ways to define topographic roughness -- variation in elevation, steepness, surface area, variation in the direction the terrain faces, contour density, fractal dimension -- and no single right one: different measures suit different questions. This menu collects the raster measures (Surface Area and Ratio, Vector Ruggedness Measure, Arc-Chord Ratio, Terrain Ruggedness Index, Fractal Dimension, and the classic Land Surface Ruggedness Index, from a DEM or from existing contour lines), plus two tools that describe the terrain actually traversed along linear features such as trails or movement paths (Topography along Lines and Split Lines into Topography Segments) -- often more relevant to a moving animal than the general ruggedness of the surrounding landscape. All computed internally -- no Spatial Analyst. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_SurfaceAreaRatio" />
          <button refID="WildlifeTools_VRM" />
          <button refID="WildlifeTools_ACR" />
          <button refID="WildlifeTools_TRI" />
          <button refID="WildlifeTools_FractalDimension" />
          <button refID="WildlifeTools_LSRIOnDEM" />
          <button refID="WildlifeTools_LSRIOnContourPolylines" />
          <button refID="WildlifeTools_TopographyAlongLines" />
          <button refID="WildlifeTools_SplitLinesIntoSegments" />
        </menu>
        <menu id="WildlifeTools_AspectToolsMenu"
              caption="Aspect Tools"
              keytip="AT"
              smallImage="Images\Aspect_16.png"
              largeImage="Images\Aspect_32.png">
          <tooltip heading="Aspect Tools">
            Tools from the Jenness Enterprises toolbox for symbolizing, analyzing, and transforming aspect. Aspect is a circular variable (0 and 360 degrees are the same direction), so ordinary raster tools that treat it as a linear number give wrong answers; these tools handle it correctly. There is deliberately no tool here to CALCULATE aspect: ArcGIS Pro already has two good ones (the Aspect tool and Surface Parameters). These tools operate on an aspect raster you have already made. All computed internally -- no Spatial Analyst. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_AspectFocalStatistics" />
          <button refID="WildlifeTools_ExtractAspectValuesToPoints" />
          <button refID="WildlifeTools_AspectTransformation" />
          <button refID="WildlifeTools_AspectZonalStatistics" />
        </menu>
        <menu id="WildlifeTools_TPIMenu"
              caption="TPI Tools"
              keytip="TT"
              smallImage="Images\TPI_16.png"
              largeImage="Images\TPI_32.png">
          <tooltip heading="TPI Tools">
            The Topographic Position Index family from the Jenness Enterprises toolbox: compute TPI itself (raw, standardized, or percentile), classify terrain into slope-position or landform categories using reusable classification systems, classify any raster with the General Raster Classification tool, and author the classification systems (class thresholds, names, and colors) in the Classification System Builder. All computed internally -- no Spatial Analyst. Also available in the Topographic Analysis Tools toolset and in ModelBuilder.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_SimpleTPI" />
          <button refID="WildlifeTools_SlopePosition" />
          <button refID="WildlifeTools_Landform" />
          <button refID="WildlifeTools_GeneralClassification" />
          <button refID="WildlifeTools_ClassificationBuilder" />
        </menu>
        <menu id="WildlifeTools_LandFacetCorridorMenu"
              caption="Land Facet Corridor Modeling"
              keytip="LM"
              smallImage="Images\LandFacet_16.png"
              largeImage="Images\LandFacet_32.png">
          <tooltip heading="Land Facet Corridor Modeling">
            The Land Facet Corridor Designer chain from the Jenness Enterprises toolbox: cluster the landscape into land facets, measure each facet's neighborhood density, and build per-facet Mahalanobis cost surfaces. A modernized, all-in-Pro replacement for the Land Facet Corridor Designer's export-to-R workflow, built for climate-resilience corridors that do not depend on any particular future vegetation type. Diversity Indices and Invert Raster (in the Ancillary Corridor Tools menu) and the corridor builders (in the Build and modify Corridors menu) are kept out of this menu because they are useful well beyond Land Facet analyses -- they are shared by traditional Corridor Designer (species habitat-suitability) and Land Facet workflows alike.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_LandFacet" />
          <button refID="WildlifeTools_LandFacetDensity" />
          <button refID="WildlifeTools_LandFacetMahalanobis" />
        </menu>
        <menu id="WildlifeTools_CorridorBuildMenu"
              caption="Build and modify Corridors"
              keytip="BC"
              smallImage="Images\CorridorBuildMenu_16.png"
              largeImage="Images\CorridorBuildMenu_32.png">
          <tooltip heading="Build and modify Corridors">
            The corridor-building tools from the Jenness Enterprises toolbox, shared by traditional Corridor Designer (species habitat-suitability) and Land Facet workflows: cut the corridor endpoints from a quality surface with Identify Termini Polygons, connect them across a cost surface with Least-Cost Corridor, then clean up the result -- close small gaps with Fill Corridor Holes and combine corridors into a single footprint with Union Corridors. No Spatial Analyst needed.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_IdentifyTermini" />
          <button refID="WildlifeTools_LeastCostCorridor" />
          <button refID="WildlifeTools_FillCorridorHoles" />
          <button refID="WildlifeTools_UnionCorridors" />
        </menu>
        <menu id="WildlifeTools_AncillaryCorridorMenu"
              caption="Ancillary Corridor Tools"
              keytip="AC"
              smallImage="Images\AncillaryCorridorMenu_16.png"
              largeImage="Images\AncillaryCorridorMenu_32.png">
          <tooltip heading="Ancillary Corridor Tools">
            Supporting utilities around the corridor chain from the Jenness Enterprises toolbox: measure neighborhood diversity of a categorical raster (Diversity Indices), turn a high-is-good quality surface into a least-cost surface (Invert Raster), batch-clip rasters and feature classes to the analysis area with optional reprojection (Clip Data to Analysis Area), cross-tabulate two variables over the landscape (Cross-Tab Statistics), and count how many corridors or patch maps overlap each cell (Cumulative Surface). No Spatial Analyst needed.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_DiversityIndices" />
          <button refID="WildlifeTools_InvertRaster" />
          <button refID="WildlifeTools_ClipData" />
          <button refID="WildlifeTools_Crosstab" />
          <button refID="WildlifeTools_CumulativeSurface" />
        </menu>
        <menu id="WildlifeTools_EvaluateCorridorMenu"
              caption="Evaluate Corridors"
              keytip="EC"
              smallImage="Images\EvaluateCorridorMenu_16.png"
              largeImage="Images\EvaluateCorridorMenu_32.png">
          <tooltip heading="Evaluate Corridors">
            How well does a finished corridor serve the species? Tools from the CorridorDesigner Evaluation toolset, modernized: Patch Analysis maps the stepping-stone route between termini that minimizes the longest gap of unsuitable habitat the animal must cross; Bottleneck Analysis finds the route with the widest bottleneck and graphs the corridor width along it, with an interactive threshold linked to the map. Corridor statistics tools will join this menu. No Spatial Analyst needed.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_PatchAnalysis" />
          <button refID="WildlifeTools_Bottleneck" />
          <button refID="WildlifeTools_WeightedSummaryStatistics" />
          <button refID="WildlifeTools_Histogram" />
        </menu>
        <menu id="WildlifeTools_HsmMenu"
              caption="Habitat Suitability Modeling"
              keytip="HM"
              smallImage="Images\HsmMenu_16.png"
              largeImage="Images\HsmMenu_32.png">
          <tooltip heading="Habitat Suitability Modeling">
            The CorridorDesigner habitat-suitability-model (HSM) chain from the Jenness Enterprises toolbox: build a 0-100 habitat suitability surface from weighted factor rasters (Create Habitat Suitability Model, or Combine Habitat Factors for already-scored factors), bring in a model built elsewhere (Normalize Existing HSM), then refine it (Reclassify Features in HSM, Critical Habitat Feature). The finished HSM feeds the corridor tools: invert it with Invert Raster into a cost surface, cut termini with Identify Termini Polygons, and run Least-Cost Corridor. No Spatial Analyst needed.<disabledText />
          </tooltip>
          <button refID="WildlifeTools_HsmRemapBuilder" />
          <button refID="WildlifeTools_HabitatSuitabilityModel" />
          <button refID="WildlifeTools_CombineHabitatFactors" />
          <button refID="WildlifeTools_NormalizeExistingHSM" />
          <button refID="WildlifeTools_ReclassifyFeaturesInHSM" />
          <button refID="WildlifeTools_CriticalHabitatFeature" />
          <button refID="WildlifeTools_HabitatPatches" />
        </menu>
      </menus>

    </insertModule>
  </modules>
</ArcGIS>
