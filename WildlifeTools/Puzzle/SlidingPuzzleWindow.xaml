<controls:ProWindow x:Class="WildlifeTools.Puzzle.SlidingPuzzleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        Title="Sliding Puzzle" WindowStartupLocation="CenterOwner"
        Width="620" Height="720" MinWidth="420" MinHeight="480"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
  <controls:ProWindow.Resources>
    <LinearGradientBrush x:Key="FrameBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#6B4A26" Offset="0" />
      <GradientStop Color="#4E351B" Offset="0.5" />
      <GradientStop Color="#3A2712" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BackdropBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#F8F1DE" Offset="0" />
      <GradientStop Color="#EFE3C4" Offset="0.55" />
      <GradientStop Color="#E7D7B0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelBrush" Color="#F9F3E2" />
    <SolidColorBrush x:Key="InkBrush" Color="#332612" />
    <SolidColorBrush x:Key="ButtonFaceBrush" Color="#5C3F20" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#F5EBD3" />
    <SolidColorBrush x:Key="ButtonEdgeBrush" Color="#2E1F0E" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#7A5730" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#412C14" />
    <SolidColorBrush x:Key="ButtonDisabledBrush" Color="#8A7A5E" />
    <FontFamily x:Key="BodyFontFam">/WildlifeTools;component/Fonts/#EB Garamond, Georgia</FontFamily>
    <Style TargetType="ToolTip">
      <Setter Property="MaxWidth" Value="380" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="360" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ParchButton" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="11,4" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="FontFamily" Value="{StaticResource BodyFontFam}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource ButtonTextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource ButtonFaceBrush}"
                    BorderBrush="{StaticResource ButtonEdgeBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonPressedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonDisabledBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- round "?" help button in the window's own colors -->
    <Style x:Key="HelpRound" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTip" Value="Open the online help page for this tool" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse x:Name="Disc" Fill="{StaticResource ButtonFaceBrush}"
                       Stroke="{StaticResource ButtonEdgeBrush}" StrokeThickness="1" />
              <Ellipse Margin="3" Stroke="{StaticResource ButtonTextBrush}"
                       StrokeThickness="0.75" Opacity="0.55" />
              <TextBlock Text="?" FontFamily="Georgia" FontWeight="Bold" FontSize="15"
                         Foreground="{StaticResource ButtonTextBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Margin="0,-1,0,0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Disc" Property="Fill" Value="{StaticResource ButtonHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Disc" Property="Fill" Value="{StaticResource ButtonPressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:ProWindow.Resources>

  <Border Background="{StaticResource FrameBrush}" Padding="9">
    <Border Background="{StaticResource BackdropBrush}" CornerRadius="8" Padding="10">
      <DockPanel>
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,0,0,8">
          <Button x:Name="btnSnapshot" Content="New Snapshot" Style="{StaticResource ParchButton}"
                  Click="OnNewSnapshot"
                  ToolTip="Grab a fresh picture from the current map or layout view and start over." />
          <Border Width="1" Background="#B79A6A" Margin="7,2" />
          <TextBlock x:Name="txtSizeLabel" Text="Tiles:" VerticalAlignment="Center"
                     Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource BodyFontFam}"
                     FontSize="14" Margin="2,0,4,0" />
          <Button x:Name="btnSize4" Content="4" Style="{StaticResource ParchButton}" Click="OnSize4"
                  ToolTip="4 tiles along the short edge." />
          <Button x:Name="btnSize5" Content="5" Style="{StaticResource ParchButton}" Click="OnSize5"
                  ToolTip="5 tiles along the short edge." />
          <Button x:Name="btnSize6" Content="6" Style="{StaticResource ParchButton}" Click="OnSize6"
                  ToolTip="6 tiles along the short edge." />
          <Border Width="1" Background="#B79A6A" Margin="7,2" />
          <Button x:Name="btnShuffle" Content="Shuffle" Style="{StaticResource ParchButton}"
                  Click="OnShuffle" ToolTip="Scramble the tiles again." />
          <Button x:Name="btnPeek" Content="Peek" Style="{StaticResource ParchButton}"
                  Click="OnPeek" ToolTip="Show the finished picture while the button is highlighted." />
          <CheckBox x:Name="chkEasy" Content="Numbers" VerticalAlignment="Center"
                    Margin="8,0,0,0" Foreground="{StaticResource InkBrush}"
                    FontFamily="{StaticResource BodyFontFam}" FontSize="14"
                    Click="OnEasyToggle"
                    ToolTip="Easy mode: show a faint number in each tile's corner." />
          <Button Style="{StaticResource HelpRound}" Click="OnHelp" />
        </StackPanel>

        <!-- Status + Solve helper (bottom corner) -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <TextBlock x:Name="txtStatus" TextAlignment="Center"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{StaticResource InkBrush}"
                     FontFamily="{StaticResource BodyFontFam}" FontSize="14"
                     TextWrapping="Wrap" Text="Capturing the active view..." />
          <Button x:Name="btnSolve" Content="Solve" Style="{StaticResource ParchButton}"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Click="OnSolveStep" IsEnabled="False"
                  ToolTip="Shows how many moves the solver needs from here. Each click makes one of those moves, so clicking until it reads zero finishes the puzzle for you. (Not necessarily the theoretical minimum.)" />
        </Grid>

        <!-- Board: a fixed-logical-size Canvas scaled to fit by the Viewbox. -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource ButtonEdgeBrush}"
                BorderThickness="1" CornerRadius="6" Padding="8">
          <Viewbox Stretch="Uniform">
            <Canvas x:Name="BoardCanvas" Width="480" Height="480" Background="Transparent" />
          </Viewbox>
        </Border>
      </DockPanel>
    </Border>
  </Border>
</controls:ProWindow>
